val str        = use("std/string")
val ostr       = use("std/string/owned")
val cstr       = use("std/string/cstr")
val builder    = use("std/string/builder")
val allocators = use("std/allocators")
val coll       = use("std/collections")
val json       = use("std/json")
val fs         = use("std/fs")
val path       = use("std/path")
val time       = use("std/time")
val lsp_parser = use("./parser")
val checker    = use("./checker")

extern (C) fn strncmp(a: ref u8, b: ref u8, n: usize) i32 = "strncmp"
extern (C) fn write(fd: i32, buf: ref void, count: usize) i64 = "write"

/// Debounced type-check state.  `didChange` only updates the document store
/// and records a deadline; the main loop runs the check once typing pauses.
val g_pending_uri: mut ref u8 = none
val g_pending_due: mut i64 = 0

fn owned_view(s: str.String) str.StringView = trust {
    if s == none {
        return str.view(none, 0)
    }
    return str.view(ostr.as_cstr(s), ostr.len(s))
}

fn raw_dup_h(s: ref u8, len: i64) ref u8 = trust {
    if s == none || len <= 0 {
        return none
    }
    val buf: ref u8 = @alloc(len + 1) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf, s, len as usize)
    @store8(@ptradd(buf, len), 0)
    return buf
}

fn raw_dup_cstr_h(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = cstr.len(s)
    if len == 0 {
        return none
    }
    return raw_dup_h(s, len)
}

fn starts_with_h(s: str.StringView, prefix: str.StringView) bool = trust {
    return str.starts_with(s, prefix)
}

fn read_file_to_heap(path: ref u8) ref u8 = trust {
    if path == none {
        return none
    }
    val arena_res = allocators.Arena.new(2097152 as usize)
    match arena_res {
        err _ => {
            return none
        }
        ok arena => {
            val content: mut ref u8 = none
            if fs.read_all[allocators.Arena](arena, str.from_cstr(path)) is some c {
                content = raw_dup_cstr_h(c)
            }
            allocators.Arena.free(arena)
            return content
        }
    }
}

fn write_all(fd: i32, buf: ref void, count: usize) bool = trust {
    val written: mut i64 = 0
    val total: i64 = count as i64
    for {
        if written >= total {
            break
        }
        val n: i64 = write(
            fd,
            @ptradd(buf as ref u8, written) as ref void,
            (total - written) as usize
        )
        if n <= 0 {
            return false
        }
        written = written + n
    }
    return true
}

pub fn write_response(body: str.StringView) void = trust {
    if str.is_empty(body) {
        return
    }
    val body_len: i64 = body.len
    val header: ref u8 = @fmtalloc("Content-Length: {d}", {body_len})
    if header == none {
        return
    }
    val hlen: i64 = cstr.len(header)
    val sep: ref u8 = @alloc(5) as ref u8
    if sep == none {
        @free(header)
        return
    }
    @store8(@ptradd(sep, 0), '\r')
    @store8(@ptradd(sep, 1), '\n')
    @store8(@ptradd(sep, 2), '\r')
    @store8(@ptradd(sep, 3), '\n')
    @store8(@ptradd(sep, 4), 0)
    if hlen >= 0 {
        if write_all(1 as i32, header, hlen as usize) {
            if write_all(1 as i32, sep, 4 as usize) {
                write_all(1 as i32, body.ptr as ref void, body_len as usize)
            }
        }
    }
    @free(sep)
    @free(header)
}

fn sb_append_int(sb: builder.StringBuilder, n: i64) void = trust {
    val s: ref u8 = @fmtalloc("{d}", {n})
    if s == none {
        return
    }
    builder.StringBuilder.append_cstr(sb, s)
    @free(s)
}

fn sb_escape(sb: builder.StringBuilder, s: str.StringView) void = trust {
    if str.is_empty(s) {
        return
    }
    val i: mut i64 = 0
    for {
        if i >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, i))
        if c == '"' {
            builder.StringBuilder.append(sb, "\\\"")
        } elif c == '\\' {
            builder.StringBuilder.append(sb, "\\\\")
        } elif c == '\n' {
            builder.StringBuilder.append(sb, "\\n")
        } elif c == '\r' {
            builder.StringBuilder.append(sb, "\\r")
        } elif c == '\t' {
            builder.StringBuilder.append(sb, "\\t")
        } else {
            builder.StringBuilder.append_char(sb, c)
        }
        i++
    }
}

fn sb_escape_cstr(sb: builder.StringBuilder, s: ref u8) void = trust {
    if s == none {
        return
    }
    sb_escape(sb, str.from_cstr(s))
}

fn make_base(sb: builder.StringBuilder, id_raw: ref void) void = trust {
    builder.StringBuilder.append(sb, "{\"jsonrpc\":\"2.0\",\"id\":")
    if id_raw == none {
        builder.StringBuilder.append(sb, "null")
        return
    }
    val ik: json.JsonKind = json.val_kind(id_raw)
    if ik == json.JsonKind.Int || ik == json.JsonKind.UInt {
        val n: i64 = json.val_get_int(id_raw)
        sb_append_int(sb, n)
    } else {
        val s: ref u8 = json.val_get_str(id_raw)
        builder.StringBuilder.append(sb, "\"")
        sb_escape_cstr(sb, s)
        builder.StringBuilder.append(sb, "\"")
    }
}

pub fn send_null_result(id_raw: ref void) void = trust {
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":null}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

pub fn send_error(id_raw: ref void, code: i64, msg: ref u8) void = trust {
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"error\":{\"code\":")
    sb_append_int(sb, code)
    builder.StringBuilder.append(sb, ",\"message\":\"")
    sb_escape_cstr(sb, msg)
    builder.StringBuilder.append(sb, "\"}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

fn emit_diag_comma(sb: builder.StringBuilder, first: ref i64) void = trust {
    if @load(first) == 1 {
        @store(first, 0 as i64)
    } else {
        builder.StringBuilder.append(sb, ",")
    }
}

fn compiler_diag_is_warning(msg: str.StringView) bool = trust {
    return str.contains(msg, "declared but never used") ||
    str.contains(msg, "declared mutable but never mutated") ||
    str.contains(msg, "unused function") ||
    str.contains(msg, "is never used")
}

fn append_one_compiler_diag(
    sb: builder.StringBuilder,
    first: ref i64,
    content: ref u8,
    canon_file: str.StringView,
    line: str.StringView
) void = trust {
    if !str.starts_with(line, canon_file) {
        return
    }
    val pos: i64 = canon_file.len
    if pos >= line.len || @load8(@ptradd(line.ptr, pos)) != ':' {
        return
    }

    val nstart: i64 = pos + 1
    val j: mut i64 = nstart
    val line_no: mut i64 = 0
    for {
        if j >= line.len {
            break
        }
        val c: u8 = @load8(@ptradd(line.ptr, j))
        if c == ':' {
            break
        }
        if c < '0' || c > '9' {
            return
        }
        line_no = line_no * 10 + (c as i64 - 48)
        j++
    }
    if j <= nstart || j >= line.len {
        return
    }

    val after: i64 = j + 1
    val mstart: mut i64 = after
    if mstart < line.len && @load8(@ptradd(line.ptr, mstart)) == ' ' {
        mstart++
    }
    if mstart >= line.len {
        return
    }
    val msg: str.StringView = str.slice(line, mstart, line.len)
    if str.is_empty(msg) {
        return
    }

    // The lightweight unused-variable pass above already reports these with
    // an exact identifier range, so avoid a duplicate whole-line diagnostic.
    if str.contains(msg, "variable '") &&
    str.contains(msg, "declared but never used") {
        return
    }

    val display_line: mut i64 = line_no
    if display_line < 1 {
        display_line = 1
    }
    val start: mut i64 = -1
    val end: mut i64 = -1
    lsp_parser.line_bounds_raw(
        content,
        display_line - 1,
        @addr(start),
        @addr(end)
    )
    val ce: mut i64 = 0
    if start >= 0 && end >= start {
        ce = end - start
    }

    val warning: bool = compiler_diag_is_warning(msg)
    emit_diag_comma(sb, first)
    builder.StringBuilder.append(sb, "{\"range\":")
    append_range(sb, display_line - 1, 0, ce)
    builder.StringBuilder.append(sb, ",\"severity\":")
    if warning {
        sb_append_int(sb, 2)
    } else {
        sb_append_int(sb, 1)
    }
    builder.StringBuilder.append(sb, ",\"source\":\"spectre-ls\",\"code\":\"")
    if str.contains(msg, "declared but never used") {
        builder.StringBuilder.append(sb, "unused-variable")
    } elif str.contains(msg, "declared mutable but never mutated") {
        builder.StringBuilder.append(sb, "unused-mut")
    } elif str.contains(msg, "unused function") {
        builder.StringBuilder.append(sb, "unused-function")
    } elif str.contains(msg, "is never used") {
        builder.StringBuilder.append(sb, "unused-import")
    } else {
        builder.StringBuilder.append(sb, "type-error")
    }
    builder.StringBuilder.append(sb, "\",\"message\":\"")
    sb_escape(sb, msg)
    builder.StringBuilder.append(sb, "\"}")
}

fn append_compiler_diagnostics(
    sb: builder.StringBuilder,
    first: ref i64,
    content: ref u8,
    canon_file: ref u8,
    diags: str.String
) void = trust {
    if canon_file == none || diags == none {
        return
    }
    val total: i64 = ostr.len(diags)
    if total <= 0 {
        return
    }
    val raw: ref u8 = ostr.as_cstr(diags)
    if raw == none {
        return
    }
    val canon_view: str.StringView = str.from_cstr(canon_file)
    val i: mut i64 = 0
    val start: mut i64 = 0
    for {
        if i > total {
            break
        }
        if i == total || @load8(@ptradd(raw, i)) == '\n' {
            if i > start {
                val line: str.StringView = str.view(@ptradd(raw, start), i - start)
                append_one_compiler_diag(sb, first, content, canon_view, line)
            }
            start = i + 1
        }
        i++
    }
}

fn send_diagnostics(uri: ref u8, content: ref u8) void = trust {
    if uri == none || content == none {
        return
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    builder.StringBuilder.append(
        sb,
        "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\""
    )
    sb_escape_cstr(sb, uri)
    builder.StringBuilder.append(sb, "\",\"diagnostics\":[")

    val first: mut i64 = 1

    val vars: ref void = lsp_parser.find_unused_variables(content)
    if vars != none {
        val n: usize = coll.PtrList.len(vars)
        val i: mut usize = 0
        for {
            if i >= n {
                break
            }
            if coll.PtrList.get(vars, i) is some v {
                val u: ref lsp_parser.UnusedVariable = @bitcast(
                    v,
                    ref void
                ) as ref lsp_parser.UnusedVariable
                if u != none && u.name != none {
                    emit_diag_comma(sb, @addr(first))
                    val nlen: i64 = cstr.len(u.name)
                    builder.StringBuilder.append(sb, "{\"range\":")
                    append_range(sb, u.line, u.col, u.col + nlen)
                    builder.StringBuilder.append(
                        sb,
                        ",\"severity\":2,\"source\":\"spectre-ls\",\"code\":\"unused-variable\",\"message\":\"variable '"
                    )
                    sb_escape_cstr(sb, u.name)
                    builder.StringBuilder.append(sb, "' declared but never used\"}")
                }
            }
            i++
        }
        lsp_parser.free_unused_variables(vars)
    }

    val file_path: ref u8 = lsp_parser.uri_to_path(uri)
    if file_path != none {
        val canon_opt: ref u8 = path.canonicalize_path_cstr(file_path)
        val canon_file: mut ref u8 = file_path
        if canon_opt != none {
            canon_file = canon_opt
        }
        val diags: str.String = checker.typecheck(file_path, content)
        if diags != none && ostr.len(diags) > 0 {
            append_compiler_diagnostics(
                sb,
                @addr(first),
                content,
                canon_file,
                diags
            )
        }
        if diags != none {
            ostr.free(diags)
        }
        if canon_opt != none && canon_opt != file_path {
            @free(canon_opt)
        }
        @free(file_path)
    }

    builder.StringBuilder.append(sb, "]}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

pub fn handle_initialize(id_raw: ref void) void = trust {
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":{\"capabilities\":{")
    builder.StringBuilder.append(
        sb,
        "\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":true},"
    )
    builder.StringBuilder.append(sb, "\"hoverProvider\":true,")
    builder.StringBuilder.append(sb, "\"definitionProvider\":true,")
    builder.StringBuilder.append(sb, "\"documentSymbolProvider\":true,")
    builder.StringBuilder.append(sb, "\"signatureHelpProvider\":{")
    builder.StringBuilder.append(sb, "\"triggerCharacters\":[\"(\",\",\"]")
    builder.StringBuilder.append(sb, "},")

    builder.StringBuilder.append(sb, "\"completionProvider\":{")
    builder.StringBuilder.append(sb, "\"resolveProvider\":false,")
    builder.StringBuilder.append(sb, "\"triggerCharacters\":[\".\",\":\",\">\"]")
    builder.StringBuilder.append(sb, "}},")

    builder.StringBuilder.append(
        sb,
        "\"serverInfo\":{\"name\":\"spectre-ls\",\"version\":\"0.1.0\"}"
    )
    builder.StringBuilder.append(sb, "}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

fn get_str_field(obj: ref void, key: str.StringView) ref u8 = trust {
    match json.obj_get_str(obj, key.ptr) {
        some s => {
            return s
        }
        none => {
            return none
        }
    }
}

fn get_int_field(obj: ref void, key: str.StringView) i64 = trust {
    match json.obj_get_int(obj, key.ptr) {
        some n => {
            return n
        }
        none => {
            return 0
        }
    }
}

fn get_obj_field(obj: ref void, key: str.StringView) ref void = trust {
    match json.obj_get(obj, key.ptr) {
        some v => {
            if json.val_is_object(v) {
                return v
            }
            return none
        }
        none => {
            return none
        }
    }
}

fn find_sym_by_name(sym_list: ref void, name: ref u8) ref lsp_parser.Symbol = trust {
    if sym_list == none || name == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            if sym != none && sym.name != none {
                if cstr.cmp(sym.name, name) == 0 {
                    return sym
                }
            }
        }
        i++
    }
    return none
}

fn find_import_sym(sym_list: ref void, alias: ref u8) ref lsp_parser.Symbol = trust {
    if sym_list == none || alias == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            if sym != none && sym.kind == lsp_parser.SYM_MODULE &&
            sym.name != none && cstr.cmp(sym.name, alias) == 0 {
                return sym
            }
        }
        i++
    }
    return none
}

fn is_ident_start_h(c: u8) bool = {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_cont_h(c: u8) bool = {
    return is_ident_start_h(c) || (c >= 48 && c <= 57)
}

fn param_name_eq(param_decl: ref u8, word: ref u8) bool = trust {
    if param_decl == none || word == none {
        return false
    }
    val plen: i64 = cstr.len(param_decl)
    val wlen: i64 = cstr.len(word)
    if plen <= 0 || wlen <= 0 {
        return false
    }

    val i: mut i64 = 0
    for {
        if i >= plen {
            break
        }
        val c: u8 = @load8(@ptradd(param_decl, i))
        if c != ' ' && c != '\t' {
            break
        }
        i++
    }
    if i >= plen {
        return false
    }
    if !is_ident_start_h(@load8(@ptradd(param_decl, i))) {
        return false
    }

    val j: mut i64 = i + 1
    for {
        if j >= plen {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(param_decl, j))) {
            break
        }
        j++
    }

    val nlen: i64 = j - i
    if nlen != wlen {
        return false
    }
    return strncmp(@ptradd(param_decl, i), word, nlen as usize) == 0
}

fn find_enclosing_callable(sym_list: ref void, line: i64) ref lsp_parser.Symbol = trust {
    if sym_list == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    val best_line: mut i64 = -1
    val best: mut ref lsp_parser.Symbol = none

    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            if sym != none &&
            (sym.kind == lsp_parser.SYM_FUNCTION || sym.kind == lsp_parser.SYM_METHOD) &&
            sym.line <= line && sym.line >= best_line {
                best = sym
                best_line = sym.line
            }
        }
        i++
    }
    return best
}

fn lookup_parameter_decl(
    sym_store: ref void,
    current_uri: ref u8,
    line: i64,
    word: ref u8
) ref u8 = trust {
    if current_uri == none || word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }
    if cur_syms == none {
        return none
    }

    val fn_sym: ref lsp_parser.Symbol = find_enclosing_callable(cur_syms, line)
    if fn_sym == none || fn_sym.params == none {
        return none
    }

    val n: usize = coll.PtrList.len(fn_sym.params)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(fn_sym.params, i) is some v {
            val pstr: ref u8 = @bitcast(v, ref void) as ref u8
            if param_name_eq(pstr, word) {
                return pstr
            }
        }
        i++
    }

    return none
}

fn ensure_parsed(doc_store: ref void, sym_store: ref void, file_path: ref u8) void = trust {
    if file_path == none || sym_store == none || doc_store == none {
        return
    }
    val uri: ref u8 = lsp_parser.path_to_uri(file_path)
    val alloc: allocators.HeapAllocator = @zeroed

    if uri == none {
        return
    }
    if coll.StringMap.contains(sym_store, uri) {
        @free(uri)
        return
    }
    val content: ref u8 = read_file_to_heap(file_path)
    if content != none {
        if !coll.StringMap.contains(doc_store, uri) {
            val cv: usize = @bitcast(content, usize)
            coll.StringMap.set[_](alloc, doc_store, uri, cv)
        }
        val syms: ref void = lsp_parser.parse_file(file_path, content)
        if syms != none {
            val sv: usize = @bitcast(syms, usize)
            coll.StringMap.set[_](alloc, sym_store, uri, sv)
        } else {
            @free(content)
        }
    }
    @free(uri)
}

fn lookup_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    word: ref u8,
    module_alias: ref u8
) ref lsp_parser.Symbol = trust {
    if word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }

    if module_alias != none {
        if cur_syms == none {
            return none
        }
        val imp: ref lsp_parser.Symbol = find_import_sym(cur_syms, module_alias)
        if imp == none || imp.ret_type == none {
            return none
        }
        val mod_file: ref u8 = lsp_parser.resolve_module_path(current_file, imp.ret_type)
        if mod_file == none {
            return none
        }
        ensure_parsed(doc_store, sym_store, mod_file)
        val mod_uri: ref u8 = lsp_parser.path_to_uri(mod_file)
        @free(mod_file)
        if mod_uri == none {
            return none
        }
        val mod_syms: mut ref void = none
        if coll.StringMap.get(sym_store, mod_uri) is some v {
            mod_syms = @bitcast(v, ref void)
        }
        @free(mod_uri)
        if mod_syms == none {
            return none
        }
        return find_sym_by_name(mod_syms, word)
    }

    if cur_syms != none {
        val found: ref lsp_parser.Symbol = find_sym_by_name(cur_syms, word)
        if found != none {
            return found
        }
    }

    return none
}

fn trim_right_len_h(s: ref u8, len: i64) i64 = trust {
    val n: mut i64 = len
    for {
        if n <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(s, n - 1))
        if c != ' ' && c != '\t' && c != '\r' && c != '\n' {
            break
        }
        n--
    }
    return n
}

fn trim_left_dup_h(s: ref u8, len: i64) ref u8 = trust {
    if s == none || len <= 0 {
        return none
    }
    val start: i64 = skip_ws_h(s, 0, len)
    val trimmed_len: i64 = trim_right_len_h(@ptradd(s, start), len - start)
    if trimmed_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(s, start), trimmed_len)
}

fn skip_ws_h(s: ref u8, i: i64, len: i64) i64 = trust {
    val j: mut i64 = i
    for {
        if j >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, j))
        if c != ' ' && c != '\t' {
            break
        }
        j++
    }
    return j
}

fn ident_len_h(s: ref u8, i: i64, len: i64) i64 = trust {
    if i >= len {
        return 0
    }
    val c0: u8 = @load8(@ptradd(s, i))
    if !is_ident_start_h(c0) {
        return 0
    }
    val j: mut i64 = i + 1
    for {
        if j >= len {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(s, j))) {
            break
        }
        j++
    }
    return j - i
}

fn is_builtin_type_word(word: str.StringView) bool = trust {
    if str.is_empty(word) {
        return false
    }
    return str.eql(word, "i32") ||
    str.eql(word, "i64") ||
    str.eql(word, "u8") ||
    str.eql(word, "u32") ||
    str.eql(word, "u64") ||
    str.eql(word, "usize") ||
    str.eql(word, "f32") ||
    str.eql(word, "f64") ||
    str.eql(word, "bool") ||
    str.eql(word, "void") ||
    str.eql(word, "list") ||
    str.eql(word, "option") ||
    str.eql(word, "result")
}

fn builtin_type_signature(word: ref u8) ref u8 = trust {
    val w: str.StringView = str.from_cstr(word)
    if word == none {
        return none
    }
    if str.eql(w, "list") {
        return c"list[T]"
    }
    if str.eql(w, "option") {
        return c"option[T]"
    }
    if str.eql(w, "result") {
        return c"result[T, E]"
    }
    return word
}

fn builtin_type_desc(word: str.StringView) ref u8 = trust {
    if str.is_empty(word) {
        return none
    }
    if str.eql(word, "i32") {
        return c"32-bit signed integer"
    }
    if str.eql(word, "i64") {
        return c"64-bit signed integer"
    }
    if str.eql(word, "u8") {
        return c"8-bit unsigned integer"
    }
    if str.eql(word, "u32") {
        return c"32-bit unsigned integer"
    }
    if str.eql(word, "u64") {
        return c"64-bit unsigned integer"
    }
    if str.eql(word, "usize") {
        return c"pointer-sized unsigned integer"
    }
    if str.eql(word, "f32") {
        return c"32-bit floating point number"
    }
    if str.eql(word, "f64") {
        return c"64-bit floating point number"
    }
    if str.eql(word, "bool") {
        return c"boolean value"
    }
    if str.eql(word, "void") {
        return c"no value"
    }
    if str.eql(word, "list") {
        return c"builtin growable list type"
    }
    if str.eql(word, "option") {
        return c"builtin optional value type"
    }
    if str.eql(word, "result") {
        return c"builtin success-or-error type"
    }
    return none
}

fn builtin_type_size(word: str.StringView) i64 = trust {
    if str.is_empty(word) {
        return -1
    }
    if str.eql(word, "i32") || str.eql(word, "u32") || str.eql(word, "f32") {
        return 4
    }
    if str.eql(word, "u8") || str.eql(word, "bool") {
        return 1
    }
    if str.eql(word, "void") {
        return 0
    }
    if str.eql(word, "list") {
        return 24
    }
    if str.eql(word, "option") || str.eql(word, "result") {
        return 16
    }
    return 8
}

pub fn keyword_signature(word: str.StringView) ref u8 = trust {
    if str.is_empty(word) {
        return none
    }
    if str.eql(word, "fn") {
        return c"fn name(params) ReturnType = { ... }"
    }
    if str.eql(word, "val") {
        return c"val name: Type = value"
    }
    if str.eql(word, "mut") {
        return c"mut value"
    }
    if str.eql(word, "pub") {
        return c"pub declaration"
    }
    if str.eql(word, "type") {
        return c"type Name = { field: Type ... }"
    }
    if str.eql(word, "enum") {
        return c"enum Name = { Variant ... }"
    }
    if str.eql(word, "union") {
        return c"union Name = { Variant(Type) | ... }"
    }
    if str.eql(word, "if") {
        return c"if condition { ... }"
    }
    if str.eql(word, "elif") {
        return c"elif condition { ... }"
    }
    if str.eql(word, "else") {
        return c"else { ... }"
    }
    if str.eql(word, "for") {
        return c"for { ... }  |  for item in collection { ... }"
    }
    if str.eql(word, "in") {
        return c"for item in collection { ... }"
    }
    if str.eql(word, "match") {
        return c"match value { pattern => { ... } }"
    }
    if str.eql(word, "return") {
        return c"return value"
    }
    if str.eql(word, "break") {
        return c"break"
    }
    if str.eql(word, "continue") {
        return c"continue"
    }
    if str.eql(word, "defer") {
        return c"defer statement"
    }
    if str.eql(word, "use") {
        return c"val name = use(\"path/to/module\")"
    }
    if str.eql(word, "ref") {
        return c"ref Type"
    }
    if str.eql(word, "some") {
        return c"some value"
    }
    if str.eql(word, "none") {
        return c"none"
    }
    if str.eql(word, "ok") {
        return c"ok value"
    }
    if str.eql(word, "err") {
        return c"err value"
    }
    if str.eql(word, "true") {
        return c"true"
    }
    if str.eql(word, "false") {
        return c"false"
    }
    if str.eql(word, "trust") {
        return c"trust expression"
    }
    if str.eql(word, "as") {
        return c"value as Type"
    }
    if str.eql(word, "assert") {
        return c"assert condition"
    }
    if str.eql(word, "when") {
        return c"when platform { ... }"
    }
    if str.eql(word, "extern") {
        return c"extern (C) fn name(params) ReturnType = \"symbol\""
    }
    if str.eql(word, "link") {
        return c"link \"library\""
    }
    if str.eql(word, "guarded") {
        return c"guarded pre { ... }"
    }
    if str.eql(word, "not") {
        return c"not expression"
    }
    if str.eql(word, "test") {
        return c"test { ... }"
    }
    if str.eql(word, "guard") {
        return c"guard condition"
    }
    if str.eql(word, "invariant") {
        return c"invariant { condition }"
    }
    if str.eql(word, "pre") {
        return c"pre { check: condition }"
    }
    if str.eql(word, "post") {
        return c"post { check: condition }"
    }
    if str.eql(word, "spec") {
        return c"spec Name = { ... }"
    }
    if str.eql(word, "self") {
        return c"self  |  mut self"
    }
    return none
}

pub fn keyword_description(word: str.StringView) ref u8 = trust {
    if str.is_empty(word) {
        return none
    }
    if str.eql(word, "fn") {
        return c"Declares a function. Add a receiver in parentheses to declare a namespaced method, for example `fn (Type) name(...)`."
    }
    if str.eql(word, "val") {
        return c"Declares a variable binding. Bindings are immutable unless marked with `mut`."
    }
    if str.eql(word, "mut") {
        return c"Marks a binding, field, or parameter as mutable."
    }
    if str.eql(word, "pub") {
        return c"Makes a declaration visible to modules that import this file."
    }
    if str.eql(word, "type") {
        return c"Declares a struct-like type with named fields. Fields are laid out in declaration order."
    }
    if str.eql(word, "enum") {
        return c"Declares an enum with named variants."
    }
    if str.eql(word, "union") {
        return c"Declares a tagged union. Tagged variants carry values, for example `Circle(f64)`."
    }
    if str.eql(word, "if") {
        return c"Runs a block when a condition is true. Use `elif` and `else` for additional branches."
    }
    if str.eql(word, "elif") {
        return c"Adds another conditional branch after an `if` block."
    }
    if str.eql(word, "else") {
        return c"Runs a block when the preceding `if`/`elif` conditions are false."
    }
    if str.eql(word, "for") {
        return c"Starts a loop. `for { ... }` loops until `break`; `for item in collection { ... }` iterates over a collection."
    }
    if str.eql(word, "in") {
        return c"Introduces the collection being iterated by a `for` loop."
    }
    if str.eql(word, "match") {
        return c"Branches on an option, result, union, or enum value. Each arm must use braces."
    }
    if str.eql(word, "return") {
        return c"Returns from the enclosing function."
    }
    if str.eql(word, "break") {
        return c"Exits the innermost loop."
    }
    if str.eql(word, "continue") {
        return c"Skips to the next iteration of the innermost loop."
    }
    if str.eql(word, "defer") {
        return c"Schedules a statement to run when the enclosing scope exits."
    }
    if str.eql(word, "use") {
        return c"Imports another module. The resulting binding is used as `alias.member`."
    }
    if str.eql(word, "ref") {
        return c"A raw pointer/reference type. Null is written as `none`."
    }
    if str.eql(word, "some") {
        return c"Constructs a present `option[T]` value."
    }
    if str.eql(word, "none") {
        return c"The empty `option[T]` value, and the null pointer value."
    }
    if str.eql(word, "ok") {
        return c"Constructs the success value of a `result[T, E]`."
    }
    if str.eql(word, "err") {
        return c"Constructs the error value of a `result[T, E]`."
    }
    if str.eql(word, "true") {
        return c"The boolean true value."
    }
    if str.eql(word, "false") {
        return c"The boolean false value."
    }
    if str.eql(word, "trust") {
        return c"Evaluates an expression while suppressing contract checks. Used to call untrusted functions and intrinsic operations."
    }
    if str.eql(word, "as") {
        return c"Casts or reinterprets a value as another type."
    }
    if str.eql(word, "assert") {
        return c"Aborts the program when the condition is false."
    }
    if str.eql(word, "when") {
        return c"Compiles the block only for the matching platform (for example `when linux { ... }`)."
    }
    if str.eql(word, "extern") {
        return c"Declares a function or type provided by an external C library."
    }
    if str.eql(word, "link") {
        return c"Links an external library into the program."
    }
    if str.eql(word, "guarded") {
        return c"Marks a contract check so it remains active in release builds."
    }
    if str.eql(word, "not") {
        return c"Boolean negation."
    }
    if str.eql(word, "test") {
        return c"Declares a unit test block. Run tests with `spectre <file.sx> --test`."
    }
    if str.eql(word, "guard") {
        return c"Declares an early-exit guard condition."
    }
    if str.eql(word, "invariant") {
        return c"Declares a type invariant checked when the type is used with contracts."
    }
    if str.eql(word, "pre") {
        return c"Declares preconditions for a function."
    }
    if str.eql(word, "post") {
        return c"Declares postconditions for a function."
    }
    if str.eql(word, "spec") {
        return c"Declares a specification of methods that an implementing type must provide."
    }
    if str.eql(word, "self") {
        return c"Refers to the enclosing type in a method parameter list. Use `mut self` for a mutable receiver."
    }
    return none
}

pub fn is_keyword(word: str.StringView) bool = trust {
    return keyword_description(word) != none
}

