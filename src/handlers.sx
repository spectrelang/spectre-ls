val str        = use("std/string")
val allocators = use("std/allocators")
val coll       = use("std/collections")
val json       = use("std/json")
val fs         = use("std/fs")
val parser     = use("./parser")

extern (C) fn strncmp(a: ref u8, b: ref u8, n: usize) i32 = "strncmp"
extern (C) fn write(fd: i32, buf: ref void, count: usize) i64 = "write"

fn raw_dup_h(s: ref u8, len: i64) ref u8 = trust {
    if s == none || len <= 0 {
        return none
    }
    val buf: ref u8 = @alloc(len + 1) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf as ref void, s as ref void, len as usize)
    @store8(@ptradd(buf, len), 0)
    return buf
}

fn raw_dup_cstr_h(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = str.len_raw(s)
    if len == 0 {
        return none
    }
    return raw_dup_h(s, len)
}

fn starts_with_h(s: ref u8, slen: i64, prefix: ref u8, plen: i64) bool = trust {
    if plen > slen || plen <= 0 {
        return false
    }
    return strncmp(s, prefix, plen as usize) == 0
}

fn read_file_to_heap(path: ref u8) ref u8 = trust {
    if path == none {
        return none
    }
    val arena_res = allocators.Arena.new(2097152 as usize)
    match arena_res {
        err _ => {
            return none
        }
        ok arena => {
            val content: mut ref u8 = none
            if fs.read_all[allocators.Arena](arena, path) is some c {
                content = raw_dup_cstr_h(c)
            }
            allocators.Arena.free(arena)
            return content
        }
    }
}

fn write_all(fd: i32, buf: ref void, count: usize) bool = trust {
    val written: mut i64 = 0
    val total: i64 = count as i64
    for {
        if written >= total {
            break
        }
        val n: i64 = write(fd, @ptradd(buf as ref u8, written) as ref void, (total - written) as usize)
        if n <= 0 {
            return false
        }
        written = written + n
    }
    return true
}

pub fn write_response(body: ref u8) void = trust {
    if body == none {
        return
    }
    val body_len: i64 = str.len_raw(body)
    if body_len < 0 {
        return
    }
    val header: ref u8 = @fmt("Content-Length: {d}", {body_len})
    if header == none {
        return
    }
    val hlen: i64 = str.len_raw(header)
    val sep: ref u8 = @alloc(5) as ref u8
    if sep == none {
        @free(header as ref void)
        return
    }
    @store8(@ptradd(sep, 0), '\r')
    @store8(@ptradd(sep, 1), '\n')
    @store8(@ptradd(sep, 2), '\r')
    @store8(@ptradd(sep, 3), '\n')
    @store8(@ptradd(sep, 4), 0)
    if hlen >= 0 {
        if write_all(1 as i32, header as ref void, hlen as usize) {
            if write_all(1 as i32, sep as ref void, 4 as usize) {
                write_all(1 as i32, body as ref void, body_len as usize)
            }
        }
    }
    @free(sep as ref void)
    @free(header as ref void)
}

fn sb_append_int(sb: str.StringBuilder, n: i64) void = trust {
    val s: ref u8 = @fmt("{d}", {n})
    if s == none {
        return
    }
    str.StringBuilder.append_cstr(sb, s)
    @free(s as ref void)
}

fn sb_escape(sb: str.StringBuilder, s: ref u8) void = trust {
    if s == none {
        return
    }
    val len: i64 = str.len_raw(s)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == '"' {
            str.StringBuilder.append_cstr(sb, "\\\"")
        } elif c == '\\' {
            str.StringBuilder.append_cstr(sb, "\\\\")
        } elif c == '\n' {
            str.StringBuilder.append_cstr(sb, "\\n")
        } elif c == '\r' {
            str.StringBuilder.append_cstr(sb, "\\r")
        } elif c == '\t' {
            str.StringBuilder.append_cstr(sb, "\\t")
        } else {
            str.StringBuilder.append_char(sb, c)
        }
        i++
    }
}

fn make_base(sb: str.StringBuilder, id_raw: ref void) void = trust {
    str.StringBuilder.append_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":")
    if id_raw == none {
        str.StringBuilder.append_cstr(sb, "null")
        return
    }
    val ik: json.JsonKind = json.val_kind(id_raw)
    if ik == json.JsonKind.Int || ik == json.JsonKind.UInt {
        val n: i64 = json.val_get_int(id_raw)
        sb_append_int(sb, n)
    } else {
        val s: ref u8 = json.val_get_str(id_raw)
        str.StringBuilder.append_cstr(sb, "\"")
        sb_escape(sb, s)
        str.StringBuilder.append_cstr(sb, "\"")
    }
}

pub fn send_null_result(id_raw: ref void) void = trust {
    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":null}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn send_error(id_raw: ref void, code: i64, msg: ref u8) void = trust {
    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"error\":{\"code\":")
    sb_append_int(sb, code)
    str.StringBuilder.append_cstr(sb, ",\"message\":\"")
    sb_escape(sb, msg)
    str.StringBuilder.append_cstr(sb, "\"}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn handle_initialize(id_raw: ref void) void = trust {
    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"capabilities\":{")
    str.StringBuilder.append_cstr(sb, "\"textDocumentSync\":1,")
    str.StringBuilder.append_cstr(sb, "\"hoverProvider\":true,")
    str.StringBuilder.append_cstr(sb, "\"definitionProvider\":true,")
    str.StringBuilder.append_cstr(sb, "\"documentSymbolProvider\":true,")
    str.StringBuilder.append_cstr(sb, "\"signatureHelpProvider\":{")
    str.StringBuilder.append_cstr(sb, "\"triggerCharacters\":[\"(\",\",\"]")
    str.StringBuilder.append_cstr(sb, "}},")

    str.StringBuilder.append_cstr(sb, "\"completionProvider\":{")
    str.StringBuilder.append_cstr(sb, "\"resolveProvider\":false,")
    str.StringBuilder.append_cstr(sb, "\"triggerCharacters\":[\".\",\":\",\">\"]")
    str.StringBuilder.append_cstr(sb, "},")

    str.StringBuilder.append_cstr(sb, "\"serverInfo\":{\"name\":\"spectre-ls\",\"version\":\"0.1.0\"}")
    str.StringBuilder.append_cstr(sb, "}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

fn get_str_field(obj: ref void, key: ref u8) ref u8 = trust {
    match json.obj_get_str(obj, key) {
        some s => {
            return s
        }
        none => {
            return none
        }
    }
}

fn get_int_field(obj: ref void, key: ref u8) i64 = trust {
    match json.obj_get_int(obj, key) {
        some n => {
            return n
        }
        none => {
            return 0
        }
    }
}

fn get_obj_field(obj: ref void, key: ref u8) ref void = trust {
    match json.obj_get(obj, key) {
        some v => {
            if json.val_is_object(v) {
                return v
            }
            return none
        }
        none => {
            return none
        }
    }
}

fn find_sym_by_name(sym_list: ref void, name: ref u8) ref parser.Symbol = trust {
    if sym_list == none || name == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
            if sym != none && sym.name != none {
                if str.raw_cmp(sym.name, name) == 0 {
                    return sym
                }
            }
        }
        i++
    }
    return none
}

fn find_import_sym(sym_list: ref void, alias: ref u8) ref parser.Symbol = trust {
    if sym_list == none || alias == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
            if sym != none && sym.kind == parser.SYM_MODULE &&
            sym.name != none && str.raw_cmp(sym.name, alias) == 0 {
                return sym
            }
        }
        i++
    }
    return none
}

fn is_ident_start_h(c: u8) bool = {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_cont_h(c: u8) bool = {
    return is_ident_start_h(c) || (c >= 48 && c <= 57)
}

fn param_name_eq(param_decl: ref u8, word: ref u8) bool = trust {
    if param_decl == none || word == none {
        return false
    }
    val plen: i64 = str.len_raw(param_decl)
    val wlen: i64 = str.len_raw(word)
    if plen <= 0 || wlen <= 0 {
        return false
    }

    val i: mut i64 = 0
    for {
        if i >= plen {
            break
        }
        val c: u8 = @load8(@ptradd(param_decl, i))
        if c != ' ' && c != '\t' {
            break
        }
        i++
    }
    if i >= plen {
        return false
    }
    if !is_ident_start_h(@load8(@ptradd(param_decl, i))) {
        return false
    }

    val j: mut i64 = i + 1
    for {
        if j >= plen {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(param_decl, j))) {
            break
        }
        j++
    }

    val nlen: i64 = j - i
    if nlen != wlen {
        return false
    }
    return strncmp(@ptradd(param_decl, i), word, nlen as usize) == 0
}

fn find_enclosing_callable(sym_list: ref void, line: i64) ref parser.Symbol = trust {
    if sym_list == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    val best_line: mut i64 = -1
    val best: mut ref parser.Symbol = none

    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
            if sym != none &&
            (sym.kind == parser.SYM_FUNCTION || sym.kind == parser.SYM_METHOD) &&
            sym.line <= line && sym.line >= best_line {
                best = sym
                best_line = sym.line
            }
        }
        i = i + 1
    }
    return best
}

fn lookup_parameter_decl(
    sym_store: ref void,
    current_uri: ref u8,
    line: i64,
    word: ref u8
) ref u8 = trust {
    if current_uri == none || word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }
    if cur_syms == none {
        return none
    }

    val fn_sym: ref parser.Symbol = find_enclosing_callable(cur_syms, line)
    if fn_sym == none || fn_sym.params == none {
        return none
    }

    val n: usize = coll.PtrList.len(fn_sym.params)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(fn_sym.params, i) is some v {
            val pstr: ref u8 = @bitcast(v, ref void) as ref u8
            if param_name_eq(pstr, word) {
                return pstr
            }
        }
        i = i + 1
    }

    return none
}

fn ensure_parsed(doc_store: ref void, sym_store: ref void, file_path: ref u8) void = trust {
    if file_path == none || sym_store == none || doc_store == none {
        return
    }
    val uri: ref u8 = parser.path_to_uri(file_path)
    val alloc: allocators.HeapAllocator = @zeroed

    if uri == none {
        return
    }
    if coll.StringMap.contains(sym_store, uri) {
        @free(uri as ref void)
        return
    }
    val content: ref u8 = read_file_to_heap(file_path)
    if content != none {
        if !coll.StringMap.contains(doc_store, uri) {
            val cv: usize = @bitcast(content as ref void, usize)
            coll.StringMap.set[_](alloc, doc_store, uri, cv)
        }
        val syms: ref void = parser.parse_file(file_path, content)
        if syms != none {
            val sv: usize = @bitcast(syms, usize)
            coll.StringMap.set[_](alloc, sym_store, uri, sv)
        } else {
            @free(content as ref void)
        }
    }
    @free(uri as ref void)
}

fn lookup_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    word: ref u8,
    module_alias: ref u8
) ref parser.Symbol = trust {
    if word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }

    if module_alias != none {
        if cur_syms == none {
            return none
        }
        val imp: ref parser.Symbol = find_import_sym(cur_syms, module_alias)
        if imp == none || imp.ret_type == none {
            return none
        }
        val mod_file: ref u8 = parser.resolve_module_path(current_file, imp.ret_type)
        if mod_file == none {
            return none
        }
        ensure_parsed(doc_store, sym_store, mod_file)
        val mod_uri: ref u8 = parser.path_to_uri(mod_file)
        @free(mod_file as ref void)
        if mod_uri == none {
            return none
        }
        val mod_syms: mut ref void = none
        if coll.StringMap.get(sym_store, mod_uri) is some v {
            mod_syms = @bitcast(v, ref void)
        }
        @free(mod_uri as ref void)
        if mod_syms == none {
            return none
        }
        return find_sym_by_name(mod_syms, word)
    }

    if cur_syms != none {
        val found: ref parser.Symbol = find_sym_by_name(cur_syms, word)
        if found != none {
            return found
        }
    }

    return none
}

fn trim_right_len_h(s: ref u8, len: i64) i64 = trust {
    val n: mut i64 = len
    for {
        if n <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(s, n - 1))
        if c != ' ' && c != '\t' && c != '\r' && c != '\n' {
            break
        }
        n = n - 1
    }
    return n
}

fn trim_left_dup_h(s: ref u8, len: i64) ref u8 = trust {
    if s == none || len <= 0 {
        return none
    }
    val start: i64 = skip_ws_h(s, 0, len)
    val trimmed_len: i64 = trim_right_len_h(@ptradd(s, start), len - start)
    if trimmed_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(s, start), trimmed_len)
}

fn skip_ws_h(s: ref u8, i: i64, len: i64) i64 = trust {
    val j: mut i64 = i
    for {
        if j >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, j))
        if c != ' ' && c != '\t' {
            break
        }
        j++
    }
    return j
}

fn ident_len_h(s: ref u8, i: i64, len: i64) i64 = trust {
    if i >= len {
        return 0
    }
    val c0: u8 = @load8(@ptradd(s, i))
    if !is_ident_start_h(c0) {
        return 0
    }
    val j: mut i64 = i + 1
    for {
        if j >= len {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(s, j))) {
            break
        }
        j++
    }
    return j - i
}

fn is_builtin_type_word(word: ref u8) bool = {
    if word == none {
        return false
    }
    return str.raw_cmp(word, "i32") == 0 ||
    str.raw_cmp(word, "i64") == 0 ||
    str.raw_cmp(word, "u8") == 0 ||
    str.raw_cmp(word, "u32") == 0 ||
    str.raw_cmp(word, "u64") == 0 ||
    str.raw_cmp(word, "usize") == 0 ||
    str.raw_cmp(word, "f32") == 0 ||
    str.raw_cmp(word, "f64") == 0 ||
    str.raw_cmp(word, "bool") == 0 ||
    str.raw_cmp(word, "void") == 0 ||
    str.raw_cmp(word, "list") == 0 ||
    str.raw_cmp(word, "option") == 0 ||
    str.raw_cmp(word, "result") == 0
}

fn builtin_type_signature(word: ref u8) ref u8 = {
    if word == none {
        return none
    }
    if str.raw_cmp(word, "list") == 0 {
        return "list[T]"
    }
    if str.raw_cmp(word, "option") == 0 {
        return "option[T]"
    }
    if str.raw_cmp(word, "result") == 0 {
        return "result[T, E]"
    }
    return word
}

fn builtin_type_desc(word: ref u8) ref u8 = {
    if word == none {
        return none
    }
    if str.raw_cmp(word, "i32") == 0 {
        return "32-bit signed integer"
    }
    if str.raw_cmp(word, "i64") == 0 {
        return "64-bit signed integer"
    }
    if str.raw_cmp(word, "u8") == 0 {
        return "8-bit unsigned integer"
    }
    if str.raw_cmp(word, "u32") == 0 {
        return "32-bit unsigned integer"
    }
    if str.raw_cmp(word, "u64") == 0 {
        return "64-bit unsigned integer"
    }
    if str.raw_cmp(word, "usize") == 0 {
        return "pointer-sized unsigned integer"
    }
    if str.raw_cmp(word, "f32") == 0 {
        return "32-bit floating point number"
    }
    if str.raw_cmp(word, "f64") == 0 {
        return "64-bit floating point number"
    }
    if str.raw_cmp(word, "bool") == 0 {
        return "boolean value"
    }
    if str.raw_cmp(word, "void") == 0 {
        return "no value"
    }
    if str.raw_cmp(word, "list") == 0 {
        return "builtin growable list type"
    }
    if str.raw_cmp(word, "option") == 0 {
        return "builtin optional value type"
    }
    if str.raw_cmp(word, "result") == 0 {
        return "builtin success-or-error type"
    }
    return none
}

fn builtin_type_size(word: ref u8) i64 = {
    if word == none {
        return -1
    }
    if str.raw_cmp(word, "i32") == 0 || str.raw_cmp(word, "u32") == 0 || str.raw_cmp(word, "f32") == 0 {
        return 4
    }
    if str.raw_cmp(word, "u8") == 0 || str.raw_cmp(word, "bool") == 0 {
        return 1
    }
    if str.raw_cmp(word, "void") == 0 {
        return 0
    }
    if str.raw_cmp(word, "list") == 0 {
        return 24
    }
    if str.raw_cmp(word, "option") == 0 || str.raw_cmp(word, "result") == 0 {
        return 16
    }
    return 8
}

pub fn keyword_signature(word: ref u8) ref u8 = {
    if word == none {
        return none
    }
    if str.raw_cmp(word, "fn") == 0 {
        return "fn name(params) ReturnType = { ... }"
    }
    if str.raw_cmp(word, "val") == 0 {
        return "val name: Type = value"
    }
    if str.raw_cmp(word, "mut") == 0 {
        return "mut value"
    }
    if str.raw_cmp(word, "pub") == 0 {
        return "pub declaration"
    }
    if str.raw_cmp(word, "type") == 0 {
        return "type Name = { field: Type ... }"
    }
    if str.raw_cmp(word, "enum") == 0 {
        return "enum Name = { Variant ... }"
    }
    if str.raw_cmp(word, "union") == 0 {
        return "union Name = { Variant(Type) | ... }"
    }
    if str.raw_cmp(word, "if") == 0 {
        return "if condition { ... }"
    }
    if str.raw_cmp(word, "elif") == 0 {
        return "elif condition { ... }"
    }
    if str.raw_cmp(word, "else") == 0 {
        return "else { ... }"
    }
    if str.raw_cmp(word, "for") == 0 {
        return "for { ... }  |  for item in collection { ... }"
    }
    if str.raw_cmp(word, "in") == 0 {
        return "for item in collection { ... }"
    }
    if str.raw_cmp(word, "match") == 0 {
        return "match value { pattern => { ... } }"
    }
    if str.raw_cmp(word, "return") == 0 {
        return "return value"
    }
    if str.raw_cmp(word, "break") == 0 {
        return "break"
    }
    if str.raw_cmp(word, "continue") == 0 {
        return "continue"
    }
    if str.raw_cmp(word, "defer") == 0 {
        return "defer statement"
    }
    if str.raw_cmp(word, "use") == 0 {
        return "val name = use(\"path/to/module\")"
    }
    if str.raw_cmp(word, "ref") == 0 {
        return "ref Type"
    }
    if str.raw_cmp(word, "some") == 0 {
        return "some value"
    }
    if str.raw_cmp(word, "none") == 0 {
        return "none"
    }
    if str.raw_cmp(word, "ok") == 0 {
        return "ok value"
    }
    if str.raw_cmp(word, "err") == 0 {
        return "err value"
    }
    if str.raw_cmp(word, "true") == 0 {
        return "true"
    }
    if str.raw_cmp(word, "false") == 0 {
        return "false"
    }
    if str.raw_cmp(word, "trust") == 0 {
        return "trust expression"
    }
    if str.raw_cmp(word, "as") == 0 {
        return "value as Type"
    }
    if str.raw_cmp(word, "assert") == 0 {
        return "assert condition"
    }
    if str.raw_cmp(word, "when") == 0 {
        return "when platform { ... }"
    }
    if str.raw_cmp(word, "extern") == 0 {
        return "extern (C) fn name(params) ReturnType = \"symbol\""
    }
    if str.raw_cmp(word, "link") == 0 {
        return "link \"library\""
    }
    if str.raw_cmp(word, "guarded") == 0 {
        return "guarded pre { ... }"
    }
    if str.raw_cmp(word, "not") == 0 {
        return "not expression"
    }
    if str.raw_cmp(word, "test") == 0 {
        return "test { ... }"
    }
    if str.raw_cmp(word, "guard") == 0 {
        return "guard condition"
    }
    if str.raw_cmp(word, "invariant") == 0 {
        return "invariant { condition }"
    }
    if str.raw_cmp(word, "pre") == 0 {
        return "pre { check: condition }"
    }
    if str.raw_cmp(word, "post") == 0 {
        return "post { check: condition }"
    }
    if str.raw_cmp(word, "spec") == 0 {
        return "spec Name = { ... }"
    }
    if str.raw_cmp(word, "self") == 0 {
        return "self  |  mut self"
    }
    return none
}

pub fn keyword_description(word: ref u8) ref u8 = {
    if word == none {
        return none
    }
    if str.raw_cmp(word, "fn") == 0 {
        return "Declares a function. Add a receiver in parentheses to declare a namespaced method, for example `fn (Type) name(...)`."
    }
    if str.raw_cmp(word, "val") == 0 {
        return "Declares a variable binding. Bindings are immutable unless marked with `mut`."
    }
    if str.raw_cmp(word, "mut") == 0 {
        return "Marks a binding, field, or parameter as mutable."
    }
    if str.raw_cmp(word, "pub") == 0 {
        return "Makes a declaration visible to modules that import this file."
    }
    if str.raw_cmp(word, "type") == 0 {
        return "Declares a struct-like type with named fields. Fields are laid out in declaration order."
    }
    if str.raw_cmp(word, "enum") == 0 {
        return "Declares an enum with named variants."
    }
    if str.raw_cmp(word, "union") == 0 {
        return "Declares a tagged union. Tagged variants carry values, for example `Circle(f64)`."
    }
    if str.raw_cmp(word, "if") == 0 {
        return "Runs a block when a condition is true. Use `elif` and `else` for additional branches."
    }
    if str.raw_cmp(word, "elif") == 0 {
        return "Adds another conditional branch after an `if` block."
    }
    if str.raw_cmp(word, "else") == 0 {
        return "Runs a block when the preceding `if`/`elif` conditions are false."
    }
    if str.raw_cmp(word, "for") == 0 {
        return "Starts a loop. `for { ... }` loops until `break`; `for item in collection { ... }` iterates over a collection."
    }
    if str.raw_cmp(word, "in") == 0 {
        return "Introduces the collection being iterated by a `for` loop."
    }
    if str.raw_cmp(word, "match") == 0 {
        return "Branches on an option, result, union, or enum value. Each arm must use braces."
    }
    if str.raw_cmp(word, "return") == 0 {
        return "Returns from the enclosing function."
    }
    if str.raw_cmp(word, "break") == 0 {
        return "Exits the innermost loop."
    }
    if str.raw_cmp(word, "continue") == 0 {
        return "Skips to the next iteration of the innermost loop."
    }
    if str.raw_cmp(word, "defer") == 0 {
        return "Schedules a statement to run when the enclosing scope exits."
    }
    if str.raw_cmp(word, "use") == 0 {
        return "Imports another module. The resulting binding is used as `alias.member`."
    }
    if str.raw_cmp(word, "ref") == 0 {
        return "A raw pointer/reference type. Null is written as `none`."
    }
    if str.raw_cmp(word, "some") == 0 {
        return "Constructs a present `option[T]` value."
    }
    if str.raw_cmp(word, "none") == 0 {
        return "The empty `option[T]` value, and the null pointer value."
    }
    if str.raw_cmp(word, "ok") == 0 {
        return "Constructs the success value of a `result[T, E]`."
    }
    if str.raw_cmp(word, "err") == 0 {
        return "Constructs the error value of a `result[T, E]`."
    }
    if str.raw_cmp(word, "true") == 0 {
        return "The boolean true value."
    }
    if str.raw_cmp(word, "false") == 0 {
        return "The boolean false value."
    }
    if str.raw_cmp(word, "trust") == 0 {
        return "Evaluates an expression while suppressing contract checks. Used to call untrusted functions and intrinsic operations."
    }
    if str.raw_cmp(word, "as") == 0 {
        return "Casts or reinterprets a value as another type."
    }
    if str.raw_cmp(word, "assert") == 0 {
        return "Aborts the program when the condition is false."
    }
    if str.raw_cmp(word, "when") == 0 {
        return "Compiles the block only for the matching platform (for example `when linux { ... }`)."
    }
    if str.raw_cmp(word, "extern") == 0 {
        return "Declares a function or type provided by an external C library."
    }
    if str.raw_cmp(word, "link") == 0 {
        return "Links an external library into the program."
    }
    if str.raw_cmp(word, "guarded") == 0 {
        return "Marks a contract check so it remains active in release builds."
    }
    if str.raw_cmp(word, "not") == 0 {
        return "Boolean negation."
    }
    if str.raw_cmp(word, "test") == 0 {
        return "Declares a unit test block. Run tests with `spectre <file.sx> --test`."
    }
    if str.raw_cmp(word, "guard") == 0 {
        return "Declares an early-exit guard condition."
    }
    if str.raw_cmp(word, "invariant") == 0 {
        return "Declares a type invariant checked when the type is used with contracts."
    }
    if str.raw_cmp(word, "pre") == 0 {
        return "Declares preconditions for a function."
    }
    if str.raw_cmp(word, "post") == 0 {
        return "Declares postconditions for a function."
    }
    if str.raw_cmp(word, "spec") == 0 {
        return "Declares a specification of methods that an implementing type must provide."
    }
    if str.raw_cmp(word, "self") == 0 {
        return "Refers to the enclosing type in a method parameter list. Use `mut self` for a mutable receiver."
    }
    return none
}

pub fn is_keyword(word: ref u8) bool = {
    return keyword_description(word) != none
}

fn keyword_at(i: i64) ref u8 = {
    if i == 0 {
        return "fn"
    }
    if i == 1 {
        return "val"
    }
    if i == 2 {
        return "mut"
    }
    if i == 3 {
        return "pub"
    }
    if i == 4 {
        return "type"
    }
    if i == 5 {
        return "enum"
    }
    if i == 6 {
        return "union"
    }
    if i == 7 {
        return "if"
    }
    if i == 8 {
        return "elif"
    }
    if i == 9 {
        return "else"
    }
    if i == 10 {
        return "for"
    }
    if i == 11 {
        return "in"
    }
    if i == 12 {
        return "match"
    }
    if i == 13 {
        return "return"
    }
    if i == 14 {
        return "break"
    }
    if i == 15 {
        return "continue"
    }
    if i == 16 {
        return "defer"
    }
    if i == 17 {
        return "use"
    }
    if i == 18 {
        return "ref"
    }
    if i == 19 {
        return "some"
    }
    if i == 20 {
        return "none"
    }
    if i == 21 {
        return "ok"
    }
    if i == 22 {
        return "err"
    }
    if i == 23 {
        return "true"
    }
    if i == 24 {
        return "false"
    }
    if i == 25 {
        return "trust"
    }
    if i == 26 {
        return "as"
    }
    if i == 27 {
        return "assert"
    }
    if i == 28 {
        return "when"
    }
    if i == 29 {
        return "extern"
    }
    if i == 30 {
        return "link"
    }
    if i == 31 {
        return "guarded"
    }
    if i == 32 {
        return "not"
    }
    if i == 33 {
        return "test"
    }
    if i == 34 {
        return "guard"
    }
    if i == 35 {
        return "invariant"
    }
    if i == 36 {
        return "pre"
    }
    if i == 37 {
        return "post"
    }
    if i == 38 {
        return "spec"
    }
    if i == 39 {
        return "self"
    }
    return none
}

fn append_keyword_hover_contents(sb: str.StringBuilder, word: ref u8) void = trust {
    str.StringBuilder.append_cstr(sb, "```spectre\\n")
    sb_escape(sb, keyword_signature(word))
    str.StringBuilder.append_cstr(sb, "\\n```\\n\\n")
    sb_escape(sb, keyword_description(word))
}

fn strip_type_wrappers(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = str.len_raw(s)
    val i: mut i64 = skip_ws_h(s, 0, len)
    for {
        if i >= len {
            break
        }
        if starts_with_h(@ptradd(s, i), len - i, "mut ", 4) {
            i = skip_ws_h(s, i + 4, len)
        } elif starts_with_h(@ptradd(s, i), len - i, "ref ", 4) {
            i = skip_ws_h(s, i + 4, len)
        } elif starts_with_h(@ptradd(s, i), len - i, "const ", 6) {
            i = skip_ws_h(s, i + 6, len)
        } else {
            break
        }
    }
    val out_len: i64 = trim_right_len_h(@ptradd(s, i), len - i)
    if out_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(s, i), out_len)
}

fn find_equals_h(s: ref u8, len: i64) i64 = trust {
    val sq: mut i64 = 0
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == '[' {
            sq = sq + 1
        } elif c == ']' {
            if sq > 0 {
                sq = sq - 1
            }
        } elif c == '(' {
            paren = paren + 1
        } elif c == ')' {
            if paren > 0 {
                paren = paren - 1
            }
        } elif c == '{' {
            brace = brace + 1
        } elif c == '}' {
            if brace > 0 {
                brace = brace - 1
            }
        } elif c == '=' && sq == 0 && paren == 0 && brace == 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Extract the explicit type from a `val name: Type = ...` declaration.
pub fn decl_explicit_type(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = str.len_raw(decl)
    val i: mut i64 = skip_ws_h(decl, 0, len)
    if i >= len {
        return none
    }
    if starts_with_h(@ptradd(decl, i), len - i, "pub ", 4) {
        i = skip_ws_h(decl, i + 4, len)
    }
    if !starts_with_h(@ptradd(decl, i), len - i, "val ", 4) {
        return none
    }
    i = skip_ws_h(decl, i + 4, len)
    val name_len: i64 = ident_len_h(decl, i, len)
    if name_len <= 0 {
        return none
    }
    i = skip_ws_h(decl, i + name_len, len)
    if i >= len || @load8(@ptradd(decl, i)) != ':' {
        return none
    }
    i = skip_ws_h(decl, i + 1, len)
    val type_start: i64 = i
    val eq: i64 = find_equals_h(@ptradd(decl, type_start), len - type_start)
    val type_end: mut i64 = len
    if eq >= 0 {
        type_end = type_start + eq
    }
    val type_len: i64 = trim_right_len_h(@ptradd(decl, type_start), type_end - type_start)
    if type_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, type_start), type_len)
}

pub fn decl_initializer(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = str.len_raw(decl)
    val eq: i64 = find_equals_h(decl, len)
    if eq < 0 {
        return none
    }
    val start: i64 = skip_ws_h(decl, eq + 1, len)
    val out_len: i64 = trim_right_len_h(@ptradd(decl, start), len - start)
    if out_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, start), out_len)
}

pub fn extract_param_type(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = str.len_raw(decl)
    val i: mut i64 = skip_ws_h(decl, 0, len)
    val name_len: i64 = ident_len_h(decl, i, len)
    if name_len <= 0 {
        return none
    }
    i = skip_ws_h(decl, i + name_len, len)
    if i >= len || @load8(@ptradd(decl, i)) != ':' {
        return none
    }
    i = skip_ws_h(decl, i + 1, len)
    val type_len: i64 = trim_right_len_h(@ptradd(decl, i), len - i)
    if type_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, i), type_len)
}

fn find_last_substr_h(s: ref u8, needle: ref u8) i64 = trust {
    if s == none || needle == none {
        return -1
    }
    val slen: i64 = str.len_raw(s)
    val nlen: i64 = str.len_raw(needle)
    if nlen <= 0 || nlen > slen {
        return -1
    }
    val best: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i + nlen > slen {
            break
        }
        if strncmp(@ptradd(s, i), needle, nlen as usize) == 0 {
            best = i
        }
        i = i + 1
    }
    return best
}

/// Best-effort type-name inference from an initializer expression.
/// For `X.new()` this returns `X`, for `mod.Type.new()` it returns
/// `mod.Type`, and for a plain identifier it returns that identifier so the
/// caller can follow the referenced variable/function.
pub fn infer_expr_type_name(expr: ref u8) ref u8 = trust {
    if expr == none {
        return none
    }
    val raw_len: i64 = str.len_raw(expr)
    val i: i64 = skip_ws_h(expr, 0, raw_len)
    val expr_len: i64 = trim_right_len_h(@ptradd(expr, i), raw_len - i)
    if expr_len <= 0 {
        return none
    }
    val s: ref u8 = @ptradd(expr, i)

    val stripped: mut ref u8 = raw_dup_h(s, expr_len)
    if stripped == none {
        return none
    }
    for {
        val slen: i64 = str.len_raw(stripped)
        val si: i64 = skip_ws_h(stripped, 0, slen)
        if starts_with_h(@ptradd(stripped, si), slen - si, "trust ", 6) {
            val next: ref u8 = raw_dup_h(@ptradd(stripped, skip_ws_h(stripped, si + 6, slen)), trim_right_len_h(@ptradd(stripped, skip_ws_h(stripped, si + 6, slen)), slen - skip_ws_h(stripped, si + 6, slen)))
            @free(stripped as ref void)
            stripped = next
        } elif starts_with_h(@ptradd(stripped, si), slen - si, "some ", 5) {
            val ns: i64 = skip_ws_h(stripped, si + 5, slen)
            val next: ref u8 = raw_dup_h(@ptradd(stripped, ns), trim_right_len_h(@ptradd(stripped, ns), slen - ns))
            @free(stripped as ref void)
            stripped = next
        } elif starts_with_h(@ptradd(stripped, si), slen - si, "ok ", 3) {
            val ns: i64 = skip_ws_h(stripped, si + 3, slen)
            val next: ref u8 = raw_dup_h(@ptradd(stripped, ns), trim_right_len_h(@ptradd(stripped, ns), slen - ns))
            @free(stripped as ref void)
            stripped = next
        } else {
            break
        }
        if stripped == none {
            return none
        }
    }

    val len: i64 = str.len_raw(stripped)
    val start: i64 = skip_ws_h(stripped, 0, len)
    if start >= len {
        @free(stripped as ref void)
        return none
    }

    // A cast at the end is often the clearest type information.
    val as_idx: i64 = find_last_substr_h(stripped, " as ")
    val first: u8 = @load8(@ptradd(stripped, start))
    if first == '@' || first == '(' || first == '[' {
        if as_idx >= 0 {
            val ts: i64 = skip_ws_h(stripped, as_idx + 4, len)
            val tl: i64 = trim_right_len_h(@ptradd(stripped, ts), len - ts)
            val out: ref u8 = raw_dup_h(@ptradd(stripped, ts), tl)
            @free(stripped as ref void)
            return out
        }
        @free(stripped as ref void)
        return none
    }

    if first == '\"' || first == '\'' || (first >= '0' && first <= '9') {
        @free(stripped as ref void)
        return none
    }
    if !is_ident_start_h(first) {
        @free(stripped as ref void)
        return none
    }

    val chain_start: i64 = start
    val chain_end: mut i64 = start
    for {
        if chain_end >= len {
            break
        }
        val c: u8 = @load8(@ptradd(stripped, chain_end))
        if is_ident_cont_h(c) || c == '.' {
            chain_end = chain_end + 1
        } else {
            break
        }
    }
    if chain_end <= chain_start {
        @free(stripped as ref void)
        return none
    }
    val out: ref u8 = raw_dup_h(@ptradd(stripped, chain_start), chain_end - chain_start)
    @free(stripped as ref void)
    return out
}

fn resolve_type_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    type_expr: ref u8,
    depth: i64
) ref parser.Symbol = trust {
    if type_expr == none || depth > 8 {
        return none
    }
    val expr: mut ref u8 = strip_type_wrappers(type_expr)
    if expr == none {
        return none
    }

    val len: i64 = str.len_raw(expr)
    val bracket: mut i64 = -1
    val bi: mut i64 = 0
    for {
        if bi >= len {
            break
        }
        if @load8(@ptradd(expr, bi)) == '[' {
            bracket = bi
            break
        }
        bi = bi + 1
    }
    if bracket > 0 {
        val base: ref u8 = raw_dup_h(expr, bracket)
        @free(expr as ref void)
        expr = base
        if expr == none {
            return none
        }
    }

    val elen: i64 = str.len_raw(expr)
    val last_dot: mut i64 = -1
    val di: mut i64 = 0
    for {
        if di >= elen {
            break
        }
        if @load8(@ptradd(expr, di)) == '.' {
            last_dot = di
        }
        di = di + 1
    }

    val cur_syms: mut ref void = none
    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
    }

    val sym: mut ref parser.Symbol = none
    if last_dot > 0 && last_dot + 1 < elen {
        val alias: ref u8 = raw_dup_h(expr, last_dot)
        val name: ref u8 = raw_dup_h(@ptradd(expr, last_dot + 1), elen - last_dot - 1)
        sym = lookup_symbol(doc_store, sym_store, current_uri, current_file, name, alias)
        if name != none {
            @free(name as ref void)
        }
        if alias != none {
            @free(alias as ref void)
        }
    } else {
        sym = find_sym_by_name(cur_syms, expr)
    }

    if sym != none {
        if sym.kind == parser.SYM_TYPE || sym.kind == parser.SYM_ENUM || sym.kind == parser.SYM_UNION {
            @free(expr as ref void)
            return sym
        }
        if sym.ret_type != none && sym.ret_type != type_expr {
            val sym_file: ref u8 = sym.file
            val sym_uri: mut ref u8 = none
            val follow_file: mut ref u8 = current_file
            if sym_file != none {
                follow_file = sym_file
                sym_uri = parser.path_to_uri(sym_file)
            } else {
                sym_uri = raw_dup_cstr_h(current_uri)
            }
            val followed: ref parser.Symbol = resolve_type_symbol(
                doc_store, sym_store, sym_uri, follow_file, sym.ret_type, depth + 1
            )
            if sym_uri != none {
                @free(sym_uri as ref void)
            }
            if followed != none {
                @free(expr as ref void)
                return followed
            }
        }
    }

    if last_dot > 0 {
        val base: ref u8 = raw_dup_h(expr, last_dot)
        val followed: ref parser.Symbol = resolve_type_symbol(
            doc_store, sym_store, current_uri, current_file, base, depth + 1
        )
        if base != none {
            @free(base as ref void)
        }
        if followed != none {
            @free(expr as ref void)
            return followed
        }
    }

    @free(expr as ref void)
    return none
}

fn lookup_variable_type_expr(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    content: ref u8,
    line: i64,
    cursor_off: i64,
    name: ref u8,
    depth: i64
) ref u8 = trust {
    if name == none || depth > 8 {
        return none
    }

    val param_decl: ref u8 = lookup_parameter_decl(sym_store, current_uri, line, name)
    if param_decl != none {
        val pt: ref u8 = extract_param_type(param_decl)
        if pt != none {
            return pt
        }
    }

    val local_line: mut i64 = -1
    val local_decl: ref u8 = lookup_local_variable_decl(
        sym_store, current_uri, content, line, cursor_off, name, @addr(local_line)
    )
    if local_decl != none {
        val lt: ref u8 = decl_explicit_type(local_decl)
        if lt != none {
            @free(local_decl as ref void)
            return lt
        }
        val init: ref u8 = decl_initializer(local_decl)
        @free(local_decl as ref void)
        if init != none {
            val inferred: ref u8 = infer_expr_type_name(init)
            @free(init as ref void)
            return inferred
        }
        return none
    }

    val global_line: mut i64 = -1
    val global_decl: ref u8 = lookup_global_variable_decl(content, line, cursor_off, name, @addr(global_line))
    if global_decl != none {
        val gt: ref u8 = decl_explicit_type(global_decl)
        if gt != none {
            @free(global_decl as ref void)
            return gt
        }
        val ginit: ref u8 = decl_initializer(global_decl)
        @free(global_decl as ref void)
        if ginit != none {
            val ginferred: ref u8 = infer_expr_type_name(ginit)
            @free(ginit as ref void)
            return ginferred
        }
    }

    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            val cur_syms: ref void = @bitcast(v, ref void)
            val sym: ref parser.Symbol = find_sym_by_name(cur_syms, name)
            if sym != none && sym.ret_type != none {
                val followed: ref parser.Symbol = resolve_type_symbol(
                    doc_store, sym_store, current_uri, current_file, sym.ret_type, depth + 1
                )
                if followed != none {
                    return raw_dup_cstr_h(sym.ret_type)
                }
            }
        }
    }
    return none
}

fn fields_for_type(
    doc_store: mut ref void,
    sym_store: mut ref void,
    type_sym: ref parser.Symbol
) ref void = trust {
    if type_sym == none || type_sym.file == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, type_sym.file)
    val content: ref u8 = get_content_for_file(doc_store, type_sym.file)
    if content == none {
        return none
    }
    return parser.parse_type_fields(content, type_sym.file, type_sym.line)
}

fn method_receiver_matches(receiver: ref u8, type_name: ref u8) bool = trust {
    if receiver == none || type_name == none {
        return false
    }
    val rlen: i64 = str.len_raw(receiver)
    val ti: i64 = skip_ws_h(receiver, 0, rlen)
    val tl: i64 = trim_right_len_h(@ptradd(receiver, ti), rlen - ti)
    if tl <= 0 {
        return false
    }
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= tl {
            break
        }
        if @load8(@ptradd(receiver, ti + i)) == '.' {
            last_dot = i
        }
        i = i + 1
    }
    val start: i64 = ti + last_dot + 1
    val name_len: i64 = tl - last_dot - 1
    return name_len == str.len_raw(type_name) &&
    strncmp(@ptradd(receiver, start), type_name, name_len as usize) == 0
}

fn sym_list_for_file(sym_store: mut ref void, doc_store: mut ref void, file: ref u8) ref void = trust {
    if file == none {
        return none
    }
    val uri: ref u8 = parser.path_to_uri(file)
    if uri == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, file)
    val result: mut ref void = none
    if coll.StringMap.get(sym_store, uri) is some v {
        result = @bitcast(v, ref void)
    }
    @free(uri as ref void)
    return result
}

fn line_bounds_for_line_h(content: ref u8, target_line: i64, out_start: ref i64, out_end: ref i64) void = trust {
    @store(out_start as ref void, -1 as i64)
    @store(out_end as ref void, -1 as i64)
    if content == none || target_line < 0 {
        return
    }

    val len: i64 = str.len_raw(content)
    val line_num: mut i64 = 0
    val i: mut i64 = 0
    val start: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if line_num == target_line {
            start = i
            break
        }
        if @load8(@ptradd(content, i)) == '\n' {
            line_num = line_num + 1
        }
        i = i + 1
    }
    if target_line > 0 && line_num != target_line {
        return
    }

    val end: mut i64 = start
    for {
        if end >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, end))
        if c == '\n' || c == '\r' {
            break
        }
        end = end + 1
    }
    @store(out_start as ref void, start)
    @store(out_end as ref void, end)
}

fn line_matches_variable_decl(line: ref u8, line_len: i64, word: ref u8) bool = trust {
    if line == none || word == none || line_len <= 0 {
        return false
    }
    val wlen: i64 = str.len_raw(word)
    val i: mut i64 = skip_ws_h(line, 0, line_len)
    if i >= line_len {
        return false
    }
    if starts_with_h(@ptradd(line, i), line_len - i, "pub ", 4) {
        i = skip_ws_h(line, i + 4, line_len)
    }

    if starts_with_h(@ptradd(line, i), line_len - i, "val ", 4) {
        i = skip_ws_h(line, i + 4, line_len)
        val name_len: i64 = ident_len_h(line, i, line_len)
        if name_len != wlen || name_len <= 0 {
            return false
        }
        if strncmp(@ptradd(line, i), word, name_len as usize) != 0 {
            return false
        }
        i = skip_ws_h(line, i + name_len, line_len)
        if starts_with_h(@ptradd(line, i), line_len - i, "= use(\"", 7) {
            return false
        }
        return true
    }

    if starts_with_h(@ptradd(line, i), line_len - i, "for ", 4) {
        i = skip_ws_h(line, i + 4, line_len)
        val name_len: i64 = ident_len_h(line, i, line_len)
        if name_len != wlen || name_len <= 0 {
            return false
        }
        if strncmp(@ptradd(line, i), word, name_len as usize) != 0 {
            return false
        }
        i = skip_ws_h(line, i + name_len, line_len)
        if starts_with_h(@ptradd(line, i), line_len - i, "in", 2) {
            val next_ok: bool = (i + 2 >= line_len) || !is_ident_cont_h(@load8(@ptradd(line, i + 2)))
            return next_ok
        }
    }
    return false
}

fn lookup_local_variable_decl(
    sym_store: ref void,
    current_uri: ref u8,
    content: ref u8,
    line: i64,
    _: i64,
    word: ref u8,
    out_line: ref i64
) ref u8 = trust {
    @store(out_line as ref void, -1 as i64)
    if current_uri == none || content == none || word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }
    if cur_syms == none {
        return none
    }

    val fn_sym: ref parser.Symbol = find_enclosing_callable(cur_syms, line)
    if fn_sym == none {
        return none
    }

    val slot_count: i64 = 64
    val line_slots: ref void = @alloc(slot_count * 8)
    val start_slots: ref void = @alloc(slot_count * 8)
    val end_slots: ref void = @alloc(slot_count * 8)
    if line_slots == none || start_slots == none || end_slots == none {
        if line_slots  != none {
            @free(line_slots)
        }
        if start_slots != none {
            @free(start_slots)
        }
        if end_slots   != none {
            @free(end_slots)
        }
        return none
    }
    @memset(line_slots, 255, slot_count * 8)
    @memset(start_slots, 255, slot_count * 8)
    @memset(end_slots, 255, slot_count * 8)

    val depth: mut i64 = 0
    val cur_line: mut i64 = fn_sym.line
    for {
        if cur_line > line {
            break
        }
        val ls: mut i64 = -1
        val le: mut i64 = -1
        line_bounds_for_line_h(content, cur_line, @addr(ls), @addr(le))
        if ls < 0 || le < ls {
            break
        }

        val scan_end: i64 = le
        val scan_len: i64 = scan_end - ls

        if cur_line >= fn_sym.line && scan_len > 0 &&
        line_matches_variable_decl(@ptradd(content, ls), scan_len, word) &&
        depth >= 0 && depth < slot_count {
            @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, cur_line)
            @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, ls)
            @store(@ptradd(end_slots as ref u8, depth * 8) as ref void, ls + trim_right_len_h(@ptradd(content, ls), scan_len))
        }

        val i: mut i64 = ls
        for {
            if i >= scan_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, i))
            if c == '{' {
                if depth + 1 < slot_count {
                    depth = depth + 1
                    @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(end_slots as ref u8, depth * 8) as ref void, -1 as i64)
                }
            } elif c == '}' {
                if depth >= 0 && depth < slot_count {
                    @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(end_slots as ref u8, depth * 8) as ref void, -1 as i64)
                }
                if depth > 0 {
                    depth = depth - 1
                }
            }
            i++
        }

        cur_line++
    }

    val best_depth: mut i64 = depth
    val result: mut ref u8 = none
    for {
        if best_depth < 0 {
            break
        }
        val decl_line: i64 = @load(@ptradd(line_slots as ref u8, best_depth * 8) as ref void) as i64
        if decl_line >= 0 {
            val start_off: i64 = @load(@ptradd(start_slots as ref u8, best_depth * 8) as ref void) as i64
            val end_off: i64 = @load(@ptradd(end_slots as ref u8, best_depth * 8) as ref void) as i64
            if start_off >= 0 && end_off > start_off {
                result = trim_left_dup_h(@ptradd(content, start_off), end_off - start_off)
                @store(out_line as ref void, decl_line)
            }
            break
        }
        best_depth = best_depth - 1
    }

    @free(line_slots)
    @free(start_slots)
    @free(end_slots)
    return result
}

fn lookup_global_variable_decl(
    content: ref u8,
    line: i64,
    _: i64,
    word: ref u8,
    out_line: ref i64
) ref u8 = trust {
    @store(out_line as ref void, -1 as i64)
    if content == none || word == none {
        return none
    }

    val best_start: mut i64 = -1
    val best_end: mut i64 = -1
    val best_line: mut i64 = -1
    val depth: mut i64 = 0
    val cur_line: mut i64 = 0
    for {
        if cur_line > line {
            break
        }
        val ls: mut i64 = -1
        val le: mut i64 = -1
        line_bounds_for_line_h(content, cur_line, @addr(ls), @addr(le))
        if ls < 0 || le < ls {
            break
        }

        val scan_end: i64 = le
        val scan_len: i64 = scan_end - ls

        if depth == 0 && scan_len > 0 &&
        line_matches_variable_decl(@ptradd(content, ls), scan_len, word) {
            best_start = ls
            best_end = ls + trim_right_len_h(@ptradd(content, ls), scan_len)
            best_line = cur_line
        }

        val i: mut i64 = ls
        for {
            if i >= scan_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, i))
            if c == '{' {
                depth = depth + 1
            } elif c == '}' {
                if depth > 0 {
                    depth = depth - 1
                }
            }
            i++
        }

        cur_line++
    }

    if best_start < 0 || best_end <= best_start {
        return none
    }
    @store(out_line as ref void, best_line)
    return trim_left_dup_h(@ptradd(content, best_start), best_end - best_start)
}

fn find_word_col_in_line(content: ref u8, target_line: i64, word: ref u8) i64 = trust {
    if content == none || word == none {
        return 0
    }
    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, target_line, @addr(ls), @addr(le))
    if ls < 0 || le < ls {
        return 0
    }
    val wlen: i64 = str.len_raw(word)
    val i: mut i64 = ls
    for {
        if i >= le {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))
        if !is_ident_cont_h(c) {
            i = i + 1
            continue
        }
        val start: i64 = i
        val n: mut i64 = 0
        for {
            if i >= le {
                break
            }
            if !is_ident_cont_h(@load8(@ptradd(content, i))) {
                break
            }
            i = i + 1
            n = n + 1
        }
        if n == wlen && strncmp(@ptradd(content, start), word, n as usize) == 0 {
            return start - ls
        }
    }
    return 0
}

fn get_content_for_file(doc_store: ref void, file_path: ref u8) ref u8 = trust {
    if doc_store == none || file_path == none {
        return none
    }
    val uri: ref u8 = parser.path_to_uri(file_path)
    if uri == none {
        return none
    }
    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    @free(uri as ref void)
    return content
}

fn extract_definition_block(content: ref u8, line: i64) ref u8 = trust {
    if content == none || line < 0 {
        return none
    }
    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    if ls < 0 || le < ls {
        return none
    }

    val len: i64 = str.len_raw(content)
    val i: mut i64 = ls
    val seen_brace: mut i64 = 0
    val depth: mut i64 = 0
    val end_off: mut i64 = le

    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))
        if c == '{' {
            depth = depth + 1
            seen_brace = 1
        } elif c == '}' && seen_brace == 1 {
            depth = depth - 1
            if depth <= 0 {
                end_off = i + 1
                break
            }
        }
        if c == '\n' && seen_brace == 0 {
            end_off = i
            break
        }
        i++
    }

    if seen_brace == 1 && end_off < le {
        end_off = le
    }
    val trimmed_len: i64 = trim_right_len_h(@ptradd(content, ls), end_off - ls)
    if trimmed_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(content, ls), trimmed_len)
}

fn align_up_h(n: i64, align: i64) i64 = {
    if align <= 1 {
        return n
    }
    return ((n + align - 1) / align) * align
}

fn field_align_h(size: i64) i64 = {
    if size <= 1 {
        return 1
    }
    if size >= 8 {
        return 8
    }
    if size >= 4 {
        return 4
    }
    if size >= 2 {
        return 2
    }
    return 1
}

fn find_matching_close_h(s: ref u8, len: i64, open_idx: i64, open_ch: u8, close_ch: u8) i64 = trust {
    if s == none || open_idx < 0 || open_idx >= len {
        return -1
    }
    val depth: mut i64 = 0
    val i: mut i64 = open_idx
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == open_ch {
            depth = depth + 1
        } elif c == close_ch {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn contains_substr_h(s: ref u8, needle: ref u8) bool = trust {
    if s == none || needle == none {
        return false
    }
    val slen: i64 = str.len_raw(s)
    val nlen: i64 = str.len_raw(needle)
    if nlen <= 0 || nlen > slen {
        return false
    }
    val i: mut i64 = 0
    for {
        if i + nlen > slen {
            break
        }
        if strncmp(@ptradd(s, i), needle, nlen as usize) == 0 {
            return true
        }
        i++
    }
    return false
}

fn estimate_type_symbol_size(
    doc_store: mut ref void,
    sym_store: mut ref void,
    sym: ref parser.Symbol,
    depth: i64
) i64 = trust {
    if sym == none {
        return 8
    }
    if depth > 8 {
        return 8
    }
    if sym.kind == parser.SYM_ENUM {
        return 8
    }
    if sym.kind != parser.SYM_TYPE && sym.kind != parser.SYM_UNION {
        return 8
    }

    val content: ref u8 = get_content_for_file(doc_store, sym.file)
    val def: ref u8 = extract_definition_block(content, sym.line)
    if def == none {
        return 8
    }

    val dlen: i64 = str.len_raw(def)
    val open_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= dlen {
            break
        }
        if @load8(@ptradd(def, i)) == '{' {
            open_idx = i break
        }
        i++
    }
    if open_idx < 0 {
        @free(def as ref void)
        return 8
    }
    val close_idx: i64 = find_matching_close_h(def, dlen, open_idx, '{', '}')
    if close_idx <= open_idx {
        @free(def as ref void)
        return 8
    }

    val current_uri_for_sym: ref u8 = parser.path_to_uri(sym.file)
    val body: ref u8 = @ptradd(def, open_idx + 1)
    val body_len: i64 = close_idx - open_idx - 1
    val result: mut i64 = 0

    if sym.kind == parser.SYM_UNION {
        val max_payload: mut i64 = 0
        val seg_start: mut i64 = 0
        val sq_depth: mut i64 = 0
        val paren_depth: mut i64 = 0
        val j: mut i64 = 0
        for {
            val emit: mut i64 = 0
            if j >= body_len {
                emit = 1
            } else {
                val c: u8 = @load8(@ptradd(body, j))
                if c == '[' {
                    sq_depth = sq_depth + 1
                }
                elif c == ']' {
                    if sq_depth > 0 {
                        sq_depth = sq_depth - 1
                    }
                }
                elif c == '(' {
                    paren_depth = paren_depth + 1
                }
                elif c == ')' {
                    if paren_depth > 0 {
                        paren_depth = paren_depth - 1
                    }
                }
                elif c == '|' && sq_depth == 0 && paren_depth == 0 {
                    emit = 1
                }
            }

            if emit == 1 {
                val seg_len: i64 = trim_right_len_h(@ptradd(body, seg_start), j - seg_start)
                if seg_len > 0 {
                    val variant: ref u8 = raw_dup_h(@ptradd(body, seg_start), seg_len)
                    if variant != none {
                        val vlen: i64 = str.len_raw(variant)
                        val open_paren: mut i64 = -1
                        val k: mut i64 = 0
                        for {
                            if k >= vlen {
                                break
                            }
                            if @load8(@ptradd(variant, k)) == '(' {
                                open_paren = k break
                            }
                            k++
                        }
                        val payload_size: mut i64 = 0
                        if open_paren >= 0 {
                            val close_paren: i64 = find_matching_close_h(variant, vlen, open_paren, '(', ')')
                            if close_paren > open_paren {
                                val arg_start: mut i64 = open_paren + 1
                                val arg_sq_depth: mut i64 = 0
                                val arg_paren_depth: mut i64 = 0
                                val m: mut i64 = arg_start
                                val running: mut i64 = 0
                                val running_align: mut i64 = 1
                                for {
                                    val arg_emit: mut i64 = 0
                                    if m >= close_paren {
                                        arg_emit = 1
                                    } else {
                                        val cc: u8 = @load8(@ptradd(variant, m))
                                        if cc == '[' {
                                            arg_sq_depth = arg_sq_depth + 1
                                        }
                                        elif cc == ']' {
                                            if arg_sq_depth > 0 {
                                                arg_sq_depth = arg_sq_depth - 1
                                            }
                                        }
                                        elif cc == '(' {
                                            arg_paren_depth = arg_paren_depth + 1
                                        }
                                        elif cc == ')' {
                                            if arg_paren_depth > 0 {
                                                arg_paren_depth = arg_paren_depth - 1
                                            }
                                        }
                                        elif cc == ',' && arg_sq_depth == 0 && arg_paren_depth == 0 {
                                            arg_emit = 1
                                        }
                                    }
                                    if arg_emit == 1 {
                                        val arg_len: i64 = trim_right_len_h(@ptradd(variant, arg_start), m - arg_start)
                                        if arg_len > 0 {
                                            val arg_expr: ref u8 = raw_dup_h(@ptradd(variant, arg_start), arg_len)
                                            if arg_expr != none {
                                                val arg_size: i64 = estimate_type_expr_size(
                                                    doc_store, sym_store, current_uri_for_sym, sym.file, arg_expr, depth + 1
                                                )
                                                @free(arg_expr as ref void)
                                                val arg_align: i64 = field_align_h(arg_size)
                                                running = align_up_h(running, arg_align)
                                                running = running + arg_size
                                                if arg_align > running_align {
                                                    running_align = arg_align
                                                }
                                            }
                                        }
                                        arg_start = m + 1
                                    }
                                    if m >= close_paren {
                                        break
                                    }
                                    m++
                                }
                                payload_size = align_up_h(running, running_align)
                            }
                        }
                        if payload_size > max_payload {
                            max_payload = payload_size
                        }
                        @free(variant as ref void)
                    }
                }
                seg_start = j + 1
            }

            if j >= body_len {
                break
            }
            j++
        }
        result = align_up_h(max_payload + 8, 8)
    } else {
        val offset: mut i64 = 0
        val max_align: mut i64 = 1
        val line_start: mut i64 = 0
        val j: mut i64 = 0
        for {
            val emit: mut i64 = 0
            if j >= body_len {
                emit = 1
            } else {
                val c: u8 = @load8(@ptradd(body, j))
                if c == '\n' || c == '\r' {
                    emit = 1
                }
            }

            if emit == 1 {
                val raw_len: i64 = trim_right_len_h(@ptradd(body, line_start), j - line_start)
                if raw_len > 0 {
                    val field_line: ref u8 = raw_dup_h(@ptradd(body, line_start), raw_len)
                    if field_line != none {
                        val flen: i64 = str.len_raw(field_line)
                        val colon_idx: mut i64 = -1
                        val k: mut i64 = 0
                        for {
                            if k >= flen {
                                break
                            }
                            if @load8(@ptradd(field_line, k)) == ':' {
                                colon_idx = k break
                            }
                            k++
                        }
                        if colon_idx >= 0 {
                            val type_start: i64 = skip_ws_h(field_line, colon_idx + 1, flen)
                            val type_len: i64 = trim_right_len_h(@ptradd(field_line, type_start), flen - type_start)
                            if type_len > 0 {
                                val type_expr: ref u8 = raw_dup_h(@ptradd(field_line, type_start), type_len)
                                if type_expr != none {
                                    val field_size: i64 = estimate_type_expr_size(
                                        doc_store, sym_store, current_uri_for_sym, sym.file, type_expr, depth + 1
                                    )
                                    @free(type_expr as ref void)
                                    val align: i64 = field_align_h(field_size)
                                    offset = align_up_h(offset, align)
                                    offset = offset + field_size
                                    if align > max_align {
                                        max_align = align
                                    }
                                }
                            }
                        }
                        @free(field_line as ref void)
                    }
                }
                line_start = j + 1
            }

            if j >= body_len {
                break
            }
            j++
        }
        result = align_up_h(offset, max_align)
    }

    if current_uri_for_sym != none {
        @free(current_uri_for_sym as ref void)
    }
    @free(def as ref void)
    return result
}

fn estimate_type_expr_size(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    type_expr: ref u8,
    depth: i64
) i64 = trust {
    if type_expr == none {
        return 8
    }
    if depth > 8 {
        return 8
    }

    val expr_len: i64 = str.len_raw(type_expr)
    val start: i64 = skip_ws_h(type_expr, 0, expr_len)
    val trimmed_len: i64 = trim_right_len_h(@ptradd(type_expr, start), expr_len - start)
    if trimmed_len <= 0 {
        return 8
    }

    val expr: ref u8 = raw_dup_h(@ptradd(type_expr, start), trimmed_len)
    if expr == none {
        return 8
    }
    val len: i64 = str.len_raw(expr)

    if starts_with_h(expr, len, "mut ", 4) {
        val out: i64 = estimate_type_expr_size(doc_store, sym_store, current_uri, current_file, @ptradd(expr, 4), depth + 1)
        @free(expr as ref void)
        return out
    }
    if starts_with_h(expr, len, "ref ", 4) {
        @free(expr as ref void)
        return 8
    }

    val builtin_size: i64 = builtin_type_size(expr)
    if builtin_size >= 0 && is_builtin_type_word(expr) {
        @free(expr as ref void)
        return builtin_size
    }

    if starts_with_h(expr, len, "list[", 5) {
        @free(expr as ref void)
        return 24
    }
    if starts_with_h(expr, len, "option[", 7) {
        val close_idx: i64 = find_matching_close_h(expr, len, 6, '[', ']')
        if close_idx > 6 {
            val inner: ref u8 = raw_dup_h(@ptradd(expr, 7), close_idx - 7)
            val inner_size: i64 = estimate_type_expr_size(doc_store, sym_store, current_uri, current_file, inner, depth + 1)
            if inner != none {
                @free(inner as ref void)
            }
            @free(expr as ref void)
            return align_up_h(inner_size, field_align_h(inner_size)) + 8
        }
        @free(expr as ref void)
        return 16
    }
    if starts_with_h(expr, len, "result[", 7) {
        val close_idx: i64 = find_matching_close_h(expr, len, 6, '[', ']')
        if close_idx > 6 {
            val inner: ref u8 = raw_dup_h(@ptradd(expr, 7), close_idx - 7)
            if inner != none {
                val ilen: i64 = str.len_raw(inner)
                val sq_depth: mut i64 = 0
                val paren_depth: mut i64 = 0
                val comma_idx: mut i64 = -1
                val i: mut i64 = 0
                for {
                    if i >= ilen {
                        break
                    }
                    val c: u8 = @load8(@ptradd(inner, i))
                    if c == '[' {
                        sq_depth = sq_depth + 1
                    }
                    elif c == ']' {
                        if sq_depth > 0 {
                            sq_depth = sq_depth - 1
                        }
                    }
                    elif c == '(' {
                        paren_depth = paren_depth + 1
                    }
                    elif c == ')' {
                        if paren_depth > 0 {
                            paren_depth = paren_depth - 1
                        }
                    }
                    elif c == ',' && sq_depth == 0 && paren_depth == 0 {
                        comma_idx = i break
                    }
                    i++
                }
                if comma_idx >= 0 {
                    val ok_expr: ref u8 = raw_dup_h(inner, comma_idx)
                    val err_expr: ref u8 = raw_dup_h(@ptradd(inner, comma_idx + 1), ilen - comma_idx - 1)
                    val ok_size: i64 = estimate_type_expr_size(doc_store, sym_store, current_uri, current_file, ok_expr, depth + 1)
                    val err_size: i64 = estimate_type_expr_size(doc_store, sym_store, current_uri, current_file, err_expr, depth + 1)
                    if ok_expr != none {
                        @free(ok_expr as ref void)
                    }
                    if err_expr != none {
                        @free(err_expr as ref void)
                    }
                    @free(inner as ref void)
                    @free(expr as ref void)
                    val max_sz: mut i64 = ok_size
                    if err_size > max_sz {
                        max_sz = err_size
                    }
                    return align_up_h(max_sz, field_align_h(max_sz)) + 8
                }
                @free(inner as ref void)
            }
        }
        @free(expr as ref void)
        return 16
    }

    val dot_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(expr, i)) == '.' {
            dot_idx = i break
        }
        i++
    }

    val lookup_name: mut ref u8 = none
    val lookup_alias: mut ref u8 = none
    if dot_idx > 0 && dot_idx + 1 < len {
        lookup_alias = raw_dup_h(expr, dot_idx)
        lookup_name = raw_dup_h(@ptradd(expr, dot_idx + 1), len - dot_idx - 1)
    } else {
        lookup_name = raw_dup_cstr_h(expr)
    }

    val resolved: ref parser.Symbol = lookup_symbol(
        doc_store, sym_store, current_uri, current_file, lookup_name, lookup_alias
    )
    if lookup_name != none {
        @free(lookup_name as ref void)
    }
    if lookup_alias != none {
        @free(lookup_alias as ref void)
    }
    @free(expr as ref void)

    if resolved == none {
        return 8
    }
    return estimate_type_symbol_size(doc_store, sym_store, resolved, depth + 1)
}

fn append_type_hover_contents(
    sb: str.StringBuilder,
    doc_store: mut ref void,
    sym_store: mut ref void,
    _: ref u8,
    _: ref u8,
    sym: ref parser.Symbol
) void = trust {
    if sym == none {
        return
    }
    val def_content: ref u8 = get_content_for_file(doc_store, sym.file)
    val definition: ref u8 = extract_definition_block(def_content, sym.line)
    val approx_size: i64 = estimate_type_symbol_size(doc_store, sym_store, sym, 0)

    str.StringBuilder.append_cstr(sb, "```spectre\\n")
    if definition != none {
        sb_escape(sb, definition)
    } elif sym.signature != none {
        sb_escape(sb, sym.signature)
    } elif sym.name != none {
        sb_escape(sb, sym.name)
    }
    str.StringBuilder.append_cstr(sb, "\\n```")

    if approx_size >= 0 {
        str.StringBuilder.append_cstr(sb, "\\n\\nApprox. size: ")
        sb_append_int(sb, approx_size)
        str.StringBuilder.append_cstr(sb, " bytes")
    }

    if sym.doc != none && str.len_raw(sym.doc) > 0 {
        str.StringBuilder.append_cstr(sb, "\\n\\n")
        sb_escape(sb, sym.doc)
    }

    if definition != none {
        @free(definition as ref void)
    }
}

fn append_builtin_type_hover_contents(sb: str.StringBuilder, word: ref u8) void = trust {
    str.StringBuilder.append_cstr(sb, "```spectre\\n")
    sb_escape(sb, builtin_type_signature(word))
    str.StringBuilder.append_cstr(sb, "\\n```\\n\\n")
    sb_escape(sb, builtin_type_desc(word))
    str.StringBuilder.append_cstr(sb, "\\n\\nApprox. size: ")
    sb_append_int(sb, builtin_type_size(word))
    str.StringBuilder.append_cstr(sb, " bytes")
}

fn symbol_is_unverified(doc_store: ref void, sym: ref parser.Symbol) bool = trust {
    if doc_store == none || sym == none || sym.file == none || sym.line < 0 {
        return false
    }
    if sym.kind != parser.SYM_FUNCTION && sym.kind != parser.SYM_METHOD {
        return false
    }
    val content: ref u8 = get_content_for_file(doc_store, sym.file)
    if content == none {
        return false
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, sym.line, @addr(ls), @addr(le))
    if ls < 0 || le <= ls {
        return false
    }

    val line_len: i64 = trim_right_len_h(@ptradd(content, ls), le - ls)
    if line_len <= 0 {
        return false
    }
    val line_text: ref u8 = trim_left_dup_h(@ptradd(content, ls), line_len)
    if line_text == none {
        return false
    }
    val llen: i64 = str.len_raw(line_text)
    val unverified: bool = contains_substr_h(line_text, "= trust") ||
    contains_substr_h(line_text, " = trust") ||
    starts_with_h(line_text, llen, "trust ", 6)
    @free(line_text as ref void)
    return unverified
}

fn sym_kind_to_lsp(kind: i64) i64 = {
    if kind == parser.SYM_FUNCTION {
        return 12
    }
    if kind == parser.SYM_METHOD {
        return 6
    }
    if kind == parser.SYM_TYPE {
        return 23
    }
    if kind == parser.SYM_ENUM {
        return 10
    }
    if kind == parser.SYM_UNION {
        return 23
    }
    if kind == parser.SYM_MODULE {
        return 2
    }
    if kind == parser.SYM_FIELD {
        return 5
    }
    return 13
}

fn append_range(sb: str.StringBuilder, line: i64, cs: i64, ce: i64) void = trust {
    str.StringBuilder.append_cstr(sb, "{\"start\":{\"line\":")
    sb_append_int(sb, line)
    str.StringBuilder.append_cstr(sb, ",\"character\":")
    sb_append_int(sb, cs)
    str.StringBuilder.append_cstr(sb, "},\"end\":{\"line\":")
    sb_append_int(sb, line)
    str.StringBuilder.append_cstr(sb, ",\"character\":")
    sb_append_int(sb, ce)
    str.StringBuilder.append_cstr(sb, "}}")
}

fn first_line_dup(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = str.len_raw(s)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == '\n' || c == '\r' {
            break
        }
        i = i + 1
    }
    if i == 0 {
        return none
    }
    return raw_dup_h(s, i)
}

pub fn find_completion_context(
    content: ref u8,
    line: i64,
    col: i64,
    out_start: ref i64,
    out_end: ref i64,
    out_has_dot: ref i64,
    out_base_start: ref i64,
    out_base_len: ref i64
) void = trust {
    @store(out_start as ref void, -1 as i64)
    @store(out_end as ref void, -1 as i64)
    @store(out_has_dot as ref void, 0 as i64)
    @store(out_base_start as ref void, -1 as i64)
    @store(out_base_len as ref void, 0 as i64)
    if content == none || line < 0 || col < 0 {
        return
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    if ls < 0 {
        return
    }

    val cursor: mut i64 = ls + col
    if cursor < ls {
        cursor = ls
    }
    if cursor > le {
        cursor = le
    }

    val ps: mut i64 = cursor
    for {
        if ps <= ls {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(content, ps - 1))) {
            break
        }
        ps = ps - 1
    }
    @store(out_start as ref void, ps)
    @store(out_end as ref void, cursor)

    if ps <= ls {
        return
    }
    if @load8(@ptradd(content, ps - 1)) != '.' {
        return
    }

    val dot: i64 = ps - 1
    val be: i64 = dot
    val bs: mut i64 = be
    for {
        val seg_end: i64 = bs
        for {
            if bs <= ls {
                break
            }
            if !is_ident_cont_h(@load8(@ptradd(content, bs - 1))) {
                break
            }
            bs = bs - 1
        }
        if bs == seg_end {
            break
        }
        if bs > ls && @load8(@ptradd(content, bs - 1)) == '.' {
            bs = bs - 1
        } else {
            break
        }
    }
    if be > bs {
        @store(out_has_dot as ref void, 1 as i64)
        @store(out_base_start as ref void, bs)
        @store(out_base_len as ref void, be - bs)
    }
}

fn prefix_matches_h(name: ref u8, prefix: ref u8) bool = trust {
    if name == none {
        return false
    }
    if prefix == none {
        return true
    }
    val nlen: i64 = str.len_raw(name)
    val plen: i64 = str.len_raw(prefix)
    if plen <= 0 {
        return true
    }
    if plen > nlen {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= plen {
            break
        }
        val a: mut u8 = @load8(@ptradd(name, i))
        val b: mut u8 = @load8(@ptradd(prefix, i))
        if a >= 65 && a <= 90 {
            a = a + 32
        }
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        if a != b {
            return false
        }
        i = i + 1
    }
    return true
}

fn append_completion_item(
    sb: str.StringBuilder,
    first: ref i64,
    label: ref u8,
    detail: ref u8,
    doc: ref u8,
    kind: i64,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if label == none {
        return
    }
    if @load(first as ref void) == 0 {
        str.StringBuilder.append_cstr(sb, ",")
    }
    @store(first as ref void, 0 as i64)

    str.StringBuilder.append_cstr(sb, "{\"label\":\"")
    sb_escape(sb, label)
    str.StringBuilder.append_cstr(sb, "\",\"kind\":")
    sb_append_int(sb, kind)

    if detail != none && str.len_raw(detail) > 0 {
        str.StringBuilder.append_cstr(sb, ",\"detail\":\"")
        sb_escape(sb, detail)
        str.StringBuilder.append_cstr(sb, "\"")
    }
    if doc != none && str.len_raw(doc) > 0 {
        str.StringBuilder.append_cstr(sb, ",\"documentation\":{\"kind\":\"markdown\",\"value\":\"")
        sb_escape(sb, doc)
        str.StringBuilder.append_cstr(sb, "\"}")
    }
    if replace_start >= 0 && replace_end >= replace_start {
        str.StringBuilder.append_cstr(sb, ",\"textEdit\":{\"range\":")
        append_range(sb, replace_line, replace_start, replace_end)
        str.StringBuilder.append_cstr(sb, ",\"newText\":\"")
        sb_escape(sb, label)
        str.StringBuilder.append_cstr(sb, "\"}")
    }
    str.StringBuilder.append_cstr(sb, "}")
}

fn append_symbol_completion(
    sb: str.StringBuilder,
    first: ref i64,
    sym: ref parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if sym == none || sym.name == none {
        return
    }
    if !prefix_matches_h(sym.name, prefix) {
        return
    }
    val detail: mut ref u8 = sym.signature
    if sym.kind == parser.SYM_FIELD || sym.kind == parser.SYM_VARIABLE {
        detail = sym.ret_type
    }
    append_completion_item(
        sb, first, sym.name, detail, sym.doc,
        sym_kind_to_lsp(sym.kind), replace_line, replace_start, replace_end
    )
}

fn append_method_completions(
    sb: str.StringBuilder,
    first: ref i64,
    sym_store: mut ref void,
    doc_store: mut ref void,
    type_sym: ref parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if type_sym == none || type_sym.file == none || type_sym.name == none {
        return
    }
    val syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
    if syms == none {
        return
    }
    val n: usize = coll.PtrList.len(syms)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(syms, i) is some v {
            val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
            if sym != none && sym.kind == parser.SYM_METHOD && method_receiver_matches(sym.receiver, type_sym.name) {
                append_symbol_completion(sb, first, sym, prefix, replace_line, replace_start, replace_end)
            }
        }
        i++
    }
}

fn append_field_completions(
    sb: str.StringBuilder,
    first: ref i64,
    doc_store: mut ref void,
    sym_store: mut ref void,
    type_sym: ref parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
    if fields == none {
        return
    }
    val n: usize = coll.PtrList.len(fields)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(fields, i) is some v {
            val field: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
            append_symbol_completion(sb, first, field, prefix, replace_line, replace_start, replace_end)
        }
        i++
    }
    parser.free_sym_list(fields)
}

fn module_syms_for_alias(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    alias: ref u8
) ref void = trust {
    if alias == none {
        return none
    }
    val cur_syms: mut ref void = none
    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
    }
    val imp: ref parser.Symbol = find_import_sym(cur_syms, alias)
    if imp == none || imp.ret_type == none {
        return none
    }
    val mod_file: ref u8 = parser.resolve_module_path(current_file, imp.ret_type)
    if mod_file == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, mod_file)
    val mod_uri: ref u8 = parser.path_to_uri(mod_file)
    @free(mod_file as ref void)
    if mod_uri == none {
        return none
    }
    val mod_syms: mut ref void = none
    if coll.StringMap.get(sym_store, mod_uri) is some v {
        mod_syms = @bitcast(v, ref void)
    }
    @free(mod_uri as ref void)
    return mod_syms
}

fn resolve_chain_type_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    content: ref u8,
    line: i64,
    cursor_off: i64,
    base: ref u8,
    depth: i64
) ref parser.Symbol = trust {
    if base == none || depth > 8 {
        return none
    }
    val len: i64 = str.len_raw(base)
    if len <= 0 {
        return none
    }

    val first_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(base, i)) == '.' {
            first_dot = i
            break
        }
        i = i + 1
    }
    val head: mut ref u8 = none
    if first_dot >= 0 {
        head = raw_dup_h(base, first_dot)
    } else {
        head = raw_dup_cstr_h(base)
    }
    if head == none {
        return none
    }

    val head_type: ref u8 = lookup_variable_type_expr(
        doc_store, sym_store, current_uri, current_file, content, line, cursor_off,
        head, depth + 1
    )
    @free(head as ref void)
    if head_type == none {
        return none
    }
    val head_sym: ref parser.Symbol = resolve_type_symbol(
        doc_store, sym_store, current_uri, current_file, head_type, depth + 1
    )
    @free(head_type as ref void)
    if head_sym == none || first_dot < 0 {
        return head_sym
    }

    val current: mut ref parser.Symbol = head_sym
    val pos: mut i64 = first_dot + 1
    for {
        if pos >= len {
            break
        }
        val seg_start: i64 = pos
        val seg_end: mut i64 = pos
        for {
            if seg_end >= len {
                break
            }
            if @load8(@ptradd(base, seg_end)) == '.' {
                break
            }
            seg_end = seg_end + 1
        }
        if seg_end > seg_start && current != none {
            val seg: ref u8 = raw_dup_h(@ptradd(base, seg_start), seg_end - seg_start)
            if seg != none {
                val fields: mut ref void = fields_for_type(doc_store, sym_store, current)
                val field: ref parser.Symbol = find_sym_by_name(fields, seg)
                val field_type: mut ref u8 = none
                if field != none && field.ret_type != none {
                    field_type = raw_dup_cstr_h(field.ret_type)
                }
                if fields != none {
                    parser.free_sym_list(fields)
                }
                @free(seg as ref void)
                if field_type == none {
                    return none
                }
                val field_uri: ref u8 = parser.path_to_uri(current.file)
                current = resolve_type_symbol(
                    doc_store, sym_store, field_uri, current.file, field_type, depth + 1
                )
                if field_uri != none {
                    @free(field_uri as ref void)
                }
                @free(field_type as ref void)
            }
        }
        pos = seg_end
        if pos < len && @load8(@ptradd(base, pos)) == '.' {
            pos = pos + 1
        }
    }
    return current
}

fn send_field_hover(
    id_raw: ref void,
    field: ref parser.Symbol,
    type_sym: ref parser.Symbol
) void = trust {
    if field == none {
        send_null_result(id_raw)
        return
    }
    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
    str.StringBuilder.append_cstr(sb, "```spectre\\n")
    sb_escape(sb, field.name)
    str.StringBuilder.append_cstr(sb, ": ")
    sb_escape(sb, field.ret_type)
    str.StringBuilder.append_cstr(sb, "\\n```\\n\\nField")
    if type_sym != none && type_sym.name != none {
        str.StringBuilder.append_cstr(sb, " of ")
        sb_escape(sb, type_sym.name)
    }
    if field.doc != none && str.len_raw(field.doc) > 0 {
        str.StringBuilder.append_cstr(sb, "\\n\\n")
        sb_escape(sb, field.doc)
    }
    str.StringBuilder.append_cstr(sb, "\"}}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn handle_hover(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw) return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw) return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw) return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw) return
    }

    val ws: mut i64 = -1
    val wl: mut i64 = 0
    parser.find_word_at(content, line, col, @addr(ws), @addr(wl))
    if ws < 0 || wl <= 0 {
        send_null_result(id_raw) return
    }

    val word: ref u8 = @alloc(wl + 1) as ref u8
    if word == none {
        send_null_result(id_raw) return
    }
    @memcpy(word as ref void, @ptradd(content, ws), wl as usize)
    @store8(@ptradd(word, wl), 0)

    val ms: mut i64 = -1
    val ml: mut i64 = 0
    parser.find_dot_prefix(content, ws, @addr(ms), @addr(ml))

    val module_alias: mut ref u8 = none
    if ms >= 0 && ml > 0 {
        module_alias = @alloc(ml + 1) as ref u8
        if module_alias != none {
            @memcpy(module_alias as ref void, @ptradd(content, ms), ml as usize)
            @store8(@ptradd(module_alias, ml), 0)
        }
    }

    val file_path: ref u8 = parser.uri_to_path(uri)

    // `value.field` / `Type.method` hover.  The part before the dot may be a
    // local variable, a parameter, a global, or a type name.
    if module_alias != none {
        val base_type: ref u8 = lookup_variable_type_expr(
            doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
        )
        val type_sym: mut ref parser.Symbol = none
        if base_type != none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, base_type, 0)
            @free(base_type as ref void)
        }
        if type_sym == none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, module_alias, 0)
        }
        if type_sym == none {
            type_sym = resolve_chain_type_symbol(
                doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
            )
        }
        if type_sym != none {
            val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
            val field: ref parser.Symbol = find_sym_by_name(fields, word)
            if field != none {
                val sb: str.StringBuilder = str.StringBuilder.new()
                make_base(sb, id_raw)
                str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
                str.StringBuilder.append_cstr(sb, "```spectre\\n")
                sb_escape(sb, field.name)
                str.StringBuilder.append_cstr(sb, ": ")
                sb_escape(sb, field.ret_type)
                str.StringBuilder.append_cstr(sb, "\\n```\\n\\nField of ")
                sb_escape(sb, type_sym.name)
                if field.doc != none && str.len_raw(field.doc) > 0 {
                    str.StringBuilder.append_cstr(sb, "\\n\\n")
                    sb_escape(sb, field.doc)
                }
                str.StringBuilder.append_cstr(sb, "\"}}}")
                val built: mut str.String = str.StringBuilder.build(sb)
                write_response(str.cstr(built))
                str.string_free(built)
                str.StringBuilder.free(sb)
                if fields != none {
                    parser.free_sym_list(fields)
                }
                if word != none {
                    @free(word as ref void)
                }
                if file_path != none {
                    @free(file_path as ref void)
                }
                if module_alias != none {
                    @free(module_alias as ref void)
                }
                return
            }
            if fields != none {
                parser.free_sym_list(fields)
            }

            val type_syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
            val method: ref parser.Symbol = find_sym_by_name(type_syms, word)
            if method != none && method.kind == parser.SYM_METHOD &&
            method_receiver_matches(method.receiver, type_sym.name) {
                val sb: str.StringBuilder = str.StringBuilder.new()
                make_base(sb, id_raw)
                str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
                str.StringBuilder.append_cstr(sb, "```spectre\\n")
                sb_escape(sb, method.signature)
                str.StringBuilder.append_cstr(sb, "\\n```")
                if method.doc != none && str.len_raw(method.doc) > 0 {
                    str.StringBuilder.append_cstr(sb, "\\n\\n")
                    sb_escape(sb, method.doc)
                }
                str.StringBuilder.append_cstr(sb, "\"}}}")
                val built: mut str.String = str.StringBuilder.build(sb)
                write_response(str.cstr(built))
                str.string_free(built)
                str.StringBuilder.free(sb)
                if word != none {
                    @free(word as ref void)
                }
                if file_path != none {
                    @free(file_path as ref void)
                }
                if module_alias != none {
                    @free(module_alias as ref void)
                }
                return
            }
        }
    }

    if module_alias == none && is_keyword(word) {
        val sb: str.StringBuilder = str.StringBuilder.new()
        make_base(sb, id_raw)
        str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
        append_keyword_hover_contents(sb, word)
        str.StringBuilder.append_cstr(sb, "\"}}}")
        val built: mut str.String = str.StringBuilder.build(sb)
        write_response(str.cstr(built))
        str.string_free(built)
        str.StringBuilder.free(sb)
        if word != none {
            @free(word as ref void)
        }
        if file_path != none {
            @free(file_path as ref void)
        }
        if module_alias != none {
            @free(module_alias as ref void)
        }
        return
    }

    // Hovering a field in its own type declaration.
    if module_alias == none {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val tsym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
                    if tsym != none &&
                    (tsym.kind == parser.SYM_TYPE || tsym.kind == parser.SYM_ENUM || tsym.kind == parser.SYM_UNION) {
                        val fields: mut ref void = fields_for_type(doc_store, sym_store, tsym)
                        val field: ref parser.Symbol = find_sym_by_name(fields, word)
                        if field != none && field.line == line {
                            send_field_hover(id_raw, field, tsym)
                            if fields != none {
                                parser.free_sym_list(fields)
                            }
                            if word != none {
                                @free(word as ref void)
                            }
                            if file_path != none {
                                @free(file_path as ref void)
                            }
                            if module_alias != none {
                                @free(module_alias as ref void)
                            }
                            return
                        }
                        if fields != none {
                            parser.free_sym_list(fields)
                        }
                    }
                }
                i++
            }
        }
    }

    if module_alias == none {
        val param_decl: ref u8 = lookup_parameter_decl(sym_store, uri, line, word)
        if param_decl != none {
            val sb: str.StringBuilder = str.StringBuilder.new()
            make_base(sb, id_raw)
            str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
            str.StringBuilder.append_cstr(sb, "```spectre\\n")
            sb_escape(sb, param_decl)
            str.StringBuilder.append_cstr(sb, "\\n```\\n\\nFunction parameter")
            str.StringBuilder.append_cstr(sb, "\"}}}")
            val built: mut str.String = str.StringBuilder.build(sb)
            write_response(str.cstr(built))
            str.string_free(built)
            str.StringBuilder.free(sb)
            if word         != none {
                @free(word as ref void)
            }
            if file_path    != none {
                @free(file_path as ref void)
            }
            if module_alias != none {
                @free(module_alias as ref void)
            }
            return
        }

        val local_line: mut i64 = -1
        val local_decl: ref u8 = lookup_local_variable_decl(sym_store, uri, content, line, ws, word, @addr(local_line))
        if local_decl != none {
            val sb: str.StringBuilder = str.StringBuilder.new()
            make_base(sb, id_raw)
            str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
            str.StringBuilder.append_cstr(sb, "```spectre\\n")
            sb_escape(sb, local_decl)
            str.StringBuilder.append_cstr(sb, "\\n```\\n\\nLocal variable")
            str.StringBuilder.append_cstr(sb, "\"}}}")
            val built: mut str.String = str.StringBuilder.build(sb)
            write_response(str.cstr(built))
            str.string_free(built)
            str.StringBuilder.free(sb)
            @free(local_decl as ref void)
            if word         != none {
                @free(word as ref void)
            }
            if file_path    != none {
                @free(file_path as ref void)
            }
            if module_alias != none {
                @free(module_alias as ref void)
            }
            return
        }

        val global_line: mut i64 = -1
        val global_decl: ref u8 = lookup_global_variable_decl(content, line, ws, word, @addr(global_line))
        if global_decl != none {
            val sb: str.StringBuilder = str.StringBuilder.new()
            make_base(sb, id_raw)
            str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
            str.StringBuilder.append_cstr(sb, "```spectre\\n")
            sb_escape(sb, global_decl)
            str.StringBuilder.append_cstr(sb, "\\n```\\n\\nGlobal variable")
            str.StringBuilder.append_cstr(sb, "\"}}}")
            val built: mut str.String = str.StringBuilder.build(sb)
            write_response(str.cstr(built))
            str.string_free(built)
            str.StringBuilder.free(sb)
            @free(global_decl as ref void)
            if word         != none {
                @free(word as ref void)
            }
            if file_path    != none {
                @free(file_path as ref void)
            }
            if module_alias != none {
                @free(module_alias as ref void)
            }
            return
        }
    }

    val sym: ref parser.Symbol = lookup_symbol(
        doc_store, sym_store, uri, file_path, word, module_alias
    )
    if sym == none && module_alias == none && is_builtin_type_word(word) {
        val sb: str.StringBuilder = str.StringBuilder.new()
        make_base(sb, id_raw)
        str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")
        append_builtin_type_hover_contents(sb, word)
        str.StringBuilder.append_cstr(sb, "\"}}}")
        val built: mut str.String = str.StringBuilder.build(sb)
        write_response(str.cstr(built))
        str.string_free(built)
        str.StringBuilder.free(sb)
        if file_path    != none {
            @free(file_path as ref void)
        }
        if word         != none {
            @free(word as ref void)
        }
        if module_alias != none {
            @free(module_alias as ref void)
        }
        return
    }

    if word         != none {
        @free(word as ref void)
    }
    if module_alias != none {
        @free(module_alias as ref void)
    }

    if sym == none {
        if file_path != none {
            @free(file_path as ref void)
        }
        send_null_result(id_raw)
        return
    }

    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"")

    if sym.kind == parser.SYM_TYPE || sym.kind == parser.SYM_ENUM || sym.kind == parser.SYM_UNION {
        append_type_hover_contents(sb, doc_store, sym_store, uri, file_path, sym)
    } else {
        if sym.signature != none {
            str.StringBuilder.append_cstr(sb, "```spectre\\n")
            sb_escape(sb, sym.signature)
            str.StringBuilder.append_cstr(sb, "\\n```")
        }
        if symbol_is_unverified(doc_store, sym) {
            str.StringBuilder.append_cstr(sb, "\\n\\n(unverified)")
        }
        if sym.doc != none && str.len_raw(sym.doc) > 0 {
            str.StringBuilder.append_cstr(sb, "\\n\\n")
            sb_escape(sb, sym.doc)
        }
    }

    str.StringBuilder.append_cstr(sb, "\"}}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
    if file_path != none {
        @free(file_path as ref void)
    }
}

fn send_definition_location(
    id_raw: ref void,
    def_uri: ref u8,
    line: i64,
    col: i64,
    name_len: i64
) void = trust {
    if def_uri == none {
        send_null_result(id_raw)
        return
    }
    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"uri\":\"")
    sb_escape(sb, def_uri)
    str.StringBuilder.append_cstr(sb, "\",\"range\":")
    append_range(sb, line, col, col + name_len)
    str.StringBuilder.append_cstr(sb, "}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn handle_definition(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw) return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw) return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw) return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw) return
    }

    val ws: mut i64 = -1
    val wl: mut i64 = 0
    parser.find_word_at(content, line, col, @addr(ws), @addr(wl))
    if ws < 0 || wl <= 0 {
        send_null_result(id_raw) return
    }

    val word: ref u8 = @alloc(wl + 1) as ref u8
    if word == none {
        send_null_result(id_raw) return
    }
    @memcpy(word as ref void, @ptradd(content, ws), wl as usize)
    @store8(@ptradd(word, wl), 0)

    val ms: mut i64 = -1
    val ml: mut i64 = 0
    parser.find_dot_prefix(content, ws, @addr(ms), @addr(ml))

    val module_alias: mut ref u8 = none
    if ms >= 0 && ml > 0 {
        module_alias = @alloc(ml + 1) as ref u8
        if module_alias != none {
            @memcpy(module_alias as ref void, @ptradd(content, ms), ml as usize)
            @store8(@ptradd(module_alias, ml), 0)
        }
    }

    val file_path: ref u8 = parser.uri_to_path(uri)

    if module_alias != none {
        val base_type: ref u8 = lookup_variable_type_expr(
            doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
        )
        val type_sym: mut ref parser.Symbol = none
        if base_type != none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, base_type, 0)
            @free(base_type as ref void)
        }
        if type_sym == none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, module_alias, 0)
        }
        if type_sym == none {
            type_sym = resolve_chain_type_symbol(
                doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
            )
        }
        if type_sym != none {
            val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
            val field: ref parser.Symbol = find_sym_by_name(fields, word)
            if field != none {
                val def_uri: ref u8 = parser.path_to_uri(field.file)
                send_definition_location(id_raw, def_uri, field.line, field.col, str.len_raw(field.name))
                if def_uri != none {
                    @free(def_uri as ref void)
                }
                if fields != none {
                    parser.free_sym_list(fields)
                }
                if word != none {
                    @free(word as ref void)
                }
                if file_path != none {
                    @free(file_path as ref void)
                }
                if module_alias != none {
                    @free(module_alias as ref void)
                }
                return
            }
            if fields != none {
                parser.free_sym_list(fields)
            }

            val type_syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
            val method: ref parser.Symbol = find_sym_by_name(type_syms, word)
            if method != none && method.kind == parser.SYM_METHOD &&
            method_receiver_matches(method.receiver, type_sym.name) {
                val def_uri: ref u8 = parser.path_to_uri(method.file)
                send_definition_location(id_raw, def_uri, method.line, method.col, str.len_raw(method.name))
                if def_uri != none {
                    @free(def_uri as ref void)
                }
                if word != none {
                    @free(word as ref void)
                }
                if file_path != none {
                    @free(file_path as ref void)
                }
                if module_alias != none {
                    @free(module_alias as ref void)
                }
                return
            }
        }
    }

    if module_alias == none {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val tsym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
                    if tsym != none &&
                    (tsym.kind == parser.SYM_TYPE || tsym.kind == parser.SYM_ENUM || tsym.kind == parser.SYM_UNION) {
                        val fields: mut ref void = fields_for_type(doc_store, sym_store, tsym)
                        val field: ref parser.Symbol = find_sym_by_name(fields, word)
                        if field != none && field.line == line {
                            val def_uri: ref u8 = parser.path_to_uri(field.file)
                            send_definition_location(id_raw, def_uri, field.line, field.col, str.len_raw(field.name))
                            if def_uri != none {
                                @free(def_uri as ref void)
                            }
                            if fields != none {
                                parser.free_sym_list(fields)
                            }
                            if word != none {
                                @free(word as ref void)
                            }
                            if file_path != none {
                                @free(file_path as ref void)
                            }
                            if module_alias != none {
                                @free(module_alias as ref void)
                            }
                            return
                        }
                        if fields != none {
                            parser.free_sym_list(fields)
                        }
                    }
                }
                i++
            }
        }
    }

    // Parameters are not top-level symbols, so resolve them against the
    // enclosing function before falling back to the symbol table.
    if module_alias == none {
        val param_decl: ref u8 = lookup_parameter_decl(sym_store, uri, line, word)
        if param_decl != none {
            val cur_syms: mut ref void = none
            if coll.StringMap.get(sym_store, uri) is some v {
                cur_syms = @bitcast(v, ref void)
            }
            val fn_sym: ref parser.Symbol = find_enclosing_callable(cur_syms, line)
            if fn_sym != none {
                val pcol: i64 = find_word_col_in_line(content, fn_sym.line, word)
                val def_uri: ref u8 = parser.path_to_uri(fn_sym.file)
                send_definition_location(id_raw, def_uri, fn_sym.line, pcol, str.len_raw(word))
                if def_uri != none {
                    @free(def_uri as ref void)
                }
                if word != none {
                    @free(word as ref void)
                }
                if file_path != none {
                    @free(file_path as ref void)
                }
                if module_alias != none {
                    @free(module_alias as ref void)
                }
                return
            }
        }

        val local_line: mut i64 = -1
        val local_decl: ref u8 = lookup_local_variable_decl(sym_store, uri, content, line, ws, word, @addr(local_line))
        if local_decl != none {
            val lcol: i64 = find_word_col_in_line(content, local_line, word)
            val def_uri: ref u8 = raw_dup_cstr_h(uri)
            send_definition_location(id_raw, def_uri, local_line, lcol, str.len_raw(word))
            if def_uri != none {
                @free(def_uri as ref void)
            }
            @free(local_decl as ref void)
            if word != none {
                @free(word as ref void)
            }
            if file_path != none {
                @free(file_path as ref void)
            }
            if module_alias != none {
                @free(module_alias as ref void)
            }
            return
        }

        val global_line: mut i64 = -1
        val global_decl: ref u8 = lookup_global_variable_decl(content, line, ws, word, @addr(global_line))
        if global_decl != none {
            val gcol: i64 = find_word_col_in_line(content, global_line, word)
            val def_uri: ref u8 = raw_dup_cstr_h(uri)
            send_definition_location(id_raw, def_uri, global_line, gcol, str.len_raw(word))
            if def_uri != none {
                @free(def_uri as ref void)
            }
            @free(global_decl as ref void)
            if word != none {
                @free(word as ref void)
            }
            if file_path != none {
                @free(file_path as ref void)
            }
            if module_alias != none {
                @free(module_alias as ref void)
            }
            return
        }
    }

    val sym: ref parser.Symbol = lookup_symbol(
        doc_store, sym_store, uri, file_path, word, module_alias
    )
    if file_path    != none {
        @free(file_path as ref void)
    }
    if word         != none {
        @free(word as ref void)
    }
    if module_alias != none {
        @free(module_alias as ref void)
    }

    if sym == none {
        send_null_result(id_raw) return
    }

    val def_uri: mut ref u8 = none
    if sym.file != none {
        def_uri = parser.path_to_uri(sym.file)
    } else {
        def_uri = raw_dup_cstr_h(uri)
    }
    if def_uri == none {
        send_null_result(id_raw) return
    }

    val name_len: i64 = str.len_raw(sym.name)
    send_definition_location(id_raw, def_uri, sym.line, sym.col, name_len)
    @free(def_uri as ref void)
}

pub fn handle_document_symbol(
    _: ref void,
    sym_store: ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw) return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        send_null_result(id_raw) return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    if uri == none {
        send_null_result(id_raw) return
    }

    val sym_list: mut ref void = none
    if coll.StringMap.get(sym_store, uri) is some v {
        sym_list = @bitcast(v, ref void)
    }

    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":[")

    if sym_list != none {
        val n: usize = coll.PtrList.len(sym_list)
        val i: mut usize = 0
        val first: mut i64 = 1
        for {
            if i >= n {
                break
            }
            if coll.PtrList.get(sym_list, i) is some v {
                val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
                if sym != none && sym.name != none {
                    if first == 0 {
                        str.StringBuilder.append_cstr(sb, ",")
                    }
                    first = 0
                    val lsp_kind: i64 = sym_kind_to_lsp(sym.kind)
                    val nl: i64 = str.len_raw(sym.name)
                    str.StringBuilder.append_cstr(sb, "{\"name\":\"")
                    sb_escape(sb, sym.name)
                    if sym.receiver != none {
                        str.StringBuilder.append_cstr(sb, " (")
                        sb_escape(sb, sym.receiver)
                        str.StringBuilder.append_cstr(sb, ")")
                    }
                    str.StringBuilder.append_cstr(sb, "\",\"kind\":")
                    sb_append_int(sb, lsp_kind)
                    str.StringBuilder.append_cstr(sb, ",\"range\":")
                    append_range(sb, sym.line, 0, nl + 20)
                    str.StringBuilder.append_cstr(sb, ",\"selectionRange\":")
                    append_range(sb, sym.line, sym.col, sym.col + nl)
                    if sym.doc != none && str.len_raw(sym.doc) > 0 {
                        val dl: ref u8 = first_line_dup(sym.doc)
                        if dl != none {
                            str.StringBuilder.append_cstr(sb, ",\"detail\":\"")
                            sb_escape(sb, dl)
                            str.StringBuilder.append_cstr(sb, "\"")
                            @free(dl as ref void)
                        }
                    }
                    str.StringBuilder.append_cstr(sb, "}")
                }
            }
            i++
        }
    }

    str.StringBuilder.append_cstr(sb, "]}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn handle_signature_help(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw) return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw) return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw) return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw) return
    }

    val ctx_mem: ref void = @alloc(16)
    if ctx_mem == none {
        send_null_result(id_raw) return
    }
    @memset(ctx_mem, 0, 16)
    val ctx: mut ref parser.CallContext = ctx_mem as ref parser.CallContext
    parser.find_active_call(content, line, col, ctx)

    if ctx.fn_name == none {
        @free(ctx_mem)
        send_null_result(id_raw)
        return
    }

    val file_path: ref u8 = parser.uri_to_path(uri)
    val sym: ref parser.Symbol = lookup_symbol(
        doc_store, sym_store, uri, file_path, ctx.fn_name, none
    )
    if file_path != none {
        @free(file_path as ref void)
    }
    val active_param: i64 = ctx.param_idx
    @free(ctx_mem)

    if sym == none {
        send_null_result(id_raw) return
    }

    val sig_label: mut ref u8 = sym.name
    if sym.signature != none {
        sig_label = sym.signature
    }

    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"signatures\":[{\"label\":\"")
    sb_escape(sb, sig_label)
    str.StringBuilder.append_cstr(sb, "\"")

    if sym.doc != none && str.len_raw(sym.doc) > 0 {
        str.StringBuilder.append_cstr(sb, ",\"documentation\":{\"kind\":\"markdown\",\"value\":\"")
        sb_escape(sb, sym.doc)
        str.StringBuilder.append_cstr(sb, "\"}")
    }

    if sym.params != none && sym.param_count > 0 {
        str.StringBuilder.append_cstr(sb, ",\"parameters\":[")
        val n: usize = coll.PtrList.len(sym.params)
        val i: mut usize = 0
        for {
            if i >= n {
                break
            }
            if i > 0 {
                str.StringBuilder.append_cstr(sb, ",")
            }
            match coll.PtrList.get(sym.params, i) {
                some v => {
                    val pstr: ref u8 = @bitcast(v, ref void) as ref u8
                    str.StringBuilder.append_cstr(sb, "{\"label\":\"")
                    sb_escape(sb, pstr)
                    str.StringBuilder.append_cstr(sb, "\"}")
                }
                none => {
                    str.StringBuilder.append_cstr(sb, "{\"label\":\"\"}")
                }
            }
            i++
        }
        str.StringBuilder.append_cstr(sb, "]")
    }

    str.StringBuilder.append_cstr(sb, "}],\"activeSignature\":0,\"activeParameter\":")
    sb_append_int(sb, active_param)
    str.StringBuilder.append_cstr(sb, "}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)
}

pub fn update_document(
    doc_store: ref void,
    sym_store: ref void,
    uri: ref u8,
    text: ref u8
) void = trust {
    if uri == none || text == none {
        return
    }
    val text_copy: ref u8 = raw_dup_cstr_h(text)
    if text_copy == none {
        return
    }

    if coll.StringMap.get(doc_store, uri) is some old_v {
        val old: ref u8 = @bitcast(old_v, ref void) as ref u8
        if old != none {
            @free(old as ref void)
        }
    }

    val alloc: allocators.HeapAllocator = @zeroed

    val tv: usize = @bitcast(text_copy as ref void, usize)
    coll.StringMap.set[allocators.HeapAllocator](alloc, doc_store, uri, tv)

    if coll.StringMap.get(sym_store, uri) is some old_v {
        val old_syms: mut ref void = @bitcast(old_v, ref void)
        if old_syms != none {
            parser.free_sym_list(old_syms)
        }
    }

    val file_path: ref u8 = parser.uri_to_path(uri)
    val syms: ref void = parser.parse_file(file_path, text_copy)
    if file_path != none {
        @free(file_path as ref void)
    }

    if syms != none {
        val sv: usize = @bitcast(syms, usize)
        coll.StringMap.set[_](alloc, sym_store, uri, sv)
    }
}

pub fn handle_did_open(
    doc_store: mut ref void,
    sym_store: mut ref void,
    params: ref void
) void = trust {
    if params == none {
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val text: ref u8 = get_str_field(td_obj, "text")
    if uri == none || text == none {
        return
    }
    update_document(doc_store, sym_store, uri, text)
}

pub fn handle_did_change(
    doc_store: mut ref void,
    sym_store: mut ref void,
    params: ref void
) void = trust {
    if params == none {
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    if uri == none {
        return
    }

    val changes: mut ref void = none
    if json.obj_get(params, "contentChanges") is some v {
        if json.val_is_array(v) {
            changes = v
        }
    }
    if changes == none {
        return
    }

    val last_idx: usize = json.arr_len(changes)
    if last_idx == 0 {
        return
    }
    if json.arr_get(changes, last_idx - 1) is some ch {
        val text: ref u8 = get_str_field(ch, "text")
        if text != none {
            update_document(doc_store, sym_store, uri, text)
        }
    }
}

pub fn dispatch(
    doc_store: mut ref void,
    sym_store: mut ref void,
    msg: ref u8
) void = trust {
    val doc_opt = json.parse(msg)
    match doc_opt {
        none => {
            return
        }
        some doc => {
            val root: ref void = json.doc_root(doc)

            val method: mut ref u8 = none
            match json.obj_get_str(root, "method") {
                some m => {
                    method = m
                }
                none => {
                    json.doc_free(doc) return
                }
            }

            val id_raw: mut ref void = none
            if json.obj_get(root, "id") is some v {
                id_raw = v
            }

            val params: mut ref void = none
            if json.obj_get(root, "params") is some p {
                params = p
            }

            val mlen: i64 = str.len_raw(method)

            if mlen == 10 && starts_with_h(method, mlen, "initialize", 10) {
                handle_initialize(id_raw)
            } elif mlen == 18 && starts_with_h(method, mlen, "textDocument/hover", 18) {
                handle_hover(doc_store, sym_store, id_raw, params)
            } elif mlen == 23 && starts_with_h(method, mlen, "textDocument/completion", 23) {
                handle_completion(doc_store, sym_store, id_raw, params)
            } elif mlen == 23 && starts_with_h(method, mlen, "textDocument/definition", 23) {
                handle_definition(doc_store, sym_store, id_raw, params)
            } elif mlen == 27 && starts_with_h(method, mlen, "textDocument/documentSymbol", 27) {
                handle_document_symbol(doc_store, sym_store, id_raw, params)
            } elif mlen == 26 && starts_with_h(method, mlen, "textDocument/signatureHelp", 26) {
                handle_signature_help(doc_store, sym_store, id_raw, params)
            } elif mlen == 20 && starts_with_h(method, mlen, "textDocument/didOpen", 20) {
                handle_did_open(doc_store, sym_store, params)
            } elif mlen == 22 && starts_with_h(method, mlen, "textDocument/didChange", 22) {
                handle_did_change(doc_store, sym_store, params)
            } elif mlen == 8 && starts_with_h(method, mlen, "shutdown", 8) {
                send_null_result(id_raw)
            }

            json.doc_free(doc)
        }
    }
}

fn base_names_type(base: ref u8, type_name: ref u8) bool = trust {
    if base == none || type_name == none {
        return false
    }
    val blen: i64 = str.len_raw(base)
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= blen {
            break
        }
        if @load8(@ptradd(base, i)) == '.' {
            last_dot = i
        }
        i = i + 1
    }
    val start: i64 = last_dot + 1
    val seg_len: i64 = blen - start
    return seg_len == str.len_raw(type_name) &&
    strncmp(@ptradd(base, start), type_name, seg_len as usize) == 0
}

fn append_keyword_completions(
    sb: str.StringBuilder,
    first: ref i64,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    val i: mut i64 = 0
    for {
        if i >= 64 {
            break
        }
        val kw: ref u8 = keyword_at(i)
        if kw == none {
            break
        }
        if prefix_matches_h(kw, prefix) {
            append_completion_item(
                sb, first, kw, keyword_signature(kw), keyword_description(kw),
                14, replace_line, replace_start, replace_end
            )
        }
        i = i + 1
    }
}

pub fn handle_completion(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw)
        return
    }
    val file_path: ref u8 = parser.uri_to_path(uri)

    val start: mut i64 = -1
    val end: mut i64 = -1
    val has_dot: mut i64 = 0
    val base_start: mut i64 = -1
    val base_len: mut i64 = 0
    find_completion_context(
        content, line, col,
        @addr(start), @addr(end), @addr(has_dot), @addr(base_start), @addr(base_len)
    )
    if start < 0 || end < start {
        send_null_result(id_raw)
        return
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    val replace_start: i64 = start - ls
    val replace_end: i64 = end - ls

    val prefix: mut ref u8 = none
    if end > start {
        prefix = raw_dup_h(@ptradd(content, start), end - start)
    }
    val base: mut ref u8 = none
    if has_dot == 1 && base_start >= 0 && base_len > 0 {
        base = raw_dup_h(@ptradd(content, base_start), base_len)
    }

    val sb: str.StringBuilder = str.StringBuilder.new()
    make_base(sb, id_raw)
    str.StringBuilder.append_cstr(sb, ",\"result\":{\"isIncomplete\":false,\"items\":[")
    val first: mut i64 = 1

    if has_dot == 1 && base != none {
        val handled: mut bool = false
        val base_has_dot: bool = contains_substr_h(base, ".")

        if !base_has_dot {
            val mod_syms: ref void = module_syms_for_alias(doc_store, sym_store, uri, file_path, base)
            if mod_syms != none {
                handled = true
                val n: usize = coll.PtrList.len(mod_syms)
                val mi: mut usize = 0
                for {
                    if mi >= n {
                        break
                    }
                    if coll.PtrList.get(mod_syms, mi) is some v {
                        val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
                        append_symbol_completion(sb, @addr(first), sym, prefix, line, replace_start, replace_end)
                    }
                    mi++
                }
            }
        }

        if !handled {
            val type_sym: mut ref parser.Symbol = resolve_type_symbol(
                doc_store, sym_store, uri, file_path, base, 0
            )
            if type_sym == none {
                type_sym = resolve_chain_type_symbol(
                    doc_store, sym_store, uri, file_path, content, line, start, base, 0
                )
            }
            if type_sym != none {
                handled = true
                if !base_names_type(base, type_sym.name) {
                    append_field_completions(
                        sb, @addr(first), doc_store, sym_store, type_sym, prefix,
                        line, replace_start, replace_end
                    )
                }
                append_method_completions(
                    sb, @addr(first), sym_store, doc_store, type_sym, prefix,
                    line, replace_start, replace_end
                )
            }
        }
    } else {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val sym: ref parser.Symbol = @bitcast(v, ref void) as ref parser.Symbol
                    append_symbol_completion(sb, @addr(first), sym, prefix, line, replace_start, replace_end)
                }
                i++
            }
        }
        append_keyword_completions(sb, @addr(first), prefix, line, replace_start, replace_end)
    }

    str.StringBuilder.append_cstr(sb, "]}}")
    val built: mut str.String = str.StringBuilder.build(sb)
    write_response(str.cstr(built))
    str.string_free(built)
    str.StringBuilder.free(sb)

    if prefix != none {
        @free(prefix as ref void)
    }
    if base != none {
        @free(base as ref void)
    }
    if file_path != none {
        @free(file_path as ref void)
    }
}
