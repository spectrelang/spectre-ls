    }
    return none
}

fn append_keyword_hover_contents(sb: builder.StringBuilder, word: ref u8) void = trust {
    builder.StringBuilder.append(sb, "```spectre\\n")
    sb_escape_cstr(sb, keyword_signature(str.from_cstr(word)))
    builder.StringBuilder.append(sb, "\\n```\\n\\n")
    sb_escape_cstr(sb, keyword_description(str.from_cstr(word)))
}

pub fn intrinsic_signature(word: str.StringView) ref u8 = trust {
    if str.is_empty(word) {
        return none
    }
    if str.eql(word, "fmtalloc") {
        return c"@fmtalloc(format: ref u8, args: untyped) ref u8"
    }
    if str.eql(word, "len") {
        return c"@len(list: list[T]) usize"
    }
    if str.eql(word, "addr") {
        return c"@addr(value: T) ref T"
    }
    if str.eql(word, "deref") {
        return c"@deref(ptr: ref T) T"
    }
    if str.eql(word, "alloc") {
        return c"@alloc(size: usize) ref void"
    }
    if str.eql(word, "free") {
        return c"@free(ptr: ref void) void"
    }
    if str.eql(word, "memcpy") {
        return c"@memcpy(dst: ref void, src: ref void, n: usize) void"
    }
    if str.eql(word, "memset") {
        return c"@memset(dst: ref void, value: u8, n: usize) void"
    }
    if str.eql(word, "memmove") {
        return c"@memmove(dst: ref void, src: ref void, n: usize) void"
    }
    if str.eql(word, "puts") {
        return c"@puts(s: ref u8) i32"
    }
    if str.eql(word, "print") {
        return c"@print(format: ref u8, args: untyped) i32"
    }
    if str.eql(word, "zeroed") {
        return c"@zeroed  |  @zeroed()"
    }
    if str.eql(word, "args") {
        return c"@args() list[ref u8]"
    }
    if str.eql(word, "bitcast") {
        return c"@bitcast(value: T, TargetType) TargetType"
    }
    if str.eql(word, "load") {
        return c"@load(ptr: ref T) T"
    }
    if str.eql(word, "load8") {
        return c"@load8(ptr: ref u8) u8"
    }
    if str.eql(word, "call") {
        return c"@call(fn: ref fn, args: untyped) T"
    }
    if str.eql(word, "snprintf") {
        return c"@snprintf(buf: ref u8, size: usize, format: ref u8, args: untyped) i32"
    }
    if str.eql(word, "dprintf") {
        return c"@dprintf(fd: i32, format: ref u8, args: untyped) i32"
    }
    if str.eql(word, "reserve") {
        return c"@reserve(list: list[T], capacity: usize) void"
    }
    if str.eql(word, "get") {
        return c"@get(container: list[T], index: usize) option[T]"
    }
    if str.eql(word, "insert") {
        return c"@insert(list: list[T], index: usize, value: T) void"
    }
    if str.eql(word, "capacity") {
        return c"@capacity(list: list[T]) usize"
    }
    if str.eql(word, "ptradd") {
        return c"@ptradd(ptr: ref T, offset: i64) ref T"
    }
    if str.eql(word, "store") {
        return c"@store(ptr: ref T, value: T) void"
    }
    if str.eql(word, "store8") {
        return c"@store8(ptr: ref u8, value: u8) void"
    }
    if str.eql(word, "staticerror") {
        return c"@staticerror(message: ref u8) void"
    }
    if str.eql(word, "flush") {
        return c"@flush() void"
    }
    if str.eql(word, "stdin") {
        return c"@stdin() ref void"
    }
    if str.eql(word, "stdout") {
        return c"@stdout() ref void"
    }
    if str.eql(word, "fgets") {
        return c"@fgets(buf: ref u8, size: i32, stream: ref void) ref u8"
    }
    if str.eql(word, "atoi") {
        return c"@atoi(s: ref u8) i64"
    }
    if str.eql(word, "itoa") {
        return c"@itoa(value: i64) ref u8"
    }
    return none
}

pub fn intrinsic_description(word: str.StringView) ref u8 = trust {
    if str.is_empty(word) {
        return none
    }
    if str.eql(word, "fmtalloc") {
        return c"Formats a string and returns it as a newly heap-allocated `ref u8`. Takes a format string and an untyped argument pack. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "len") {
        return c"Returns the number of elements in a `list[T]`."
    }
    if str.eql(word, "addr") {
        return c"Returns the address of a value as a pointer. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "deref") {
        return c"Dereferences a pointer and returns the value it points to. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "alloc") {
        return c"Allocates `size` bytes of heap memory and returns an untyped pointer. Cast the result to the required pointer type."
    }
    if str.eql(word, "free") {
        return c"Frees memory previously returned by `@alloc` or `@realloc`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "memcpy") {
        return c"Copies `n` bytes from `src` to `dst`. The regions must not overlap; use `@memmove` for overlapping memory. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "memset") {
        return c"Fills `n` bytes starting at `dst` with `value`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "memmove") {
        return c"Copies `n` bytes from `src` to `dst`, safely handling overlapping memory. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "puts") {
        return c"Writes a null-terminated string to stdout followed by a newline."
    }
    if str.eql(word, "print") {
        return c"Prints a formatted string to stdout. Takes a format string and an untyped argument pack. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "zeroed") {
        return c"Creates a zero-initialized value of the expected type. Useful for structs and fixed-size arrays; the type is inferred from context."
    }
    if str.eql(word, "args") {
        return c"Returns the command-line arguments as a `list[ref u8]`."
    }
    if str.eql(word, "bitcast") {
        return c"Reinterprets `value` as `TargetType` without conversion. Syntax: `@bitcast(value, TargetType)`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "load") {
        return c"Loads a word (pointer-sized value) from `ptr`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "load8") {
        return c"Loads a single byte from `ptr` and zero-extends it. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "call") {
        return c"Calls the function pointer `fn` with the supplied arguments. This intrinsic is variadic and returns the function's return type."
    }
    if str.eql(word, "snprintf") {
        return c"Formats output into `buf` with a maximum size of `size` bytes, like C `snprintf`. Returns the number of characters that would have been written."
    }
    if str.eql(word, "dprintf") {
        return c"Writes formatted output to the file descriptor `fd`, like C `dprintf`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "reserve") {
        return c"Reserves capacity for at least `capacity` elements in a `list[T]`."
    }
    if str.eql(word, "get") {
        return c"Returns `some value` when `index` is in bounds, otherwise `none`. Also supports indexing into fixed-size arrays. Returns `option[T]`."
    }
    if str.eql(word, "insert") {
        return c"Inserts `value` at `index` in a `list[T]`, shifting later elements."
    }
    if str.eql(word, "capacity") {
        return c"Returns the current capacity of a `list[T]`."
    }
    if str.eql(word, "ptradd") {
        return c"Adds a byte `offset` to a pointer and returns the resulting pointer. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "store") {
        return c"Stores a word (pointer-sized value) at `ptr`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "store8") {
        return c"Stores a single byte at `ptr`. This is an unsafe intrinsic and must be used in a `trust` context."
    }
    if str.eql(word, "staticerror") {
        return c"Triggers a compile-time error with the given message. Typically used inside `when` blocks; elsewhere it is a no-op."
    }
    if str.eql(word, "flush") {
        return c"Flushes stdout."
    }
    if str.eql(word, "stdin") {
        return c"Returns the standard input stream."
    }
    if str.eql(word, "stdout") {
        return c"Returns the standard output stream."
    }
    if str.eql(word, "fgets") {
        return c"Reads at most `size - 1` bytes from `stream` into `buf`, like C `fgets`. Returns `buf`, or `none` on EOF/error."
    }
    if str.eql(word, "atoi") {
        return c"Converts a null-terminated ASCII string to an integer."
    }
    if str.eql(word, "itoa") {
        return c"Converts an integer to its ASCII string representation."
    }
    return none
}

pub fn is_intrinsic_word(word: str.StringView) bool = trust {
    return intrinsic_signature(word) != none
}

fn append_intrinsic_hover_contents(sb: builder.StringBuilder, word: ref u8) void = trust {
    builder.StringBuilder.append(sb, "```spectre\\n")
    sb_escape_cstr(sb, intrinsic_signature(str.from_cstr(word)))
    builder.StringBuilder.append(sb, "\\n```\\n\\n")
    sb_escape_cstr(sb, intrinsic_description(str.from_cstr(word)))
}

fn strip_type_wrappers(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = cstr.len(s)
    val i: mut i64 = skip_ws_h(s, 0, len)
    for {
        if i >= len {
            break
        }
        if starts_with_h(str.view(@ptradd(s, i), len - i), "mut ") {
            i = skip_ws_h(s, i + 4, len)
        } elif starts_with_h(str.view(@ptradd(s, i), len - i), "ref ") {
            i = skip_ws_h(s, i + 4, len)
        } elif starts_with_h(str.view(@ptradd(s, i), len - i), "const ") {
            i = skip_ws_h(s, i + 6, len)
        } else {
            break
        }
    }
    val out_len: i64 = trim_right_len_h(@ptradd(s, i), len - i)
    if out_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(s, i), out_len)
}

fn find_equals_h(s: ref u8, len: i64) i64 = trust {
    val sq: mut i64 = 0
    val paren: mut i64 = 0
    val brace: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == '[' {
            sq++
        } elif c == ']' {
            if sq > 0 {
                sq--
            }
        } elif c == '(' {
            paren++
        } elif c == ')' {
            if paren > 0 {
                paren--
            }
        } elif c == '{' {
            brace++
        } elif c == '}' {
            if brace > 0 {
                brace--
            }
        } elif c == '=' && sq == 0 && paren == 0 && brace == 0 {
            return i
        }
        i++
    }
    return -1
}

/// Extract the explicit type from a `val name: Type = ...` declaration.
pub fn decl_explicit_type(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = cstr.len(decl)
    val i: mut i64 = skip_ws_h(decl, 0, len)
    if i >= len {
        return none
    }
    if starts_with_h(str.view(@ptradd(decl, i), len - i), "pub ") {
        i = skip_ws_h(decl, i + 4, len)
    }
    if !starts_with_h(str.view(@ptradd(decl, i), len - i), "val ") {
        return none
    }
    i = skip_ws_h(decl, i + 4, len)
    val name_len: i64 = ident_len_h(decl, i, len)
    if name_len <= 0 {
        return none
    }
    i = skip_ws_h(decl, i + name_len, len)
    if i >= len || @load8(@ptradd(decl, i)) != ':' {
        return none
    }
    i = skip_ws_h(decl, i + 1, len)
    val type_start: i64 = i
    val eq: i64 = find_equals_h(@ptradd(decl, type_start), len - type_start)
    val type_end: mut i64 = len
    if eq >= 0 {
        type_end = type_start + eq
    }
    val type_len: i64 = trim_right_len_h(@ptradd(decl, type_start), type_end - type_start)
    if type_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, type_start), type_len)
}

pub fn decl_initializer(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = cstr.len(decl)
    val eq: i64 = find_equals_h(decl, len)
    if eq < 0 {
        return none
    }
    val start: i64 = skip_ws_h(decl, eq + 1, len)
    val out_len: i64 = trim_right_len_h(@ptradd(decl, start), len - start)
    if out_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, start), out_len)
}

pub fn extract_param_type(decl: ref u8) ref u8 = trust {
    if decl == none {
        return none
    }
    val len: i64 = cstr.len(decl)
    val i: mut i64 = skip_ws_h(decl, 0, len)
    val name_len: i64 = ident_len_h(decl, i, len)
    if name_len <= 0 {
        return none
    }
    i = skip_ws_h(decl, i + name_len, len)
    if i >= len || @load8(@ptradd(decl, i)) != ':' {
        return none
    }
    i = skip_ws_h(decl, i + 1, len)
    val type_len: i64 = trim_right_len_h(@ptradd(decl, i), len - i)
    if type_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(decl, i), type_len)
}

fn find_last_substr_h(s: str.StringView, needle: str.StringView) i64 = trust {
    if str.is_empty(needle) || needle.len > s.len {
        return -1
    }
    val best: mut i64 = -1
    val limit: i64 = s.len - needle.len
    val i: mut i64 = 0
    for {
        if i > limit {
            break
        }
        if str.eql(str.slice(s, i, i + needle.len), needle) {
            best = i
        }
        i++
    }
    return best
}

/// Best-effort type-name inference from an initializer expression.
/// For `X.new()` this returns `X`, for `mod.Type.new()` it returns
/// `mod.Type`, and for a plain identifier it returns that identifier so the
/// caller can follow the referenced variable/function.
pub fn infer_expr_type_name(expr: ref u8) ref u8 = trust {
    if expr == none {
        return none
    }
    val raw_len: i64 = cstr.len(expr)
    val i: i64 = skip_ws_h(expr, 0, raw_len)
    val expr_len: i64 = trim_right_len_h(@ptradd(expr, i), raw_len - i)
    if expr_len <= 0 {
        return none
    }
    val s: ref u8 = @ptradd(expr, i)

    val stripped: mut ref u8 = raw_dup_h(s, expr_len)
    if stripped == none {
        return none
    }
    for {
        val slen: i64 = cstr.len(stripped)
        val si: i64 = skip_ws_h(stripped, 0, slen)
        if starts_with_h(str.view(@ptradd(stripped, si), slen - si), "trust ") {
            val next: ref u8 = raw_dup_h(
                @ptradd(stripped, skip_ws_h(stripped, si + 6, slen)),
                trim_right_len_h(
                    @ptradd(stripped, skip_ws_h(stripped, si + 6, slen)),
                    slen - skip_ws_h(stripped, si + 6, slen)
                )
            )
            @free(stripped)
            stripped = next
        } elif starts_with_h(str.view(@ptradd(stripped, si), slen - si), "some ") {
            val ns: i64 = skip_ws_h(stripped, si + 5, slen)
            val next: ref u8 = raw_dup_h(
                @ptradd(stripped, ns),
                trim_right_len_h(@ptradd(stripped, ns), slen - ns)
            )
            @free(stripped)
            stripped = next
        } elif starts_with_h(str.view(@ptradd(stripped, si), slen - si), "ok ") {
            val ns: i64 = skip_ws_h(stripped, si + 3, slen)
            val next: ref u8 = raw_dup_h(
                @ptradd(stripped, ns),
                trim_right_len_h(@ptradd(stripped, ns), slen - ns)
            )
            @free(stripped)
            stripped = next
        } else {
            break
        }
        if stripped == none {
            return none
        }
    }

    val len: i64 = cstr.len(stripped)
    val start: i64 = skip_ws_h(stripped, 0, len)
    if start >= len {
        @free(stripped)
        return none
    }

    // A cast at the end is often the clearest type information.
    val as_idx: i64 = find_last_substr_h(str.from_cstr(stripped), " as ")
    val first: u8 = @load8(@ptradd(stripped, start))
    if first == '@' || first == '(' || first == '[' {
        if as_idx >= 0 {
            val ts: i64 = skip_ws_h(stripped, as_idx + 4, len)
            val tl: i64 = trim_right_len_h(@ptradd(stripped, ts), len - ts)
            val out: ref u8 = raw_dup_h(@ptradd(stripped, ts), tl)
            @free(stripped)
            return out
        }
        @free(stripped)
        return none
    }

    if first == '\"' || first == '\'' || (first >= '0' && first <= '9') {
        @free(stripped)
        return none
    }
    if !is_ident_start_h(first) {
        @free(stripped)
        return none
    }

    val chain_start: i64 = start
    val chain_end: mut i64 = start
    for {
        if chain_end >= len {
            break
        }
        val c: u8 = @load8(@ptradd(stripped, chain_end))
        if is_ident_cont_h(c) || c == '.' {
            chain_end++
        } else {
            break
        }
    }
    if chain_end <= chain_start {
        @free(stripped)
        return none
    }
    val out: ref u8 = raw_dup_h(@ptradd(stripped, chain_start), chain_end - chain_start)
    @free(stripped)
    return out
}

fn resolve_type_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    type_expr: ref u8,
    depth: i64
) ref lsp_parser.Symbol = trust {
    if type_expr == none || depth > 8 {
        return none
    }
    val expr: mut ref u8 = strip_type_wrappers(type_expr)
    if expr == none {
        return none
    }

    val len: i64 = cstr.len(expr)
    val bracket: mut i64 = -1
    val bi: mut i64 = 0
    for {
        if bi >= len {
            break
        }
        if @load8(@ptradd(expr, bi)) == '[' {
            bracket = bi
            break
        }
        bi++
    }
    if bracket > 0 {
        val base: ref u8 = raw_dup_h(expr, bracket)
        @free(expr)
        expr = base
        if expr == none {
            return none
        }
    }

    val elen: i64 = cstr.len(expr)
    val last_dot: mut i64 = -1
    val di: mut i64 = 0
    for {
        if di >= elen {
            break
        }
        if @load8(@ptradd(expr, di)) == '.' {
            last_dot = di
        }
        di++
    }

    val cur_syms: mut ref void = none
    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
    }

    val sym: mut ref lsp_parser.Symbol = none
    if last_dot > 0 && last_dot + 1 < elen {
        val alias: ref u8 = raw_dup_h(expr, last_dot)
        val name: ref u8 = raw_dup_h(@ptradd(expr, last_dot + 1), elen - last_dot - 1)
        sym = lookup_symbol(doc_store, sym_store, current_uri, current_file, name, alias)
        if name != none {
            @free(name)
        }
        if alias != none {
            @free(alias)
        }
    } else {
        sym = find_sym_by_name(cur_syms, expr)
    }

    if sym != none {
        if sym.kind == lsp_parser.SYM_TYPE || sym.kind == lsp_parser.SYM_ENUM || sym.kind == lsp_parser.SYM_UNION {
            @free(expr)
            return sym
        }
        if sym.ret_type != none && sym.ret_type != type_expr {
            val sym_file: ref u8 = sym.file
            val sym_uri: mut ref u8 = none
            val follow_file: mut ref u8 = current_file
            if sym_file != none {
                follow_file = sym_file
                sym_uri = lsp_parser.path_to_uri(sym_file)
            } else {
                sym_uri = raw_dup_cstr_h(current_uri)
            }
            val followed: ref lsp_parser.Symbol = resolve_type_symbol(
                doc_store, sym_store, sym_uri, follow_file, sym.ret_type, depth + 1
            )
            if sym_uri != none {
                @free(sym_uri)
            }
            if followed != none {
                @free(expr)
                return followed
            }
        }
    }

    if last_dot > 0 {
        val base: ref u8 = raw_dup_h(expr, last_dot)
        val followed: ref lsp_parser.Symbol = resolve_type_symbol(
            doc_store, sym_store, current_uri, current_file, base, depth + 1
        )
        if base != none {
            @free(base)
        }
        if followed != none {
            @free(expr)
            return followed
        }
    }

    @free(expr)
    return none
}

fn lookup_variable_type_expr(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    content: ref u8,
    line: i64,
    cursor_off: i64,
    name: ref u8,
    depth: i64
) ref u8 = trust {
    if name == none || depth > 8 {
        return none
    }

    val param_decl: ref u8 = lookup_parameter_decl(sym_store, current_uri, line, name)
    if param_decl != none {
        val pt: ref u8 = extract_param_type(param_decl)
        if pt != none {
            return pt
        }
    }

    val local_line: mut i64 = -1
    val local_decl: ref u8 = lookup_local_variable_decl(
        sym_store, current_uri, content, line, cursor_off, name, @addr(local_line)
    )
    if local_decl != none {
        val lt: ref u8 = decl_explicit_type(local_decl)
        if lt != none {
            @free(local_decl)
            return lt
        }
        val init: ref u8 = decl_initializer(local_decl)
        @free(local_decl)
        if init != none {
            val inferred: ref u8 = infer_expr_type_name(init)
            @free(init)
            return inferred
        }
        return none
    }

    val global_line: mut i64 = -1
    val global_decl: ref u8 = lookup_global_variable_decl(
        content,
        line,
        cursor_off,
        name,
        @addr(global_line)
    )
    if global_decl != none {
        val gt: ref u8 = decl_explicit_type(global_decl)
        if gt != none {
            @free(global_decl)
            return gt
        }
        val ginit: ref u8 = decl_initializer(global_decl)
        @free(global_decl)
        if ginit != none {
            val ginferred: ref u8 = infer_expr_type_name(ginit)
            @free(ginit)
            return ginferred
        }
    }

    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            val cur_syms: ref void = @bitcast(v, ref void)
            val sym: ref lsp_parser.Symbol = find_sym_by_name(cur_syms, name)
            if sym != none && sym.ret_type != none {
                val followed: ref lsp_parser.Symbol = resolve_type_symbol(
                    doc_store, sym_store, current_uri, current_file, sym.ret_type, depth + 1
                )
                if followed != none {
                    return raw_dup_cstr_h(sym.ret_type)
                }
            }
        }
    }
    return none
}

fn fields_for_type(
    doc_store: mut ref void,
    sym_store: mut ref void,
    type_sym: ref lsp_parser.Symbol
) ref void = trust {
    if type_sym == none || type_sym.file == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, type_sym.file)
    val content: ref u8 = get_content_for_file(doc_store, type_sym.file)
    if content == none {
        return none
    }
    return lsp_parser.parse_type_fields(content, type_sym.file, type_sym.line)
}

fn method_receiver_matches(receiver: ref u8, type_name: ref u8) bool = trust {
    if receiver == none || type_name == none {
        return false
    }
    val rlen: i64 = cstr.len(receiver)
    val ti: i64 = skip_ws_h(receiver, 0, rlen)
    val tl: i64 = trim_right_len_h(@ptradd(receiver, ti), rlen - ti)
    if tl <= 0 {
        return false
    }
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= tl {
            break
        }
        if @load8(@ptradd(receiver, ti + i)) == '.' {
            last_dot = i
        }
        i++
    }
    val start: i64 = ti + last_dot + 1
    val name_len: i64 = tl - last_dot - 1
    return name_len == cstr.len(type_name) &&
    strncmp(@ptradd(receiver, start), type_name, name_len as usize) == 0
}

fn sym_list_for_file(
    sym_store: mut ref void,
    doc_store: mut ref void,
    file: ref u8
) ref void = trust {
    if file == none {
        return none
    }
    val uri: ref u8 = lsp_parser.path_to_uri(file)
    if uri == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, file)
    val result: mut ref void = none
    if coll.StringMap.get(sym_store, uri) is some v {
        result = @bitcast(v, ref void)
    }
    @free(uri)
    return result
}

fn line_bounds_for_line_h(
    content: ref u8,
    target_line: i64,
    out_start: ref i64,
    out_end: ref i64
) void = trust {
    @store(out_start, -1 as i64)
    @store(out_end, -1 as i64)
    if content == none || target_line < 0 {
        return
    }

    val len: i64 = cstr.len(content)
    val line_num: mut i64 = 0
    val i: mut i64 = 0
    val start: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if line_num == target_line {
            start = i
            break
        }
        if @load8(@ptradd(content, i)) == '\n' {
            line_num++
        }
        i++
    }
    if target_line > 0 && line_num != target_line {
        return
    }

    val end: mut i64 = start
    for {
        if end >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, end))
        if c == '\n' || c == '\r' {
            break
        }
        end++
    }
    @store(out_start, start)
    @store(out_end, end)
}

fn line_matches_variable_decl(line: ref u8, line_len: i64, word: ref u8) bool = trust {
    if line == none || word == none || line_len <= 0 {
        return false
    }
    val wlen: i64 = cstr.len(word)
    val i: mut i64 = skip_ws_h(line, 0, line_len)
    if i >= line_len {
        return false
    }
    if starts_with_h(str.view(@ptradd(line, i), line_len - i), "pub ") {
        i = skip_ws_h(line, i + 4, line_len)
    }

    if starts_with_h(str.view(@ptradd(line, i), line_len - i), "val ") {
        i = skip_ws_h(line, i + 4, line_len)
        val name_len: i64 = ident_len_h(line, i, line_len)
        if name_len != wlen || name_len <= 0 {
            return false
        }
        if strncmp(@ptradd(line, i), word, name_len as usize) != 0 {
            return false
        }
        i = skip_ws_h(line, i + name_len, line_len)
        if starts_with_h(str.view(@ptradd(line, i), line_len - i), "= use(\"") {
            return false
        }
        return true
    }

    if starts_with_h(str.view(@ptradd(line, i), line_len - i), "for ") {
        i = skip_ws_h(line, i + 4, line_len)
        val name_len: i64 = ident_len_h(line, i, line_len)
        if name_len != wlen || name_len <= 0 {
            return false
        }
        if strncmp(@ptradd(line, i), word, name_len as usize) != 0 {
            return false
        }
        i = skip_ws_h(line, i + name_len, line_len)
        if starts_with_h(str.view(@ptradd(line, i), line_len - i), "in") {
            val next_ok: bool = (i + 2 >= line_len) || !is_ident_cont_h(@load8(@ptradd(
                        line,
                        i + 2
                    )))
            return next_ok
        }
    }
    return false
}

fn lookup_local_variable_decl(
    sym_store: ref void,
    current_uri: ref u8,
    content: ref u8,
    line: i64,
    _: i64,
    word: ref u8,
    out_line: ref i64
) ref u8 = trust {
    @store(out_line, -1 as i64)
    if current_uri == none || content == none || word == none {
        return none
    }

    val cur_syms: mut ref void = none
    if coll.StringMap.get(sym_store, current_uri) is some v {
        cur_syms = @bitcast(v, ref void)
    }
    if cur_syms == none {
        return none
    }

    val fn_sym: ref lsp_parser.Symbol = find_enclosing_callable(cur_syms, line)
    if fn_sym == none {
        return none
    }

    val slot_count: i64 = 64
    val line_slots: ref void = @alloc(slot_count * 8)
    val start_slots: ref void = @alloc(slot_count * 8)
    val end_slots: ref void = @alloc(slot_count * 8)
    if line_slots == none || start_slots == none || end_slots == none {
        if line_slots != none {
            @free(line_slots)
        }
        if start_slots != none {
            @free(start_slots)
        }
        if end_slots != none {
            @free(end_slots)
        }
        return none
    }
    @memset(line_slots, 255, slot_count * 8)
    @memset(start_slots, 255, slot_count * 8)
    @memset(end_slots, 255, slot_count * 8)

    val depth: mut i64 = 0
    val cur_line: mut i64 = fn_sym.line
    for {
        if cur_line > line {
            break
        }
        val ls: mut i64 = -1
        val le: mut i64 = -1
        line_bounds_for_line_h(content, cur_line, @addr(ls), @addr(le))
        if ls < 0 || le < ls {
            break
        }

        val scan_end: i64 = le
        val scan_len: i64 = scan_end - ls

        if cur_line >= fn_sym.line && scan_len > 0 &&
        line_matches_variable_decl(@ptradd(content, ls), scan_len, word) &&
        depth >= 0 && depth < slot_count {
            @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, cur_line)
            @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, ls)
            @store(
                @ptradd(end_slots as ref u8, depth * 8) as ref void,
                ls + trim_right_len_h(@ptradd(content, ls), scan_len)
            )
        }

        val i: mut i64 = ls
        for {
            if i >= scan_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, i))
            if c == '{' {
                if depth + 1 < slot_count {
                    depth++
                    @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(end_slots as ref u8, depth * 8) as ref void, -1 as i64)
                }
            } elif c == '}' {
                if depth >= 0 && depth < slot_count {
                    @store(@ptradd(line_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(start_slots as ref u8, depth * 8) as ref void, -1 as i64)
                    @store(@ptradd(end_slots as ref u8, depth * 8) as ref void, -1 as i64)
                }
                if depth > 0 {
                    depth--
                }
            }
            i++
        }

        cur_line++
    }

    val best_depth: mut i64 = depth
    val result: mut ref u8 = none
    for {
        if best_depth < 0 {
            break
        }
        val decl_line: i64 = @load(@ptradd(line_slots as ref u8, best_depth * 8) as ref void) as i64
        if decl_line >= 0 {
            val start_off: i64 = @load(@ptradd(
                    start_slots as ref u8,
                    best_depth * 8
                ) as ref void) as i64
            val end_off: i64 = @load(@ptradd(
                    end_slots as ref u8,
                    best_depth * 8
                ) as ref void) as i64
            if start_off >= 0 && end_off > start_off {
                result = trim_left_dup_h(@ptradd(content, start_off), end_off - start_off)
                @store(out_line, decl_line)
            }
            break
        }
        best_depth--
    }

    @free(line_slots)
    @free(start_slots)
    @free(end_slots)
    return result
}

fn lookup_global_variable_decl(
    content: ref u8,
    line: i64,
    _: i64,
    word: ref u8,
    out_line: ref i64
) ref u8 = trust {
    @store(out_line, -1 as i64)
    if content == none || word == none {
        return none
    }

    val best_start: mut i64 = -1
    val best_end: mut i64 = -1
    val best_line: mut i64 = -1
    val depth: mut i64 = 0
    val cur_line: mut i64 = 0
    for {
        if cur_line > line {
            break
        }
        val ls: mut i64 = -1
        val le: mut i64 = -1
        line_bounds_for_line_h(content, cur_line, @addr(ls), @addr(le))
        if ls < 0 || le < ls {
            break
        }

        val scan_end: i64 = le
        val scan_len: i64 = scan_end - ls

        if depth == 0 && scan_len > 0 &&
        line_matches_variable_decl(@ptradd(content, ls), scan_len, word) {
            best_start = ls
            best_end = ls + trim_right_len_h(@ptradd(content, ls), scan_len)
            best_line = cur_line
        }

        val i: mut i64 = ls
        for {
            if i >= scan_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, i))
            if c == '{' {
                depth++
            } elif c == '}' {
                if depth > 0 {
                    depth--
                }
            }
            i++
        }

        cur_line++
    }

    if best_start < 0 || best_end <= best_start {
        return none
    }
    @store(out_line, best_line)
    return trim_left_dup_h(@ptradd(content, best_start), best_end - best_start)
}

fn find_word_col_in_line(content: ref u8, target_line: i64, word: ref u8) i64 = trust {
    if content == none || word == none {
        return 0
    }
    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, target_line, @addr(ls), @addr(le))
    if ls < 0 || le < ls {
        return 0
    }
    val wlen: i64 = cstr.len(word)
    val i: mut i64 = ls
    for {
        if i >= le {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))
        if !is_ident_cont_h(c) {
            i++
            continue
        }
        val start: i64 = i
        val n: mut i64 = 0
        for {
            if i >= le {
                break
            }
            if !is_ident_cont_h(@load8(@ptradd(content, i))) {
                break
            }
            i++
            n++
        }
        if n == wlen && strncmp(@ptradd(content, start), word, n as usize) == 0 {
            return start - ls
        }
    }
    return 0
}

fn get_content_for_file(doc_store: ref void, file_path: ref u8) ref u8 = trust {
    if doc_store == none || file_path == none {
        return none
    }
    val uri: ref u8 = lsp_parser.path_to_uri(file_path)
    if uri == none {
        return none
    }
    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    @free(uri)
    return content
}

fn extract_definition_block(content: ref u8, line: i64) ref u8 = trust {
    if content == none || line < 0 {
        return none
    }
    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    if ls < 0 || le < ls {
        return none
    }

    val len: i64 = cstr.len(content)
    val i: mut i64 = ls
    val seen_brace: mut i64 = 0
    val depth: mut i64 = 0
    val end_off: mut i64 = le

    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))
        if c == '{' {
            depth++
            seen_brace = 1
        } elif c == '}' && seen_brace == 1 {
            depth--
            if depth <= 0 {
                end_off = i + 1
                break
            }
        }
        if c == '\n' && seen_brace == 0 {
            end_off = i
            break
        }
        i++
    }

    if seen_brace == 1 && end_off < le {
        end_off = le
    }
    val trimmed_len: i64 = trim_right_len_h(@ptradd(content, ls), end_off - ls)
    if trimmed_len <= 0 {
        return none
    }
    return raw_dup_h(@ptradd(content, ls), trimmed_len)
}

fn align_up_h(n: i64, align: i64) i64 = {
    if align <= 1 {
        return n
    }
    return ((n + align - 1) / align) * align
}

fn field_align_h(size: i64) i64 = {
    if size <= 1 {
        return 1
    }
    if size >= 8 {
        return 8
    }
    if size >= 4 {
        return 4
    }
    if size >= 2 {
        return 2
    }
    return 1
}

fn find_matching_close_h(
    s: ref u8,
    len: i64,
    open_idx: i64,
    open_ch: u8,
    close_ch: u8
) i64 = trust {
    if s == none || open_idx < 0 || open_idx >= len {
        return -1
    }
    val depth: mut i64 = 0
    val i: mut i64 = open_idx
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == open_ch {
            depth++
        } elif c == close_ch {
            depth--
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn contains_substr_h(s: str.StringView, needle: str.StringView) bool = trust {
    return str.contains(s, needle)
}

fn estimate_type_symbol_size(
    doc_store: mut ref void,
    sym_store: mut ref void,
    sym: ref lsp_parser.Symbol,
    depth: i64
) i64 = trust {
    if sym == none {
        return 8
    }
    if depth > 8 {
        return 8
    }
    if sym.kind == lsp_parser.SYM_ENUM {
        return 8
    }
    if sym.kind != lsp_parser.SYM_TYPE && sym.kind != lsp_parser.SYM_UNION {
        return 8
    }

    val content: ref u8 = get_content_for_file(doc_store, sym.file)
    val def: ref u8 = extract_definition_block(content, sym.line)
    if def == none {
        return 8
    }

    val dlen: i64 = cstr.len(def)
    val open_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= dlen {
            break
        }
        if @load8(@ptradd(def, i)) == '{' {
            open_idx = i
            break
        }
        i++
    }
    if open_idx < 0 {
        @free(def)
        return 8
    }
    val close_idx: i64 = find_matching_close_h(def, dlen, open_idx, '{', '}')
    if close_idx <= open_idx {
        @free(def)
        return 8
    }

    val current_uri_for_sym: ref u8 = lsp_parser.path_to_uri(sym.file)
    val body: ref u8 = @ptradd(def, open_idx + 1)
    val body_len: i64 = close_idx - open_idx - 1
    val result: mut i64 = 0

    if sym.kind == lsp_parser.SYM_UNION {
        val max_payload: mut i64 = 0
        val seg_start: mut i64 = 0
        val sq_depth: mut i64 = 0
        val paren_depth: mut i64 = 0
        val j: mut i64 = 0
        for {
            val emit: mut i64 = 0
            if j >= body_len {
                emit = 1
            } else {
                val c: u8 = @load8(@ptradd(body, j))
                if c == '[' {
                    sq_depth++
                } elif c == ']' {
                    if sq_depth > 0 {
                        sq_depth--
                    }
                } elif c == '(' {
                    paren_depth++
                } elif c == ')' {
                    if paren_depth > 0 {
                        paren_depth--
                    }
                } elif c == '|' && sq_depth == 0 && paren_depth == 0 {
                    emit = 1
                }
            }

            if emit == 1 {
                val seg_len: i64 = trim_right_len_h(@ptradd(body, seg_start), j - seg_start)
                if seg_len > 0 {
                    val variant: ref u8 = raw_dup_h(@ptradd(body, seg_start), seg_len)
                    if variant != none {
                        val vlen: i64 = cstr.len(variant)
                        val open_paren: mut i64 = -1
                        val k: mut i64 = 0
                        for {
                            if k >= vlen {
                                break
                            }
                            if @load8(@ptradd(variant, k)) == '(' {
                                open_paren = k
                                break
                            }
                            k++
                        }
                        val payload_size: mut i64 = 0
                        if open_paren >= 0 {
                            val close_paren: i64 = find_matching_close_h(
                                variant,
                                vlen,
                                open_paren,
                                '(',
                                ')'
                            )
                            if close_paren > open_paren {
                                val arg_start: mut i64 = open_paren + 1
                                val arg_sq_depth: mut i64 = 0
                                val arg_paren_depth: mut i64 = 0
                                val m: mut i64 = arg_start
                                val running: mut i64 = 0
                                val running_align: mut i64 = 1
                                for {
                                    val arg_emit: mut i64 = 0
                                    if m >= close_paren {
                                        arg_emit = 1
                                    } else {
                                        val cc: u8 = @load8(@ptradd(variant, m))
                                        if cc == '[' {
                                            arg_sq_depth++
                                        } elif cc == ']' {
                                            if arg_sq_depth > 0 {
                                                arg_sq_depth--
                                            }
                                        } elif cc == '(' {
                                            arg_paren_depth++
                                        } elif cc == ')' {
                                            if arg_paren_depth > 0 {
                                                arg_paren_depth--
                                            }
                                        } elif cc == ',' && arg_sq_depth == 0 && arg_paren_depth == 0 {
                                            arg_emit = 1
                                        }
                                    }
                                    if arg_emit == 1 {
                                        val arg_len: i64 = trim_right_len_h(
                                            @ptradd(variant, arg_start),
                                            m - arg_start
                                        )
                                        if arg_len > 0 {
                                            val arg_expr: ref u8 = raw_dup_h(
                                                @ptradd(variant, arg_start),
                                                arg_len
                                            )
                                            if arg_expr != none {
                                                val arg_size: i64 = estimate_type_expr_size(
                                                    doc_store, sym_store, current_uri_for_sym, sym.file, arg_expr, depth + 1
                                                )
                                                @free(arg_expr)
                                                val arg_align: i64 = field_align_h(arg_size)
                                                running = align_up_h(running, arg_align)
                                                running = running + arg_size
                                                if arg_align > running_align {
                                                    running_align = arg_align
                                                }
                                            }
                                        }
                                        arg_start = m + 1
                                    }
                                    if m >= close_paren {
                                        break
                                    }
                                    m++
                                }
                                payload_size = align_up_h(running, running_align)
                            }
                        }
                        if payload_size > max_payload {
                            max_payload = payload_size
                        }
                        @free(variant)
                    }
                }
                seg_start = j + 1
            }

            if j >= body_len {
                break
            }
            j++
        }
        result = align_up_h(max_payload + 8, 8)
    } else {
        val offset: mut i64 = 0
        val max_align: mut i64 = 1
        val line_start: mut i64 = 0
        val j: mut i64 = 0
        for {
            val emit: mut i64 = 0
            if j >= body_len {
                emit = 1
            } else {
                val c: u8 = @load8(@ptradd(body, j))
                if c == '\n' || c == '\r' {
                    emit = 1
                }
            }

            if emit == 1 {
                val raw_len: i64 = trim_right_len_h(@ptradd(body, line_start), j - line_start)
                if raw_len > 0 {
                    val field_line: ref u8 = raw_dup_h(@ptradd(body, line_start), raw_len)
                    if field_line != none {
                        val flen: i64 = cstr.len(field_line)
                        val colon_idx: mut i64 = -1
                        val k: mut i64 = 0
                        for {
                            if k >= flen {
                                break
                            }
                            if @load8(@ptradd(field_line, k)) == ':' {
                                colon_idx = k
                                break
                            }
                            k++
                        }
                        if colon_idx >= 0 {
                            val type_start: i64 = skip_ws_h(field_line, colon_idx + 1, flen)
                            val type_len: i64 = trim_right_len_h(
                                @ptradd(field_line, type_start),
                                flen - type_start
                            )
                            if type_len > 0 {
                                val type_expr: ref u8 = raw_dup_h(
                                    @ptradd(field_line, type_start),
                                    type_len
                                )
                                if type_expr != none {
                                    val field_size: i64 = estimate_type_expr_size(
                                        doc_store, sym_store, current_uri_for_sym, sym.file, type_expr, depth + 1
                                    )
                                    @free(type_expr)
                                    val align: i64 = field_align_h(field_size)
                                    offset = align_up_h(offset, align)
                                    offset = offset + field_size
                                    if align > max_align {
                                        max_align = align
                                    }
                                }
                            }
                        }
                        @free(field_line)
                    }
                }
                line_start = j + 1
            }

            if j >= body_len {
                break
            }
            j++
        }
        result = align_up_h(offset, max_align)
    }

    if current_uri_for_sym != none {
        @free(current_uri_for_sym)
    }
    @free(def)
    return result
}

fn estimate_type_expr_size(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    type_expr: ref u8,
    depth: i64
) i64 = trust {
    if type_expr == none {
        return 8
    }
    if depth > 8 {
        return 8
    }

    val expr_len: i64 = cstr.len(type_expr)
    val start: i64 = skip_ws_h(type_expr, 0, expr_len)
    val trimmed_len: i64 = trim_right_len_h(@ptradd(type_expr, start), expr_len - start)
    if trimmed_len <= 0 {
        return 8
    }

    val expr: ref u8 = raw_dup_h(@ptradd(type_expr, start), trimmed_len)
    if expr == none {
        return 8
    }
    val len: i64 = cstr.len(expr)

    if starts_with_h(str.view(expr, len), "mut ") {
        val out: i64 = estimate_type_expr_size(
            doc_store,
            sym_store,
            current_uri,
            current_file,
            @ptradd(expr, 4),
            depth + 1
        )
        @free(expr)
        return out
    }
    if starts_with_h(str.view(expr, len), "ref ") {
        @free(expr)
        return 8
    }

    val builtin_size: i64 = builtin_type_size(str.from_cstr(expr))
    if builtin_size >= 0 && is_builtin_type_word(str.from_cstr(expr)) {
        @free(expr)
        return builtin_size
    }

    if starts_with_h(str.view(expr, len), "list[") {
        @free(expr)
        return 24
    }
    if starts_with_h(str.view(expr, len), "option[") {
        val close_idx: i64 = find_matching_close_h(expr, len, 6, '[', ']')
        if close_idx > 6 {
            val inner: ref u8 = raw_dup_h(@ptradd(expr, 7), close_idx - 7)
            val inner_size: i64 = estimate_type_expr_size(
                doc_store,
                sym_store,
                current_uri,
                current_file,
                inner,
                depth + 1
            )
            if inner != none {
                @free(inner)
            }
            @free(expr)
            return align_up_h(inner_size, field_align_h(inner_size)) + 8
        }
        @free(expr)
        return 16
    }
    if starts_with_h(str.view(expr, len), "result[") {
        val close_idx: i64 = find_matching_close_h(expr, len, 6, '[', ']')
        if close_idx > 6 {
            val inner: ref u8 = raw_dup_h(@ptradd(expr, 7), close_idx - 7)
            if inner != none {
                val ilen: i64 = cstr.len(inner)
                val sq_depth: mut i64 = 0
                val paren_depth: mut i64 = 0
                val comma_idx: mut i64 = -1
                val i: mut i64 = 0
                for {
                    if i >= ilen {
                        break
                    }
                    val c: u8 = @load8(@ptradd(inner, i))
                    if c == '[' {
                        sq_depth++
                    } elif c == ']' {
                        if sq_depth > 0 {
                            sq_depth--
                        }
                    } elif c == '(' {
                        paren_depth++
                    } elif c == ')' {
                        if paren_depth > 0 {
                            paren_depth--
                        }
                    } elif c == ',' && sq_depth == 0 && paren_depth == 0 {
                        comma_idx = i
                        break
                    }
                    i++
                }
                if comma_idx >= 0 {
                    val ok_expr: ref u8 = raw_dup_h(inner, comma_idx)
                    val err_expr: ref u8 = raw_dup_h(
                        @ptradd(inner, comma_idx + 1),
                        ilen - comma_idx - 1
                    )
                    val ok_size: i64 = estimate_type_expr_size(
                        doc_store,
                        sym_store,
                        current_uri,
                        current_file,
                        ok_expr,
                        depth + 1
                    )
                    val err_size: i64 = estimate_type_expr_size(
                        doc_store,
                        sym_store,
                        current_uri,
                        current_file,
                        err_expr,
                        depth + 1
                    )
                    if ok_expr != none {
                        @free(ok_expr)
                    }
                    if err_expr != none {
                        @free(err_expr)
                    }
                    @free(inner)
                    @free(expr)
                    val max_sz: mut i64 = ok_size
                    if err_size > max_sz {
                        max_sz = err_size
                    }
                    return align_up_h(max_sz, field_align_h(max_sz)) + 8
                }
                @free(inner)
            }
        }
        @free(expr)
        return 16
    }

    val dot_idx: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(expr, i)) == '.' {
            dot_idx = i
            break
        }
        i++
    }

    val lookup_name: mut ref u8 = none
    val lookup_alias: mut ref u8 = none
    if dot_idx > 0 && dot_idx + 1 < len {
        lookup_alias = raw_dup_h(expr, dot_idx)
        lookup_name = raw_dup_h(@ptradd(expr, dot_idx + 1), len - dot_idx - 1)
    } else {
        lookup_name = raw_dup_cstr_h(expr)
    }

    val resolved: ref lsp_parser.Symbol = lookup_symbol(
        doc_store, sym_store, current_uri, current_file, lookup_name, lookup_alias
    )
    if lookup_name != none {
        @free(lookup_name)
    }
    if lookup_alias != none {
        @free(lookup_alias)
    }
    @free(expr)

    if resolved == none {
        return 8
    }
    return estimate_type_symbol_size(doc_store, sym_store, resolved, depth + 1)
}

fn append_type_hover_contents(
    sb: builder.StringBuilder,
    doc_store: mut ref void,
    sym_store: mut ref void,
    _: ref u8,
    _: ref u8,
    sym: ref lsp_parser.Symbol
) void = trust {
    if sym == none {
        return
    }
    val def_content: ref u8 = get_content_for_file(doc_store, sym.file)
    val definition: ref u8 = extract_definition_block(def_content, sym.line)
    val approx_size: i64 = estimate_type_symbol_size(doc_store, sym_store, sym, 0)

    builder.StringBuilder.append(sb, "```spectre\\n")
    if definition != none {
        sb_escape_cstr(sb, definition)
    } elif sym.signature != none {
        sb_escape_cstr(sb, sym.signature)
    } elif sym.name != none {
        sb_escape_cstr(sb, sym.name)
    }
    builder.StringBuilder.append(sb, "\\n```")

    if approx_size >= 0 {
        builder.StringBuilder.append(sb, "\\n\\nApprox. size: ")
        sb_append_int(sb, approx_size)
        builder.StringBuilder.append(sb, " bytes")
    }

    if sym.doc != none && cstr.len(sym.doc) > 0 {
        builder.StringBuilder.append(sb, "\\n\\n")
        sb_escape_cstr(sb, sym.doc)
    }

    if definition != none {
        @free(definition)
    }
}

fn append_builtin_type_hover_contents(sb: builder.StringBuilder, word: ref u8) void = trust {
    builder.StringBuilder.append(sb, "```spectre\\n")
    sb_escape_cstr(sb, builtin_type_signature(word))
    builder.StringBuilder.append(sb, "\\n```\\n\\n")
    sb_escape_cstr(sb, builtin_type_desc(str.from_cstr(word)))
    builder.StringBuilder.append(sb, "\\n\\nApprox. size: ")
    sb_append_int(sb, builtin_type_size(str.from_cstr(word)))
    builder.StringBuilder.append(sb, " bytes")
}

fn symbol_is_unverified(doc_store: ref void, sym: ref lsp_parser.Symbol) bool = trust {
    if doc_store == none || sym == none || sym.file == none || sym.line < 0 {
        return false
    }
    if sym.kind != lsp_parser.SYM_FUNCTION && sym.kind != lsp_parser.SYM_METHOD {
        return false
    }
    val content: ref u8 = get_content_for_file(doc_store, sym.file)
    if content == none {
        return false
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, sym.line, @addr(ls), @addr(le))
    if ls < 0 || le <= ls {
        return false
    }

    val line_len: i64 = trim_right_len_h(@ptradd(content, ls), le - ls)
    if line_len <= 0 {
        return false
    }
    val line_text: ref u8 = trim_left_dup_h(@ptradd(content, ls), line_len)
    if line_text == none {
        return false
    }
    val llen: i64 = cstr.len(line_text)
    val unverified: bool = contains_substr_h(str.from_cstr(line_text), "= trust") ||
    contains_substr_h(str.from_cstr(line_text), " = trust") ||
    starts_with_h(str.view(line_text, llen), "trust ")
    @free(line_text)
    return unverified
}

fn sym_kind_to_lsp(kind: i64) i64 = {
    if kind == lsp_parser.SYM_FUNCTION {
        return 12
    }
    if kind == lsp_parser.SYM_METHOD {
        return 6
    }
    if kind == lsp_parser.SYM_TYPE {
        return 23
    }
    if kind == lsp_parser.SYM_ENUM {
        return 10
    }
    if kind == lsp_parser.SYM_UNION {
        return 23
    }
    if kind == lsp_parser.SYM_MODULE {
        return 2
    }
    if kind == lsp_parser.SYM_FIELD {
        return 5
    }
    return 13
}

fn append_range(sb: builder.StringBuilder, line: i64, cs: i64, ce: i64) void = trust {
    builder.StringBuilder.append(sb, "{\"start\":{\"line\":")
    sb_append_int(sb, line)
    builder.StringBuilder.append(sb, ",\"character\":")
    sb_append_int(sb, cs)
    builder.StringBuilder.append(sb, "},\"end\":{\"line\":")
    sb_append_int(sb, line)
    builder.StringBuilder.append(sb, ",\"character\":")
    sb_append_int(sb, ce)
    builder.StringBuilder.append(sb, "}}")
}

fn first_line_dup(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = cstr.len(s)
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == '\n' || c == '\r' {
            break
        }
        i++
    }
    if i == 0 {
        return none
    }
    return raw_dup_h(s, i)
}

pub fn find_completion_context(
    content: ref u8,
    line: i64,
    col: i64,
    out_start: ref i64,
    out_end: ref i64,
    out_has_dot: ref i64,
    out_base_start: ref i64,
    out_base_len: ref i64
) void = trust {
    @store(out_start, -1 as i64)
    @store(out_end, -1 as i64)
    @store(out_has_dot, 0 as i64)
    @store(out_base_start, -1 as i64)
    @store(out_base_len, 0 as i64)
    if content == none || line < 0 || col < 0 {
        return
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    if ls < 0 {
        return
    }

    val cursor: mut i64 = ls + col
    if cursor < ls {
        cursor = ls
    }
    if cursor > le {
        cursor = le
    }

    val ps: mut i64 = cursor
    for {
        if ps <= ls {
            break
        }
        if !is_ident_cont_h(@load8(@ptradd(content, ps - 1))) {
            break
        }
        ps--
    }
    @store(out_start, ps)
    @store(out_end, cursor)

    if ps <= ls {
        return
    }
    if @load8(@ptradd(content, ps - 1)) != '.' {
        return
    }

    val dot: i64 = ps - 1
    val be: i64 = dot
    val bs: mut i64 = be
    for {
        val seg_end: i64 = bs
        for {
            if bs <= ls {
                break
            }
            if !is_ident_cont_h(@load8(@ptradd(content, bs - 1))) {
                break
            }
            bs--
        }
        if bs == seg_end {
            break
        }
        if bs > ls && @load8(@ptradd(content, bs - 1)) == '.' {
            bs--
        } else {
            break
        }
    }
    if be > bs {
        @store(out_has_dot, 1 as i64)
        @store(out_base_start, bs)
        @store(out_base_len, be - bs)
    }
}

fn prefix_matches_h(name: str.StringView, prefix: str.StringView) bool = trust {
    if str.is_empty(prefix) {
        return true
    }
    if prefix.len > name.len {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= prefix.len {
            break
        }
        val a: mut u8 = @load8(@ptradd(name.ptr, i))
        val b: mut u8 = @load8(@ptradd(prefix.ptr, i))
        if a >= 65 && a <= 90 {
            a += 32
        }
        if b >= 65 && b <= 90 {
            b += 32
        }
        if a != b {
            return false
        }
        i++
    }
    return true
}

fn append_completion_item(
    sb: builder.StringBuilder,
    first: ref i64,
    label: ref u8,
    detail: ref u8,
    doc: ref u8,
    kind: i64,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if label == none {
        return
    }
    if @load(first) == 0 {
        builder.StringBuilder.append(sb, ",")
    }
    @store(first, 0 as i64)

    builder.StringBuilder.append(sb, "{\"label\":\"")
    sb_escape_cstr(sb, label)
    builder.StringBuilder.append(sb, "\",\"kind\":")
    sb_append_int(sb, kind)

    if detail != none && cstr.len(detail) > 0 {
        builder.StringBuilder.append(sb, ",\"detail\":\"")
        sb_escape_cstr(sb, detail)
        builder.StringBuilder.append(sb, "\"")
    }
    if doc != none && cstr.len(doc) > 0 {
        builder.StringBuilder.append(sb, ",\"documentation\":{\"kind\":\"markdown\",\"value\":\"")
        sb_escape_cstr(sb, doc)
        builder.StringBuilder.append(sb, "\"}")
    }
    if replace_start >= 0 && replace_end >= replace_start {
        builder.StringBuilder.append(sb, ",\"textEdit\":{\"range\":")
        append_range(sb, replace_line, replace_start, replace_end)
        builder.StringBuilder.append(sb, ",\"newText\":\"")
        sb_escape_cstr(sb, label)
        builder.StringBuilder.append(sb, "\"}")
    }
    builder.StringBuilder.append(sb, "}")
}

fn append_symbol_completion(
    sb: builder.StringBuilder,
    first: ref i64,
    sym: ref lsp_parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if sym == none || sym.name == none {
        return
    }
    if !prefix_matches_h(str.from_cstr(sym.name), str.from_cstr(prefix)) {
        return
    }
    val detail: mut ref u8 = sym.signature
    if sym.kind == lsp_parser.SYM_FIELD || sym.kind == lsp_parser.SYM_VARIABLE {
        detail = sym.ret_type
    }
    append_completion_item(
        sb, first, sym.name, detail, sym.doc,
        sym_kind_to_lsp(sym.kind), replace_line, replace_start, replace_end
    )
}

fn append_method_completions(
    sb: builder.StringBuilder,
    first: ref i64,
    sym_store: mut ref void,
    doc_store: mut ref void,
    type_sym: ref lsp_parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    if type_sym == none || type_sym.file == none || type_sym.name == none {
        return
    }
    val syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
    if syms == none {
        return
    }
    val n: usize = coll.PtrList.len(syms)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(syms, i) is some v {
            val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            if sym != none && sym.kind == lsp_parser.SYM_METHOD && method_receiver_matches(
                sym.receiver,
                type_sym.name
            ) {
                append_symbol_completion(
                    sb,
                    first,
                    sym,
                    prefix,
                    replace_line,
                    replace_start,
                    replace_end
                )
            }
        }
        i++
    }
}

fn append_field_completions(
    sb: builder.StringBuilder,
    first: ref i64,
    doc_store: mut ref void,
    sym_store: mut ref void,
    type_sym: ref lsp_parser.Symbol,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
    if fields == none {
        return
    }
    val n: usize = coll.PtrList.len(fields)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(fields, i) is some v {
            val field: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            append_symbol_completion(
                sb,
                first,
                field,
                prefix,
                replace_line,
                replace_start,
                replace_end
            )
        }
        i++
    }
    lsp_parser.free_sym_list(fields)
}

fn module_syms_for_alias(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    alias: ref u8
) ref void = trust {
    if alias == none {
        return none
    }
    val cur_syms: mut ref void = none
    if current_uri != none {
        if coll.StringMap.get(sym_store, current_uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
    }
    val imp: ref lsp_parser.Symbol = find_import_sym(cur_syms, alias)
    if imp == none || imp.ret_type == none {
        return none
    }
    val mod_file: ref u8 = lsp_parser.resolve_module_path(current_file, imp.ret_type)
    if mod_file == none {
        return none
    }
    ensure_parsed(doc_store, sym_store, mod_file)
    val mod_uri: ref u8 = lsp_parser.path_to_uri(mod_file)
    @free(mod_file)
    if mod_uri == none {
        return none
    }
    val mod_syms: mut ref void = none
    if coll.StringMap.get(sym_store, mod_uri) is some v {
        mod_syms = @bitcast(v, ref void)
    }
    @free(mod_uri)
    return mod_syms
}

fn resolve_chain_type_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    content: ref u8,
    line: i64,
    cursor_off: i64,
    base: ref u8,
    depth: i64
) ref lsp_parser.Symbol = trust {
    if base == none || depth > 8 {
        return none
    }
    val len: i64 = cstr.len(base)
    if len <= 0 {
        return none
    }

    val first_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(base, i)) == '.' {
            first_dot = i
            break
        }
        i++
    }
    val head: mut ref u8 = none
    if first_dot >= 0 {
        head = raw_dup_h(base, first_dot)
    } else {
        head = raw_dup_cstr_h(base)
    }
    if head == none {
        return none
    }

    val head_type: ref u8 = lookup_variable_type_expr(
        doc_store, sym_store, current_uri, current_file, content, line, cursor_off,
        head, depth + 1
    )
    @free(head)
    if head_type == none {
        return none
    }
    val head_sym: ref lsp_parser.Symbol = resolve_type_symbol(
        doc_store, sym_store, current_uri, current_file, head_type, depth + 1
    )
    @free(head_type)
    if head_sym == none || first_dot < 0 {
        return head_sym
    }

    val current: mut ref lsp_parser.Symbol = head_sym
    val pos: mut i64 = first_dot + 1
    for {
        if pos >= len {
            break
        }
        val seg_start: i64 = pos
        val seg_end: mut i64 = pos
        for {
            if seg_end >= len {
                break
            }
            if @load8(@ptradd(base, seg_end)) == '.' {
                break
            }
            seg_end++
        }
        if seg_end > seg_start && current != none {
            val seg: ref u8 = raw_dup_h(@ptradd(base, seg_start), seg_end - seg_start)
            if seg != none {
                val fields: mut ref void = fields_for_type(doc_store, sym_store, current)
                val field: ref lsp_parser.Symbol = find_sym_by_name(fields, seg)
                val field_type: mut ref u8 = none
                if field != none && field.ret_type != none {
                    field_type = raw_dup_cstr_h(field.ret_type)
                }
                if fields != none {
                    lsp_parser.free_sym_list(fields)
                }
                @free(seg)
                if field_type == none {
                    return none
                }
                val field_uri: ref u8 = lsp_parser.path_to_uri(current.file)
                current = resolve_type_symbol(
                    doc_store, sym_store, field_uri, current.file, field_type, depth + 1
                )
                if field_uri != none {
                    @free(field_uri)
                }
                @free(field_type)
            }
        }
        pos = seg_end
        if pos < len && @load8(@ptradd(base, pos)) == '.' {
            pos++
        }
    }
    return current
}

fn send_intrinsic_hover(id_raw: ref void, word: ref u8) void = trust {
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(
        sb,
        ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
    )
    append_intrinsic_hover_contents(sb, word)
    builder.StringBuilder.append(sb, "\"}}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

fn send_field_hover(
    id_raw: ref void,
    field: ref lsp_parser.Symbol,
    type_sym: ref lsp_parser.Symbol
) void = trust {
    if field == none {
        send_null_result(id_raw)
        return
    }
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(
        sb,
        ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
    )
    builder.StringBuilder.append(sb, "```spectre\\n")
    sb_escape_cstr(sb, field.name)
    builder.StringBuilder.append(sb, ": ")
    sb_escape_cstr(sb, field.ret_type)
    builder.StringBuilder.append(sb, "\\n```\\n\\nField")
    if type_sym != none && type_sym.name != none {
        builder.StringBuilder.append(sb, " of ")
        sb_escape_cstr(sb, type_sym.name)
    }
    if field.doc != none && cstr.len(field.doc) > 0 {
        builder.StringBuilder.append(sb, "\\n\\n")
        sb_escape_cstr(sb, field.doc)
    }
    builder.StringBuilder.append(sb, "\"}}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

pub fn handle_hover(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw)
        return
    }

    val ws: mut i64 = -1
    val wl: mut i64 = 0
    lsp_parser.find_word_at(content, line, col, @addr(ws), @addr(wl))
    if ws < 0 || wl <= 0 {
        // Hovering directly on the '@' of an intrinsic: find the identifier
        // immediately after it.
        lsp_parser.find_word_at(content, line, col + 1, @addr(ws), @addr(wl))
        if ws <= 0 || wl <= 0 || @load8(@ptradd(content, ws - 1)) != '@' {
            send_null_result(id_raw)
            return
        }
    }

    val word: ref u8 = @alloc(wl + 1) as ref u8
    if word == none {
        send_null_result(id_raw)
        return
    }
    @memcpy(word, @ptradd(content, ws), wl as usize)
    @store8(@ptradd(word, wl), 0)

    if ws > 0 && @load8(@ptradd(content, ws - 1)) == '@' && is_intrinsic_word(str.from_cstr(word)) {
        send_intrinsic_hover(id_raw, word)
        @free(word)
        return
    }

    val ms: mut i64 = -1
    val ml: mut i64 = 0
    lsp_parser.find_dot_prefix(content, ws, @addr(ms), @addr(ml))

    val module_alias: mut ref u8 = none
    if ms >= 0 && ml > 0 {
        module_alias = @alloc(ml + 1) as ref u8
        if module_alias != none {
            @memcpy(module_alias, @ptradd(content, ms), ml as usize)
            @store8(@ptradd(module_alias, ml), 0)
        }
    }

    val file_path: ref u8 = lsp_parser.uri_to_path(uri)

    // `value.field` / `Type.method` hover.  The part before the dot may be a
    // local variable, a parameter, a global, or a type name.
    if module_alias != none {
        val base_type: ref u8 = lookup_variable_type_expr(
            doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
        )
        val type_sym: mut ref lsp_parser.Symbol = none
        if base_type != none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, base_type, 0)
            @free(base_type)
        }
        if type_sym == none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, module_alias, 0)
        }
        if type_sym == none {
            type_sym = resolve_chain_type_symbol(
                doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
            )
        }
        if type_sym != none {
            val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
            val field: ref lsp_parser.Symbol = find_sym_by_name(fields, word)
            if field != none {
                val sb: builder.StringBuilder = builder.StringBuilder.new()
                make_base(sb, id_raw)
                builder.StringBuilder.append(
                    sb,
                    ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
                )
                builder.StringBuilder.append(sb, "```spectre\\n")
                sb_escape_cstr(sb, field.name)
                builder.StringBuilder.append(sb, ": ")
                sb_escape_cstr(sb, field.ret_type)
                builder.StringBuilder.append(sb, "\\n```\\n\\nField of ")
                sb_escape_cstr(sb, type_sym.name)
                if field.doc != none && cstr.len(field.doc) > 0 {
                    builder.StringBuilder.append(sb, "\\n\\n")
                    sb_escape_cstr(sb, field.doc)
                }
                builder.StringBuilder.append(sb, "\"}}}")
                val built: str.String = builder.StringBuilder.build(sb)
                write_response(owned_view(built))
                ostr.free(built)
                builder.StringBuilder.free(sb)
                if fields != none {
                    lsp_parser.free_sym_list(fields)
                }
                if word != none {
                    @free(word)
                }
                if file_path != none {
                    @free(file_path)
                }
                if module_alias != none {
                    @free(module_alias)
                }
                return
            }
            if fields != none {
                lsp_parser.free_sym_list(fields)
            }

            val type_syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
            val method: ref lsp_parser.Symbol = find_sym_by_name(type_syms, word)
            if method != none && method.kind == lsp_parser.SYM_METHOD &&
            method_receiver_matches(method.receiver, type_sym.name) {
                val sb: builder.StringBuilder = builder.StringBuilder.new()
                make_base(sb, id_raw)
                builder.StringBuilder.append(
                    sb,
                    ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
                )
                builder.StringBuilder.append(sb, "```spectre\\n")
                sb_escape_cstr(sb, method.signature)
                builder.StringBuilder.append(sb, "\\n```")
                if method.doc != none && cstr.len(method.doc) > 0 {
                    builder.StringBuilder.append(sb, "\\n\\n")
                    sb_escape_cstr(sb, method.doc)
                }
                builder.StringBuilder.append(sb, "\"}}}")
                val built: str.String = builder.StringBuilder.build(sb)
                write_response(owned_view(built))
                ostr.free(built)
                builder.StringBuilder.free(sb)
                if word != none {
                    @free(word)
                }
                if file_path != none {
                    @free(file_path)
                }
                if module_alias != none {
                    @free(module_alias)
                }
                return
            }
        }
    }

    if module_alias == none && is_keyword(str.from_cstr(word)) {
        val sb: builder.StringBuilder = builder.StringBuilder.new()
        make_base(sb, id_raw)
        builder.StringBuilder.append(
            sb,
            ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
        )
        append_keyword_hover_contents(sb, word)
        builder.StringBuilder.append(sb, "\"}}}")
        val built: str.String = builder.StringBuilder.build(sb)
        write_response(owned_view(built))
        ostr.free(built)
        builder.StringBuilder.free(sb)
        if word != none {
            @free(word)
        }
        if file_path != none {
            @free(file_path)
        }
        if module_alias != none {
            @free(module_alias)
        }
        return
    }

    // Hovering a field in its own type declaration.
    if module_alias == none {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val tsym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
                    if tsym != none &&
                    (tsym.kind == lsp_parser.SYM_TYPE || tsym.kind == lsp_parser.SYM_ENUM || tsym.kind == lsp_parser.SYM_UNION) {
                        val fields: mut ref void = fields_for_type(doc_store, sym_store, tsym)
                        val field: ref lsp_parser.Symbol = find_sym_by_name(fields, word)
                        if field != none && field.line == line {
                            send_field_hover(id_raw, field, tsym)
                            if fields != none {
                                lsp_parser.free_sym_list(fields)
                            }
                            if word != none {
                                @free(word)
                            }
                            if file_path != none {
                                @free(file_path)
                            }
                            if module_alias != none {
                                @free(module_alias)
                            }
                            return
                        }
                        if fields != none {
                            lsp_parser.free_sym_list(fields)
                        }
                    }
                }
                i++
            }
        }
    }

    if module_alias == none {
        val param_decl: ref u8 = lookup_parameter_decl(sym_store, uri, line, word)
        if param_decl != none {
            val sb: builder.StringBuilder = builder.StringBuilder.new()
            make_base(sb, id_raw)
            builder.StringBuilder.append(
                sb,
                ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
            )
            builder.StringBuilder.append(sb, "```spectre\\n")
            sb_escape_cstr(sb, param_decl)
            builder.StringBuilder.append(sb, "\\n```\\n\\nFunction parameter")
            builder.StringBuilder.append(sb, "\"}}}")
            val built: str.String = builder.StringBuilder.build(sb)
            write_response(owned_view(built))
            ostr.free(built)
            builder.StringBuilder.free(sb)
            if word != none {
                @free(word)
            }
            if file_path != none {
                @free(file_path)
            }
            if module_alias != none {
                @free(module_alias)
            }
            return
        }

        val local_line: mut i64 = -1
        val local_decl: ref u8 = lookup_local_variable_decl(
            sym_store,
            uri,
            content,
            line,
            ws,
            word,
            @addr(local_line)
        )
        if local_decl != none {
            val sb: builder.StringBuilder = builder.StringBuilder.new()
            make_base(sb, id_raw)
            builder.StringBuilder.append(
                sb,
                ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
            )
            builder.StringBuilder.append(sb, "```spectre\\n")
            sb_escape_cstr(sb, local_decl)
            builder.StringBuilder.append(sb, "\\n```\\n\\nLocal variable")
            builder.StringBuilder.append(sb, "\"}}}")
            val built: str.String = builder.StringBuilder.build(sb)
            write_response(owned_view(built))
            ostr.free(built)
            builder.StringBuilder.free(sb)
            @free(local_decl)
            if word != none {
                @free(word)
            }
            if file_path != none {
                @free(file_path)
            }
            if module_alias != none {
                @free(module_alias)
            }
            return
        }

        val global_line: mut i64 = -1
        val global_decl: ref u8 = lookup_global_variable_decl(
            content,
            line,
            ws,
            word,
            @addr(global_line)
        )
        if global_decl != none {
            val sb: builder.StringBuilder = builder.StringBuilder.new()
            make_base(sb, id_raw)
            builder.StringBuilder.append(
                sb,
                ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
            )
            builder.StringBuilder.append(sb, "```spectre\\n")
            sb_escape_cstr(sb, global_decl)
            builder.StringBuilder.append(sb, "\\n```\\n\\nGlobal variable")
            builder.StringBuilder.append(sb, "\"}}}")
            val built: str.String = builder.StringBuilder.build(sb)
            write_response(owned_view(built))
            ostr.free(built)
            builder.StringBuilder.free(sb)
            @free(global_decl)
            if word != none {
                @free(word)
            }
            if file_path != none {
                @free(file_path)
            }
            if module_alias != none {
                @free(module_alias)
            }
            return
        }
    }

    val sym: ref lsp_parser.Symbol = lookup_symbol(
        doc_store, sym_store, uri, file_path, word, module_alias
    )
    if sym == none && module_alias == none && is_builtin_type_word(str.from_cstr(word)) {
        val sb: builder.StringBuilder = builder.StringBuilder.new()
        make_base(sb, id_raw)
        builder.StringBuilder.append(
            sb,
            ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
        )
        append_builtin_type_hover_contents(sb, word)
        builder.StringBuilder.append(sb, "\"}}}")
        val built: str.String = builder.StringBuilder.build(sb)
        write_response(owned_view(built))
        ostr.free(built)
        builder.StringBuilder.free(sb)
        if file_path != none {
            @free(file_path)
        }
        if word != none {
            @free(word)
        }
        if module_alias != none {
            @free(module_alias)
        }
        return
    }

    if word != none {
        @free(word)
    }
    if module_alias != none {
        @free(module_alias)
    }

    if sym == none {
        if file_path != none {
            @free(file_path)
        }
        send_null_result(id_raw)
        return
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(
        sb,
        ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\""
    )

    if sym.kind == lsp_parser.SYM_TYPE || sym.kind == lsp_parser.SYM_ENUM || sym.kind == lsp_parser.SYM_UNION {
        append_type_hover_contents(sb, doc_store, sym_store, uri, file_path, sym)
    } else {
        if sym.signature != none {
            builder.StringBuilder.append(sb, "```spectre\\n")
            sb_escape_cstr(sb, sym.signature)
            builder.StringBuilder.append(sb, "\\n```")
        }
        if symbol_is_unverified(doc_store, sym) {
            builder.StringBuilder.append(sb, "\\n\\n(unverified)")
        }
        if sym.doc != none && cstr.len(sym.doc) > 0 {
            builder.StringBuilder.append(sb, "\\n\\n")
            sb_escape_cstr(sb, sym.doc)
        }
    }

    builder.StringBuilder.append(sb, "\"}}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
    if file_path != none {
        @free(file_path)
    }
}

fn send_definition_location(
    id_raw: ref void,
    def_uri: ref u8,
    line: i64,
    col: i64,
    name_len: i64
) void = trust {
    if def_uri == none {
        send_null_result(id_raw)
        return
    }
    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":{\"uri\":\"")
    sb_escape_cstr(sb, def_uri)
    builder.StringBuilder.append(sb, "\",\"range\":")
    append_range(sb, line, col, col + name_len)
    builder.StringBuilder.append(sb, "}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

pub fn handle_definition(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw)
        return
    }

    val use_start: mut i64 = -1
    val use_len: mut i64 = 0
    lsp_parser.find_use_path_at(content, line, col, @addr(use_start), @addr(use_len))
    if use_start >= 0 && use_len > 0 {
        val mod_path: ref u8 = raw_dup_h(@ptradd(content, use_start), use_len)
        val current_file: ref u8 = lsp_parser.uri_to_path(uri)
        val mod_file: mut ref u8 = none
        if mod_path != none && current_file != none {
            mod_file = lsp_parser.resolve_module_path(current_file, mod_path)
        }
        if mod_file != none {
            val def_uri: ref u8 = lsp_parser.path_to_uri(mod_file)
            if def_uri != none {
                send_definition_location(id_raw, def_uri, 0, 0, 0)
                @free(def_uri)
            } else {
                send_null_result(id_raw)
            }
        } else {
            send_null_result(id_raw)
        }
        if mod_file != none {
            @free(mod_file)
        }
        if current_file != none {
            @free(current_file)
        }
        if mod_path != none {
            @free(mod_path)
        }
        return
    }

    val ws: mut i64 = -1
    val wl: mut i64 = 0
    lsp_parser.find_word_at(content, line, col, @addr(ws), @addr(wl))
    if ws < 0 || wl <= 0 {
        send_null_result(id_raw)
        return
    }

    val word: ref u8 = @alloc(wl + 1) as ref u8
    if word == none {
        send_null_result(id_raw)
        return
    }
    @memcpy(word, @ptradd(content, ws), wl as usize)
    @store8(@ptradd(word, wl), 0)

    val ms: mut i64 = -1
    val ml: mut i64 = 0
    lsp_parser.find_dot_prefix(content, ws, @addr(ms), @addr(ml))

    val module_alias: mut ref u8 = none
    if ms >= 0 && ml > 0 {
        module_alias = @alloc(ml + 1) as ref u8
        if module_alias != none {
            @memcpy(module_alias, @ptradd(content, ms), ml as usize)
            @store8(@ptradd(module_alias, ml), 0)
        }
    }

    val file_path: ref u8 = lsp_parser.uri_to_path(uri)

    if module_alias != none {
        val base_type: ref u8 = lookup_variable_type_expr(
            doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
        )
        val type_sym: mut ref lsp_parser.Symbol = none
        if base_type != none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, base_type, 0)
            @free(base_type)
        }
        if type_sym == none {
            type_sym = resolve_type_symbol(doc_store, sym_store, uri, file_path, module_alias, 0)
        }
        if type_sym == none {
            type_sym = resolve_chain_type_symbol(
                doc_store, sym_store, uri, file_path, content, line, ws, module_alias, 0
            )
        }
        if type_sym != none {
            val fields: mut ref void = fields_for_type(doc_store, sym_store, type_sym)
            val field: ref lsp_parser.Symbol = find_sym_by_name(fields, word)
            if field != none {
                val def_uri: ref u8 = lsp_parser.path_to_uri(field.file)
                send_definition_location(
                    id_raw,
                    def_uri,
                    field.line,
                    field.col,
                    cstr.len(field.name)
                )
                if def_uri != none {
                    @free(def_uri)
                }
                if fields != none {
                    lsp_parser.free_sym_list(fields)
                }
                if word != none {
                    @free(word)
                }
                if file_path != none {
                    @free(file_path)
                }
                if module_alias != none {
                    @free(module_alias)
                }
                return
            }
            if fields != none {
                lsp_parser.free_sym_list(fields)
            }

            val type_syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
            val method: ref lsp_parser.Symbol = find_sym_by_name(type_syms, word)
            if method != none && method.kind == lsp_parser.SYM_METHOD &&
            method_receiver_matches(method.receiver, type_sym.name) {
                val def_uri: ref u8 = lsp_parser.path_to_uri(method.file)
                send_definition_location(
                    id_raw,
                    def_uri,
                    method.line,
                    method.col,
                    cstr.len(method.name)
                )
                if def_uri != none {
                    @free(def_uri)
                }
                if word != none {
                    @free(word)
                }
                if file_path != none {
                    @free(file_path)
                }
                if module_alias != none {
                    @free(module_alias)
                }
                return
            }
        }
    }

    if module_alias == none {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val tsym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
                    if tsym != none &&
                    (tsym.kind == lsp_parser.SYM_TYPE || tsym.kind == lsp_parser.SYM_ENUM || tsym.kind == lsp_parser.SYM_UNION) {
                        val fields: mut ref void = fields_for_type(doc_store, sym_store, tsym)
                        val field: ref lsp_parser.Symbol = find_sym_by_name(fields, word)
                        if field != none && field.line == line {
                            val def_uri: ref u8 = lsp_parser.path_to_uri(field.file)
                            send_definition_location(
                                id_raw,
                                def_uri,
                                field.line,
                                field.col,
                                cstr.len(field.name)
                            )
                            if def_uri != none {
                                @free(def_uri)
                            }
                            if fields != none {
                                lsp_parser.free_sym_list(fields)
                            }
                            if word != none {
                                @free(word)
                            }
                            if file_path != none {
                                @free(file_path)
                            }
                            if module_alias != none {
                                @free(module_alias)
                            }
                            return
                        }
                        if fields != none {
                            lsp_parser.free_sym_list(fields)
                        }
                    }
                }
                i++
            }
        }
    }

    // Parameters are not top-level symbols, so resolve them against the
    // enclosing function before falling back to the symbol table.
    if module_alias == none {
        val param_decl: ref u8 = lookup_parameter_decl(sym_store, uri, line, word)
        if param_decl != none {
            val cur_syms: mut ref void = none
            if coll.StringMap.get(sym_store, uri) is some v {
                cur_syms = @bitcast(v, ref void)
            }
            val fn_sym: ref lsp_parser.Symbol = find_enclosing_callable(cur_syms, line)
            if fn_sym != none {
                val pcol: i64 = find_word_col_in_line(content, fn_sym.line, word)
                val def_uri: ref u8 = lsp_parser.path_to_uri(fn_sym.file)
                send_definition_location(id_raw, def_uri, fn_sym.line, pcol, cstr.len(word))
                if def_uri != none {
                    @free(def_uri)
                }
                if word != none {
                    @free(word)
                }
                if file_path != none {
                    @free(file_path)
                }
                if module_alias != none {
                    @free(module_alias)
                }
                return
            }
        }

        val local_line: mut i64 = -1
        val local_decl: ref u8 = lookup_local_variable_decl(
            sym_store,
            uri,
            content,
            line,
            ws,
            word,
            @addr(local_line)
        )
        if local_decl != none {
            val lcol: i64 = find_word_col_in_line(content, local_line, word)
            val def_uri: ref u8 = raw_dup_cstr_h(uri)
            send_definition_location(id_raw, def_uri, local_line, lcol, cstr.len(word))
            if def_uri != none {
                @free(def_uri)
            }
            @free(local_decl)
            if word != none {
                @free(word)
            }
            if file_path != none {
                @free(file_path)
            }
            if module_alias != none {
                @free(module_alias)
            }
            return
        }

        val global_line: mut i64 = -1
        val global_decl: ref u8 = lookup_global_variable_decl(
            content,
            line,
            ws,
            word,
            @addr(global_line)
        )
        if global_decl != none {
            val gcol: i64 = find_word_col_in_line(content, global_line, word)
            val def_uri: ref u8 = raw_dup_cstr_h(uri)
            send_definition_location(id_raw, def_uri, global_line, gcol, cstr.len(word))
            if def_uri != none {
                @free(def_uri)
            }
            @free(global_decl)
            if word != none {
                @free(word)
            }
            if file_path != none {
                @free(file_path)
            }
            if module_alias != none {
                @free(module_alias)
            }
            return
        }
    }

    val sym: ref lsp_parser.Symbol = lookup_symbol(
        doc_store, sym_store, uri, file_path, word, module_alias
    )
    if file_path != none {
        @free(file_path)
    }
    if word != none {
        @free(word)
    }
    if module_alias != none {
        @free(module_alias)
    }

    if sym == none {
        send_null_result(id_raw)
        return
    }

    val def_uri: mut ref u8 = none
    if sym.file != none {
        def_uri = lsp_parser.path_to_uri(sym.file)
    } else {
        def_uri = raw_dup_cstr_h(uri)
    }
    if def_uri == none {
        send_null_result(id_raw)
        return
    }

    val name_len: i64 = cstr.len(sym.name)
    send_definition_location(id_raw, def_uri, sym.line, sym.col, name_len)
    @free(def_uri)
}

pub fn handle_document_symbol(
    _: ref void,
    sym_store: ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val sym_list: mut ref void = none
    if coll.StringMap.get(sym_store, uri) is some v {
        sym_list = @bitcast(v, ref void)
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":[")

    if sym_list != none {
        val n: usize = coll.PtrList.len(sym_list)
        val i: mut usize = 0
        val first: mut i64 = 1
        for {
            if i >= n {
                break
            }
            if coll.PtrList.get(sym_list, i) is some v {
                val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
                if sym != none && sym.name != none {
                    if first == 0 {
                        builder.StringBuilder.append(sb, ",")
                    }
                    first = 0
                    val lsp_kind: i64 = sym_kind_to_lsp(sym.kind)
                    val nl: i64 = cstr.len(sym.name)
                    builder.StringBuilder.append(sb, "{\"name\":\"")
                    sb_escape_cstr(sb, sym.name)
                    if sym.receiver != none {
                        builder.StringBuilder.append(sb, " (")
                        sb_escape_cstr(sb, sym.receiver)
                        builder.StringBuilder.append(sb, ")")
                    }
                    builder.StringBuilder.append(sb, "\",\"kind\":")
                    sb_append_int(sb, lsp_kind)
                    builder.StringBuilder.append(sb, ",\"range\":")
                    append_range(sb, sym.line, 0, nl + 20)
                    builder.StringBuilder.append(sb, ",\"selectionRange\":")
                    append_range(sb, sym.line, sym.col, sym.col + nl)
                    if sym.doc != none && cstr.len(sym.doc) > 0 {
                        val dl: ref u8 = first_line_dup(sym.doc)
                        if dl != none {
                            builder.StringBuilder.append(sb, ",\"detail\":\"")
                            sb_escape_cstr(sb, dl)
                            builder.StringBuilder.append(sb, "\"")
                            @free(dl)
                        }
                    }
                    builder.StringBuilder.append(sb, "}")
                }
            }
            i++
        }
    }

    builder.StringBuilder.append(sb, "]}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

fn find_method_for_type(
    sym_list: ref void,
    type_name: ref u8,
    name: ref u8
) ref lsp_parser.Symbol = trust {
    if sym_list == none || type_name == none || name == none {
        return none
    }
    val n: usize = coll.PtrList.len(sym_list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(sym_list, i) is some v {
            val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
            if sym != none && sym.kind == lsp_parser.SYM_METHOD && sym.name != none &&
            cstr.cmp(sym.name, name) == 0 &&
            method_receiver_matches(sym.receiver, type_name) {
                return sym
            }
        }
        i++
    }
    return none
}

fn resolve_signature_symbol(
    doc_store: mut ref void,
    sym_store: mut ref void,
    current_uri: ref u8,
    current_file: ref u8,
    content: ref u8,
    line: i64,
    name: ref u8,
    qualifier: ref u8
) ref lsp_parser.Symbol = trust {
    if name == none {
        return none
    }
    if qualifier == none {
        return lookup_symbol(doc_store, sym_store, current_uri, current_file, name, none)
    }

    // Module aliases and plain type names.
    val direct: ref lsp_parser.Symbol = lookup_symbol(
        doc_store, sym_store, current_uri, current_file, name, qualifier
    )
    if direct != none {
        return direct
    }

    val type_sym: mut ref lsp_parser.Symbol = resolve_type_symbol(
        doc_store, sym_store, current_uri, current_file, qualifier, 0
    )
    if type_sym == none {
        type_sym = resolve_chain_type_symbol(
            doc_store, sym_store, current_uri, current_file, content, line, 0, qualifier, 0
        )
    }
    if type_sym == none {
        return none
    }
    val type_syms: ref void = sym_list_for_file(sym_store, doc_store, type_sym.file)
    return find_method_for_type(type_syms, type_sym.name, name)
}

fn append_signature_params_from_label(sb: builder.StringBuilder, label: ref u8) void = trust {
    if label == none {
        return
    }
    val len: i64 = cstr.len(label)
    val open: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= len {
            break
        }
        if @load8(@ptradd(label, i)) == '(' {
            open = i
            break
        }
        i++
    }
    if open < 0 {
        return
    }

    val close: mut i64 = -1
    val depth: mut i64 = 1
    i = open + 1
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(label, i))
        if c == '(' {
            depth++
        } elif c == ')' {
            depth--
            if depth == 0 {
                close = i
                break
            }
        }
        i++
    }
    if close < 0 {
        return
    }

    val start: mut i64 = open + 1
    val nested: mut i64 = 0
    val first: mut i64 = 1
    i = start
    for {
        val at_end: bool = i >= close
        val emit: mut i64 = 0
        if at_end {
            if i > start {
                emit = 1
            }
        } else {
            val c: u8 = @load8(@ptradd(label, i))
            if c == '(' || c == '[' || c == '{' {
                nested++
            } elif c == ')' || c == ']' || c == '}' {
                if nested > 0 {
                    nested--
                }
            } elif c == ',' && nested == 0 {
                emit = 1
            }
        }

        if emit == 1 {
            val s: i64 = skip_ws_h(label, start, i)
            val plen: i64 = trim_right_len_h(@ptradd(label, s), i - s)
            if plen > 0 {
                if first == 1 {
                    first = 0
                } else {
                    builder.StringBuilder.append(sb, ",")
                }
                val part: ref u8 = raw_dup_h(@ptradd(label, s), plen)
                if part != none {
                    builder.StringBuilder.append(sb, "{\"label\":\"")
                    sb_escape_cstr(sb, part)
                    builder.StringBuilder.append(sb, "\"}")
                    @free(part)
                }
            }
            start = i + 1
        }

        if at_end {
            break
        }
        i++
    }
}

fn send_intrinsic_signature_help(id_raw: ref void, name: ref u8, active_param: i64) void = trust {
    val sig: ref u8 = intrinsic_signature(str.from_cstr(name))
    if sig == none {
        send_null_result(id_raw)
        return
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":{\"signatures\":[{\"label\":\"")
    sb_escape_cstr(sb, sig)
    builder.StringBuilder.append(sb, "\"")

    val doc: ref u8 = intrinsic_description(str.from_cstr(name))
    if doc != none && cstr.len(doc) > 0 {
        builder.StringBuilder.append(sb, ",\"documentation\":{\"kind\":\"markdown\",\"value\":\"")
        sb_escape_cstr(sb, doc)
        builder.StringBuilder.append(sb, "\"}")
    }

    builder.StringBuilder.append(sb, ",\"parameters\":[")
    append_signature_params_from_label(sb, sig)
    builder.StringBuilder.append(sb, "]}],\"activeSignature\":0,\"activeParameter\":")
    sb_append_int(sb, active_param)
    builder.StringBuilder.append(sb, "}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

pub fn handle_signature_help(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw)
        return
    }

    val ctx_mem: ref void = @alloc(@sizeof(lsp_parser.CallContext))
    if ctx_mem == none {
        send_null_result(id_raw)
        return
    }
    @memset(ctx_mem, 0, @sizeof(lsp_parser.CallContext) as usize)
    val ctx: mut ref lsp_parser.CallContext = ctx_mem as ref lsp_parser.CallContext
    lsp_parser.find_active_call(content, line, col, ctx)

    val fn_name: mut ref u8 = ctx.fn_name
    val qualifier: mut ref u8 = ctx.qualifier
    val active_param: i64 = ctx.param_idx
    val is_intrinsic: i64 = ctx.is_intrinsic
    @free(ctx_mem)

    if fn_name == none {
        if qualifier != none {
            @free(qualifier)
        }
        send_null_result(id_raw)
        return
    }

    if is_intrinsic == 1 && is_intrinsic_word(str.from_cstr(fn_name)) {
        send_intrinsic_signature_help(id_raw, fn_name, active_param)
        @free(fn_name)
        if qualifier != none {
            @free(qualifier)
        }
        return
    }

    val file_path: ref u8 = lsp_parser.uri_to_path(uri)
    val sym: ref lsp_parser.Symbol = resolve_signature_symbol(
        doc_store, sym_store, uri, file_path, content, line, fn_name, qualifier
    )
    @free(fn_name)
    if qualifier != none {
        @free(qualifier)
    }
    if file_path != none {
        @free(file_path)
    }

    if sym == none {
        send_null_result(id_raw)
        return
    }

    val sig_label: mut ref u8 = sym.name
    if sym.signature != none {
        sig_label = sym.signature
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":{\"signatures\":[{\"label\":\"")
    sb_escape_cstr(sb, sig_label)
    builder.StringBuilder.append(sb, "\"")

    if sym.doc != none && cstr.len(sym.doc) > 0 {
        builder.StringBuilder.append(sb, ",\"documentation\":{\"kind\":\"markdown\",\"value\":\"")
        sb_escape_cstr(sb, sym.doc)
        builder.StringBuilder.append(sb, "\"}")
    }

    if sym.params != none && sym.param_count > 0 {
        builder.StringBuilder.append(sb, ",\"parameters\":[")
        val n: usize = coll.PtrList.len(sym.params)
        val i: mut usize = 0
        for {
            if i >= n {
                break
            }
            if i > 0 {
                builder.StringBuilder.append(sb, ",")
            }
            match coll.PtrList.get(sym.params, i) {
                some v => {
                    val pstr: ref u8 = @bitcast(v, ref void) as ref u8
                    builder.StringBuilder.append(sb, "{\"label\":\"")
                    sb_escape_cstr(sb, pstr)
                    builder.StringBuilder.append(sb, "\"}")
                }
                none => {
                    builder.StringBuilder.append(sb, "{\"label\":\"\"}")
                }
            }
            i++
        }
        builder.StringBuilder.append(sb, "]")
    }

    builder.StringBuilder.append(sb, "}],\"activeSignature\":0,\"activeParameter\":")
    sb_append_int(sb, active_param)
    builder.StringBuilder.append(sb, "}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)
}

fn clear_pending() void = trust {
    if g_pending_uri != none {
        @free(g_pending_uri)
        g_pending_uri = none
    }
    g_pending_due = 0
}

fn set_pending(uri: ref u8) void = trust {
    if uri == none {
        clear_pending()
        return
    }
    val copy: ref u8 = raw_dup_cstr_h(uri)
    if copy == none {
        return
    }
    if g_pending_uri != none {
        @free(g_pending_uri)
    }
    g_pending_uri = copy
    // 300ms after the last edit.
    g_pending_due = time.now_ns() + 300000000
}

pub fn pending_due_ns() i64 = trust {
    return g_pending_due
}

pub fn run_pending_check(doc_store: ref void) void = trust {
    if g_pending_uri == none {
        g_pending_due = 0
        return
    }
    val uri: ref u8 = g_pending_uri
    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content != none {
        send_diagnostics(uri, content)
    }
    clear_pending()
}

pub fn update_document(
    doc_store: ref void,
    sym_store: ref void,
    uri: ref u8,
    text: ref u8,
    run_now: bool
) void = trust {
    if uri == none || text == none {
        return
    }
    val text_copy: ref u8 = raw_dup_cstr_h(text)
    if text_copy == none {
        return
    }

    if coll.StringMap.get(doc_store, uri) is some old_v {
        val old: ref u8 = @bitcast(old_v, ref void) as ref u8
        if old != none {
            @free(old)
        }
    }

    val alloc: allocators.HeapAllocator = @zeroed

    val tv: usize = @bitcast(text_copy, usize)
    coll.StringMap.set[allocators.HeapAllocator](alloc, doc_store, uri, tv)

    if coll.StringMap.get(sym_store, uri) is some old_v {
        val old_syms: mut ref void = @bitcast(old_v, ref void)
        if old_syms != none {
            lsp_parser.free_sym_list(old_syms)
        }
    }

    val file_path: ref u8 = lsp_parser.uri_to_path(uri)
    val syms: ref void = lsp_parser.parse_file(file_path, text_copy)
    if file_path != none {
        @free(file_path)
    }

    if syms != none {
        val sv: usize = @bitcast(syms, usize)
        coll.StringMap.set[_](alloc, sym_store, uri, sv)
    }

    if run_now {
        clear_pending()
        send_diagnostics(uri, text_copy)
    } else {
        // Don't lose a pending check when the user switches files.
        if g_pending_uri != none && cstr.cmp(g_pending_uri, uri) != 0 {
            run_pending_check(doc_store)
        }
        set_pending(uri)
    }
}

pub fn handle_did_open(
    doc_store: mut ref void,
    sym_store: mut ref void,
    params: ref void
) void = trust {
    if params == none {
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val text: ref u8 = get_str_field(td_obj, "text")
    if uri == none || text == none {
        return
    }
    update_document(doc_store, sym_store, uri, text, true)
}

pub fn handle_did_save(doc_store: ref void, params: ref void) void = trust {
    if params == none {
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    if uri == none {
        return
    }
    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content != none {
        clear_pending()
        send_diagnostics(uri, content)
    }
}

pub fn handle_did_change(
    doc_store: mut ref void,
    sym_store: mut ref void,
    params: ref void
) void = trust {
    if params == none {
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    if td_obj == none {
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    if uri == none {
        return
    }

    val changes: mut ref void = none
    if json.obj_get(params, c"contentChanges") is some v {
        if json.val_is_array(v) {
            changes = v
        }
    }
    if changes == none {
        return
    }

    val last_idx: usize = json.arr_len(changes)
    if last_idx == 0 {
        return
    }
    if json.arr_get(changes, last_idx - 1) is some ch {
        val text: ref u8 = get_str_field(ch, "text")
        if text != none {
            update_document(doc_store, sym_store, uri, text, false)
        }
    }
}

pub fn dispatch(
    doc_store: mut ref void,
    sym_store: mut ref void,
    msg: ref u8
) void = trust {
    val doc_opt = json.parse(str.from_cstr(msg))
    match doc_opt {
        none => {
            return
        }
        some doc => {
            val root: ref void = json.doc_root(doc)

            val method: mut ref u8 = none
            match json.obj_get_str(root, c"method") {
                some m => {
                    method = m
                }
                none => {
                    json.doc_free(doc)
                    return
                }
            }

            val id_raw: mut ref void = none
            if json.obj_get(root, c"id") is some v {
                id_raw = v
            }

            val params: mut ref void = none
            if json.obj_get(root, c"params") is some p {
                params = p
            }

            val mlen: i64 = cstr.len(method)

            if mlen == 10 && starts_with_h(str.view(method, mlen), "initialize") {
                handle_initialize(id_raw)
            } elif mlen == 18 && starts_with_h(str.view(method, mlen), "textDocument/hover") {
                handle_hover(doc_store, sym_store, id_raw, params)
            } elif mlen == 23 && starts_with_h(str.view(method, mlen), "textDocument/completion") {
                handle_completion(doc_store, sym_store, id_raw, params)
            } elif mlen == 23 && starts_with_h(str.view(method, mlen), "textDocument/definition") {
                handle_definition(doc_store, sym_store, id_raw, params)
            } elif mlen == 27 && starts_with_h(
                str.view(method, mlen),
                "textDocument/documentSymbol"
            ) {
                handle_document_symbol(doc_store, sym_store, id_raw, params)
            } elif mlen == 26 && starts_with_h(
                str.view(method, mlen),
                "textDocument/signatureHelp"
            ) {
                handle_signature_help(doc_store, sym_store, id_raw, params)
            } elif mlen == 20 && starts_with_h(str.view(method, mlen), "textDocument/didOpen") {
                handle_did_open(doc_store, sym_store, params)
            } elif mlen == 22 && starts_with_h(str.view(method, mlen), "textDocument/didChange") {
                handle_did_change(doc_store, sym_store, params)
            } elif mlen == 20 && starts_with_h(str.view(method, mlen), "textDocument/didSave") {
                handle_did_save(doc_store, params)
            } elif mlen == 8 && starts_with_h(str.view(method, mlen), "shutdown") {
                send_null_result(id_raw)
            }

            json.doc_free(doc)
        }
    }
}

fn base_names_type(base: ref u8, type_name: ref u8) bool = trust {
    if base == none || type_name == none {
        return false
    }
    val blen: i64 = cstr.len(base)
    val last_dot: mut i64 = -1
    val i: mut i64 = 0
    for {
        if i >= blen {
            break
        }
        if @load8(@ptradd(base, i)) == '.' {
            last_dot = i
        }
        i++
    }
    val start: i64 = last_dot + 1
    val seg_len: i64 = blen - start
    return seg_len == cstr.len(type_name) &&
    strncmp(@ptradd(base, start), type_name, seg_len as usize) == 0
}

fn append_keyword_completions(
    sb: builder.StringBuilder,
    first: ref i64,
    prefix: ref u8,
    replace_line: i64,
    replace_start: i64,
    replace_end: i64
) void = trust {
    val i: mut i64 = 0
    for {
        if i >= 64 {
            break
        }
        val kw: ref u8 = keyword_at(i)
        if kw == none {
            break
        }
        if prefix_matches_h(str.from_cstr(kw), str.from_cstr(prefix)) {
            append_completion_item(
                sb, first, kw, keyword_signature(str.from_cstr(kw)), keyword_description(str.from_cstr(kw)),
                14, replace_line, replace_start, replace_end
            )
        }
        i++
    }
}

pub fn handle_completion(
    doc_store: mut ref void,
    sym_store: mut ref void,
    id_raw: ref void,
    params: ref void
) void = trust {
    if params == none {
        send_null_result(id_raw)
        return
    }
    val td_obj: ref void = get_obj_field(params, "textDocument")
    val pos_obj: ref void = get_obj_field(params, "position")
    if td_obj == none || pos_obj == none {
        send_null_result(id_raw)
        return
    }
    val uri: ref u8 = get_str_field(td_obj, "uri")
    val line: i64 = get_int_field(pos_obj, "line")
    val col: i64 = get_int_field(pos_obj, "character")
    if uri == none {
        send_null_result(id_raw)
        return
    }

    val content: mut ref u8 = none
    if coll.StringMap.get(doc_store, uri) is some v {
        content = @bitcast(v, ref void) as ref u8
    }
    if content == none {
        send_null_result(id_raw)
        return
    }
    val file_path: ref u8 = lsp_parser.uri_to_path(uri)

    val start: mut i64 = -1
    val end: mut i64 = -1
    val has_dot: mut i64 = 0
    val base_start: mut i64 = -1
    val base_len: mut i64 = 0
    find_completion_context(
        content, line, col,
        @addr(start), @addr(end), @addr(has_dot), @addr(base_start), @addr(base_len)
    )
    if start < 0 || end < start {
        send_null_result(id_raw)
        return
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_for_line_h(content, line, @addr(ls), @addr(le))
    val replace_start: i64 = start - ls
    val replace_end: i64 = end - ls

    val prefix: mut ref u8 = none
    if end > start {
        prefix = raw_dup_h(@ptradd(content, start), end - start)
    }
    val base: mut ref u8 = none
    if has_dot == 1 && base_start >= 0 && base_len > 0 {
        base = raw_dup_h(@ptradd(content, base_start), base_len)
    }

    val sb: builder.StringBuilder = builder.StringBuilder.new()
    make_base(sb, id_raw)
    builder.StringBuilder.append(sb, ",\"result\":{\"isIncomplete\":false,\"items\":[")
    val first: mut i64 = 1

    if has_dot == 1 && base != none {
        val handled: mut bool = false
        val base_has_dot: bool = contains_substr_h(str.from_cstr(base), ".")

        if !base_has_dot {
            val mod_syms: ref void = module_syms_for_alias(
                doc_store,
                sym_store,
                uri,
                file_path,
                base
            )
            if mod_syms != none {
                handled = true
                val n: usize = coll.PtrList.len(mod_syms)
                val mi: mut usize = 0
                for {
                    if mi >= n {
                        break
                    }
                    if coll.PtrList.get(mod_syms, mi) is some v {
                        val sym: ref lsp_parser.Symbol = @bitcast(
                            v,
                            ref void
                        ) as ref lsp_parser.Symbol
                        append_symbol_completion(
                            sb,
                            @addr(first),
                            sym,
                            prefix,
                            line,
                            replace_start,
                            replace_end
                        )
                    }
                    mi++
                }
            }
        }

        if !handled {
            val type_sym: mut ref lsp_parser.Symbol = resolve_type_symbol(
                doc_store, sym_store, uri, file_path, base, 0
            )
            if type_sym == none {
                type_sym = resolve_chain_type_symbol(
                    doc_store, sym_store, uri, file_path, content, line, start, base, 0
                )
            }
            if type_sym != none {
                handled = true
                if !base_names_type(base, type_sym.name) {
                    append_field_completions(
                        sb, @addr(first), doc_store, sym_store, type_sym, prefix,
                        line, replace_start, replace_end
                    )
                }
                append_method_completions(
                    sb, @addr(first), sym_store, doc_store, type_sym, prefix,
                    line, replace_start, replace_end
                )
            }
        }
    } else {
        val cur_syms: mut ref void = none
        if coll.StringMap.get(sym_store, uri) is some v {
            cur_syms = @bitcast(v, ref void)
        }
        if cur_syms != none {
            val n: usize = coll.PtrList.len(cur_syms)
            val i: mut usize = 0
            for {
                if i >= n {
                    break
                }
                if coll.PtrList.get(cur_syms, i) is some v {
                    val sym: ref lsp_parser.Symbol = @bitcast(v, ref void) as ref lsp_parser.Symbol
                    append_symbol_completion(
                        sb,
                        @addr(first),
                        sym,
                        prefix,
                        line,
                        replace_start,
                        replace_end
                    )
                }
                i++
            }
        }
        append_keyword_completions(sb, @addr(first), prefix, line, replace_start, replace_end)
    }

    builder.StringBuilder.append(sb, "]}}")
    val built: str.String = builder.StringBuilder.build(sb)
    write_response(owned_view(built))
    ostr.free(built)
    builder.StringBuilder.free(sb)

    if prefix != none {
        @free(prefix)
    }
    if base != none {
        @free(base)
    }
    if file_path != none {
        @free(file_path)
    }
}
