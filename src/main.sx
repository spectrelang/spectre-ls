val coll       = use("std/collections")
val stdio      = use("std/stdio")
val str        = use("std/string")
val cstr       = use("std/string/cstr")
val allocators = use("std/allocators")
val handlers   = use("./handlers")
val lsp_parser = use("./parser")
val json       = use("std/json")
val time       = use("std/time")

extern (C) fn fread(buf: ref void, size: usize, count: usize, stream: ref void) usize = "fread"
extern (C) fn setvbuf(stream: ref void, buf: ref u8, mode: i32, size: usize) i32 = "setvbuf"

type PollFd = {
    fd: mut i32
    events: mut i16
    revents: mut i16
}

when posix {
    extern (C) fn poll(fds: ref PollFd, nfds: u64, timeout: i32) i32 = "poll"
}

/// Wait for stdin activity, or for the debounce timeout to expire.
fn wait_for_input(timeout_ms: i32) i32 = trust {
    val result: mut i32 = 1
    when posix {
        val pfd: mut PollFd = @zeroed
        pfd.fd = 0
        pfd.events = 1
        pfd.revents = 0
        result = poll(@addr(pfd), 1 as u64, timeout_ms)
    }
    when windows {
        if timeout_ms == 0 {
            result = 0
        }
    }
    return result
}

val g_doc_store: mut ref void = none
val g_sym_store: mut ref void = none

fn atoi_raw(s: str.StringView) i64 = trust {
    val v: mut i64 = 0
    val i: mut i64 = 0
    for {
        if i >= s.len {
            break
        }
        val c: u8 = @load8(@ptradd(s.ptr, i))
        if c < '0' || c > '9' {
            break
        }
        v = v * 10 + (c as i64 - 48)
        i++
    }
    return v
}

fn is_help_flag(arg: str.StringView) bool = {
    return trust (str.eql(arg, "-h") || str.eql(arg, "-help") || str.eql(arg, "--help"))
}

fn print_help() void = {
    stdio.puts("spectre-ls - Spectre language server")
    stdio.puts("")
    stdio.puts("Usage:")
    stdio.puts("  spectre-ls [options]")
    stdio.puts("")
    stdio.puts("Options:")
    stdio.puts("  -h, -help    Show this help message and exit")
    stdio.puts("")
    stdio.puts("Without options, spectre-ls communicates over stdio using the")
    stdio.puts("Language Server Protocol.")
}

fn read_message() option[ref u8] = trust {
    val line_buf: ref u8 = @alloc(4096) as ref u8
    if line_buf == none {
        return none
    }
    val content_length: mut i64 = -1

    for {
        val r: ref u8 = stdio.read_line(line_buf, 4096)
        if r == none {
            @free(line_buf)
            return none
        }
        val line: str.StringView = str.from_cstr(line_buf)
        if str.is_empty(line) {
            break
        }
        if str.eql(line, "\n") || str.eql(line, "\r\n") {
            break
        }
        if str.starts_with(line, "Content-Length: ") {
            content_length = atoi_raw(str.slice(line, 16, line.len))
        }
    }

    @free(line_buf)

    if content_length <= 0 {
        return none
    }

    val body: ref u8 = @alloc(content_length + 1) as ref u8
    if body == none {
        return none
    }

    val bytes_read: mut i64 = 0
    val remaining: mut i64 = content_length
    for {
        if remaining <= 0 {
            break
        }
        val chunk: usize = fread(
            @ptradd(body, bytes_read) as ref void,
            1 as usize,
            remaining as usize,
            @stdin()
        )
        if chunk == 0 {
            break
        }
        bytes_read = bytes_read + chunk as i64
        remaining = remaining - chunk as i64
    }

    @store8(@ptradd(body, bytes_read), 0)

    if bytes_read == 0 {
        @free(body)
        return none
    }

    return some body
}

pub fn main() void = trust {
    val args = @args()
    for arg in args {
        if is_help_flag(str.from_cstr(arg)) {
            print_help()
            return
        }
    }

    val ac: allocators.HeapAllocator = @zeroed
    g_doc_store = coll.StringMap.new[_](ac, 64 as usize)
    g_sym_store = coll.StringMap.new[_](ac, 64 as usize)

    if g_doc_store == none || g_sym_store == none {
        stdio.eputs("spectre-ls: failed to initialize stores")
        return
    }

    // Unbuffered stdin keeps `poll` in sync with the bytes we still have to
    // consume; otherwise stdio may read subsequent messages ahead of us.
    when posix {
        setvbuf(@stdin(), none, 2 as i32, 0 as usize)
    }

    for {
        val due: i64 = handlers.pending_due_ns()
        val timeout: mut i32 = -1
        if due > 0 {
            val now: i64 = time.now_ns()
            if now >= due {
                handlers.run_pending_check(g_doc_store)
            } else {
                val remain: i64 = due - now
                val ms: i64 = (remain + 999999) / 1000000
                timeout = ms as i32
                if timeout < 1 {
                    timeout = 1
                }
            }
        }

        val ready: i32 = wait_for_input(timeout)
        if ready == 0 {
            continue
        }
        if ready < 0 {
            break
        }

        val msg_opt = read_message()
        match msg_opt {
            none => {
                break
            }
            some msg => {
                handlers.dispatch(g_doc_store, g_sym_store, msg)
                @free(msg as ref void)
            }
        }
    }

    // The server exits immediately after this loop.  The language runtime and
    // OS reclaim the remaining document/symbol storage; freeing the maps here
    // is unsafe because they contain owned strings and symbol lists.
}

test {
    val src: ref u8 = c"val x_instance: X = @zeroed\nx_instance.x = 3\n"
    val ws: mut i64 = -1
    val wl: mut i64 = 0

    // Cursor in the middle of a word.
    trust lsp_parser.find_word_at(src, 0, 8, @addr(ws), @addr(wl))
    assert ws == 4
    assert wl == 10

    // Cursor immediately after a word (common from editors) still resolves it.
    trust lsp_parser.find_word_at(src, 0, 14, @addr(ws), @addr(wl))
    assert ws == 4
    assert wl == 10

    // Cursor on the dot resolves the name on the left.
    trust lsp_parser.find_word_at(src, 1, 10, @addr(ws), @addr(wl))
    assert ws == 28
    assert wl == 10

    // Field name on the second line.
    trust lsp_parser.find_word_at(src, 1, 11, @addr(ws), @addr(wl))
    assert ws == 39
    assert wl == 1
}

test {
    val src: ref u8 = c"outer.inner.z"
    val ws: mut i64 = -1
    val wl: mut i64 = 0
    trust lsp_parser.find_word_at(src, 0, 12, @addr(ws), @addr(wl))
    assert ws == 12
    assert wl == 1

    val ms: mut i64 = -1
    val ml: mut i64 = 0
    trust lsp_parser.find_dot_prefix(src, ws, @addr(ms), @addr(ml))
    assert ms == 0
    assert ml == 11

    val src2: ref u8 = c"m.Point"
    trust lsp_parser.find_word_at(src2, 0, 3, @addr(ws), @addr(wl))
    trust lsp_parser.find_dot_prefix(src2, ws, @addr(ms), @addr(ml))
    assert ms == 0
    assert ml == 1
}

test {
    val content: ref u8 = c"type Point = {\n    /// horizontal coordinate\n    x: i32\n    y: mut f64\n    invariant { x > 0 }\n}\n"

    val fields: mut ref void = trust lsp_parser.parse_type_fields(content, c"test.sx", 0)
    assert fields != none
    assert coll.PtrList.len(fields) == 2

    match coll.PtrList.get(fields, 0 as usize) {
        some v => {
            val f: ref lsp_parser.Symbol = trust @bitcast(v, ref void) as ref lsp_parser.Symbol
            assert cstr.cmp(f.name, c"x") == 0
            assert cstr.cmp(f.ret_type, c"i32") == 0
            assert f.line == 2
            assert f.col == 4
            assert f.doc != none
        }
        none => {
            assert false
        }
    }

    match coll.PtrList.get(fields, 1 as usize) {
        some v => {
            val f: ref lsp_parser.Symbol = trust @bitcast(v, ref void) as ref lsp_parser.Symbol
            assert cstr.cmp(f.name, c"y") == 0
            assert cstr.cmp(f.ret_type, c"mut f64") == 0
        }
        none => {
            assert false
        }
    }
    trust lsp_parser.free_sym_list(fields)
}

test "keyword detection" {
    assert trust handlers.is_keyword("for")
    assert trust handlers.is_keyword("fn")
    assert trust handlers.is_keyword("type")
    assert !trust handlers.is_keyword("x_instance")
    assert trust handlers.keyword_description("for") != none
    assert trust handlers.keyword_signature("fn") != none
}

test "intrinsic detection" {
    val sa: allocators.ScopedArenaAllocator = trust allocators.ScopedArena.new(65536 as usize)?
    val la: allocators.ListArena = {arena: sa}
    val names: list[str.StringView] = @list(
        la,
        "fmtalloc", "len", "addr", "deref", "alloc", "free", "memcpy", "memset",
        "memmove", "puts", "print", "zeroed", "args", "bitcast", "load",
        "load8", "call", "snprintf", "dprintf", "reserve", "get", "insert",
        "capacity", "ptradd", "store", "store8", "staticerror", "flush",
        "stdin", "stdout", "fgets", "atoi", "itoa"
    )?
    for name in names {
        assert trust handlers.is_intrinsic_word(name)
        assert trust handlers.intrinsic_signature(name) != none
        assert trust handlers.intrinsic_description(name) != none
    }
    assert !trust handlers.is_intrinsic_word("not_an_intrinsic")
    trust allocators.ScopedArena.free(sa)
}

test {
    val decl: ref u8 = c"val x_instance: mut X = @zeroed"
    val ty: ref u8 = trust handlers.decl_explicit_type(decl)
    assert ty != none
    assert cstr.cmp(ty, c"mut X") == 0
    trust @free(ty)

    val param: ref u8 = trust handlers.extract_param_type(c"value: ref u8")
    assert param != none
    assert cstr.cmp(param, c"ref u8") == 0
    trust @free(param)

    val inferred_decl: ref u8 = c"val p = X.new()"
    val init: ref u8 = trust handlers.decl_initializer(inferred_decl)
    assert init != none
    assert cstr.cmp(init, c"X.new()") == 0

    val inferred: ref u8 = trust handlers.infer_expr_type_name(init)
    assert inferred != none
    assert cstr.cmp(inferred, c"X.new") == 0
    trust @free(init)
    trust @free(inferred)

    val wrapped: ref u8 = trust handlers.infer_expr_type_name(c"some mod.Type.new(1, 2)")
    assert wrapped != none
    assert cstr.cmp(wrapped, c"mod.Type.new") == 0
    trust @free(wrapped)
}

test {
    val src: ref u8 = c"    x_instance.\n    x_instance.x\n"
    val start: mut i64 = -1
    val end: mut i64 = -1
    val has_dot: mut i64 = 0
    val base_start: mut i64 = -1
    val base_len: mut i64 = 0

    trust handlers.find_completion_context(
        src, 0, 15,
        @addr(start), @addr(end), @addr(has_dot), @addr(base_start), @addr(base_len)
    )
    assert has_dot == 1
    assert start == 15
    assert end == 15
    assert base_start == 4
    assert base_len == 10

    trust handlers.find_completion_context(
        src, 1, 16,
        @addr(start), @addr(end), @addr(has_dot), @addr(base_start), @addr(base_len)
    )
    assert has_dot == 1
    assert start == 31
    assert end == 32
    assert base_start == 20
    assert base_len == 10

    trust handlers.find_completion_context(
        src, 1, 7,
        @addr(start), @addr(end), @addr(has_dot), @addr(base_start), @addr(base_len)
    )
    assert has_dot == 0
    assert start == 20
    assert end == 23
}

test {
    val doc = trust json.parse("{\"jsonrpc\":\"2.0\"}")
    match doc {
        some d => {
            trust json.doc_free(d)
        }
        none => {
            assert false
        }
    }
}

test {
    assert is_help_flag("-h")
    assert is_help_flag("--help")
    assert !is_help_flag("--version")
    assert !is_help_flag("")
}
