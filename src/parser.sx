val str        = use("std/string")
val coll       = use("std/collections")
val allocators = use("std/allocators")

extern (C) fn strncmp(a: ref u8, b: ref u8, n: usize) i32 = "strncmp"

pub val SYM_FUNCTION: i64 = 0
pub val SYM_METHOD: i64 = 1
pub val SYM_TYPE: i64 = 2
pub val SYM_ENUM: i64 = 3
pub val SYM_UNION: i64 = 4
pub val SYM_VARIABLE: i64 = 5
pub val SYM_MODULE: i64 = 6
pub val SYM_FIELD: i64 = 7

pub type Symbol = {
    name: mut ref u8
    kind: mut i64
    receiver: mut ref u8
    signature: mut ref u8
    doc: mut ref u8
    file: mut ref u8
    line: mut i64
    col: mut i64
    ret_type: mut ref u8
    params: mut ref void
    param_count: mut i64
}

pub type CallContext = {
    fn_name: mut ref u8
    param_idx: mut i64
    qualifier: mut ref u8
    is_intrinsic: mut i64
}

pub type UnusedVariable = {
    name: mut ref u8
    line: mut i64
    col: mut i64
}

val TOK_IDENT: i64 = 0
val TOK_PUNCT: i64 = 1

type ScanToken = {
    start: mut i64
    len: mut i64
    line: mut i64
    col: mut i64
    depth: mut i64
    owner: mut i64
    kind: mut i64
    is_decl: mut i64
    ch: mut u8
}

type VarCandidate = {
    name: mut ref u8
    line: mut i64
    col: mut i64
    token_index: mut i64
    depth: mut i64
    owner: mut i64
    is_public: mut i64
}

pub fn sym_alloc() ref Symbol = trust {
    val s: ref void = @alloc(88)
    if s == none {
        return none
    }
    @memset(s, 0, 88)
    return s as ref Symbol
}

pub fn sym_free(s: mut ref Symbol, alloc: allocators.HeapAllocator) void = trust {
    if s == none {
        return
    }
    if s.name != none {
        @free(s.name as ref void)
    }
    if s.receiver != none {
        @free(s.receiver as ref void)
    }
    if s.signature != none {
        @free(s.signature as ref void)
    }
    if s.doc != none {
        @free(s.doc as ref void)
    }
    if s.file != none {
        @free(s.file as ref void)
    }
    if s.ret_type != none {
        @free(s.ret_type as ref void)
    }
    if s.params != none {
        coll.PtrList.free[_](alloc, s.params)
    }
    @free(s as ref void)
}

pub fn free_sym_list(list: mut ref void) void = trust {
    if list == none {
        return
    }
    val n: usize = coll.PtrList.len(list)
    val i: mut usize = 0
    val alloc: allocators.HeapAllocator = @zeroed
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(list, i) is some v {
            val sym: mut ref Symbol = @bitcast(v, ref void) as ref Symbol
            sym_free(sym, alloc)
        }
        i++
    }
    coll.PtrList.free[_](alloc, list)
}

fn raw_dup(s: ref u8, len: i64) ref u8 = trust {
    if s == none || len <= 0 {
        return none
    }
    val buf: ref u8 = @alloc(len + 1) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf as ref void, s as ref void, len as usize)
    @store8(@ptradd(buf, len), 0)
    return buf
}

fn raw_dup_cstr(s: ref u8) ref u8 = trust {
    if s == none {
        return none
    }
    val len: i64 = str.len_raw(s)
    if len == 0 {
        return none
    }
    return raw_dup(s, len)
}

fn starts_with_n(s: ref u8, s_len: i64, prefix: ref u8, p_len: i64) bool = trust {
    if p_len > s_len || p_len <= 0 {
        return false
    }
    val r: i32 = strncmp(s, prefix, p_len as usize)
    return r == 0
}

fn skip_ws(s: ref u8, i: i64, len: i64) i64 = trust {
    val j: mut i64 = i
    for {
        if j >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, j))
        if c != ' ' && c != '\t' {
            break
        }
        j++
    }
    return j
}

fn is_ident_start(c: u8) bool = {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_cont(c: u8) bool = {
    return is_ident_start(c) || (c >= 48 && c <= 57)
}

fn ident_len_at(s: ref u8, i: i64, len: i64) i64 = trust {
    if i >= len {
        return 0
    }
    val c0: u8 = @load8(@ptradd(s, i))
    if !is_ident_start(c0) {
        return 0
    }
    val j: mut i64 = i + 1
    for {
        if j >= len {
            break
        }
        if !is_ident_cont(@load8(@ptradd(s, j))) {
            break
        }
        j++
    }
    return j - i
}

fn is_blank_line(line: ref u8, line_len: i64) bool = trust {
    val i: mut i64 = 0
    for {
        if i >= line_len {
            return true
        }
        val c: u8 = @load8(@ptradd(line, i))
        if c != ' ' && c != '\t' && c != '\r' {
            return false
        }
        i++
    }
    return true
}

fn trim_right_len(s: ref u8, len: i64) i64 = trust {
    val n: mut i64 = len
    for {
        if n <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(s, n - 1))
        if c != ' ' && c != '\t' && c != '\r' {
            break
        }
        n--
    }
    return n
}

fn parse_params(params: ref u8, params_len: i64) ref void = trust {
    val list: mut ref void = none
    val alloc: allocators.HeapAllocator = @zeroed
    val list_res = coll.PtrList.new[_](alloc, 8 as usize)

    match list_res {
        ok l => {
            list = l
        }
        err _ => {
            return none
        }
    }
    if params == none || params_len <= 0 {
        return list
    }

    val i: mut i64 = 0
    val param_start: mut i64 = 0
    val depth: mut i64 = 0

    for {
        val emit: mut i64 = 0
        val at_end: bool = (i >= params_len)

        if at_end {
            if i > param_start {
                emit = 1
            }
        } else {
            val c: u8 = @load8(@ptradd(params, i))
            if c == '[' {
                depth = depth + 1
            }
            elif c == ']' {
                if depth > 0 {
                    depth = depth - 1
                }
            }
            elif c == ',' && depth == 0 {
                emit = 1
            }
        }

        if emit == 1 {
            val s: mut i64 = param_start
            val e: mut i64 = i
            for {
                if s >= e {
                    break
                }
                val c: u8 = @load8(@ptradd(params, s))
                if c != ' ' && c != '\t' {
                    break
                }
                s = s + 1
            }
            for {
                if e <= s {
                    break
                }
                val c: u8 = @load8(@ptradd(params, e - 1))
                if c != ' ' && c != '\t' {
                    break
                }
                e = e - 1
            }
            if e > s {
                val p: ref u8 = raw_dup(@ptradd(params, s), e - s)
                if p != none {
                    val pv: usize = @bitcast(p as ref void, usize)
                    val pr = coll.PtrList.push[_](alloc, list, pv)
                    match pr {
                        ok _ => {}
                        err _ => {}
                    }
                }
            }
            param_start = i + 1
        }

        if at_end {
            break
        }
        i++
    }
    return list
}

fn parse_fn_decl(
    rest: ref u8, rest_len: i64,
    line_num: i64, file: ref u8, doc: ref u8,
    full_line: ref u8, full_line_len: i64
) ref Symbol = trust {
    val i: mut i64 = 3
    i = skip_ws(rest, i, rest_len)

    val sym: mut ref Symbol = sym_alloc()
    if sym == none {
        return none
    }
    sym.line = line_num
    sym.col = 0
    sym.kind = SYM_FUNCTION
    sym.file = raw_dup_cstr(file)
    sym.doc = raw_dup_cstr(doc)

    if i < rest_len && @load8(@ptradd(rest, i)) == '(' {
        i++
        val recv_start: i64 = i
        for {
            if i >= rest_len {
                break
            }
            if @load8(@ptradd(rest, i)) == ')' {
                break
            }
            i++
        }
        sym.receiver = raw_dup(@ptradd(rest, recv_start), i - recv_start)
        sym.kind = SYM_METHOD
        if i < rest_len {
            i++
        }
        i = skip_ws(rest, i, rest_len)
    }

    val name_len: i64 = ident_len_at(rest, i, rest_len)
    if name_len == 0 {
        val alloc: allocators.HeapAllocator = @zeroed
        sym_free(sym, alloc)
        return none
    }
    sym.col = i
    sym.name = raw_dup(@ptradd(rest, i), name_len)
    i = i + name_len

    i = skip_ws(rest, i, rest_len)
    if i < rest_len && @load8(@ptradd(rest, i)) == '(' {
        i++
        val params_start: i64 = i
        val depth: mut i64 = 1
        for {
            if i >= rest_len {
                break
            }
            val c: u8 = @load8(@ptradd(rest, i))
            if c == '(' {
                depth = depth + 1
            }
            elif c == ')' {
                depth = depth - 1
                if depth == 0 {
                    break
                }
            }
            i++
        }
        val plen: i64 = i - params_start
        if plen > 0 {
            val params_raw: ref u8 = raw_dup(@ptradd(rest, params_start), plen)
            sym.params = parse_params(params_raw, plen)
            sym.param_count = coll.PtrList.len(sym.params) as i64
            @free(params_raw as ref void)
        }
        if i < rest_len {
            i++
        }
    }

    i = skip_ws(rest, i, rest_len)
    val ret_start: i64 = i
    for {
        if i >= rest_len {
            break
        }
        if i + 1 < rest_len {
            val c0: u8 = @load8(@ptradd(rest, i))
            val c1: u8 = @load8(@ptradd(rest, i + 1))
            if c0 == ' ' && c1 == '=' {
                break
            }
        }
        i++
    }
    val ret_len: i64 = trim_right_len(@ptradd(rest, ret_start), i - ret_start)
    sym.ret_type = raw_dup(@ptradd(rest, ret_start), ret_len)

    val sig_end: mut i64 = 0
    for {
        if sig_end >= full_line_len {
            break
        }
        if sig_end + 1 < full_line_len {
            val c0: u8 = @load8(@ptradd(full_line, sig_end))
            val c1: u8 = @load8(@ptradd(full_line, sig_end + 1))
            if c0 == ' ' && c1 == '=' {
                break
            }
        }
        sig_end = sig_end + 1
    }
    val sig_trimmed: i64 = trim_right_len(full_line, sig_end)
    sym.signature = raw_dup(full_line, sig_trimmed)

    return sym
}

fn parse_kw_decl(
    rest: ref u8, rest_len: i64,
    kw_len: i64, kind: i64,
    line_num: i64, file: ref u8, doc: ref u8,
    full_line: ref u8, full_line_len: i64
) ref Symbol = trust {
    val i: mut i64 = kw_len
    i = skip_ws(rest, i, rest_len)

    if i < rest_len && @load8(@ptradd(rest, i)) == '(' {
        for {
            if i >= rest_len {
                break
            }
            if @load8(@ptradd(rest, i)) == ')' {
                i++ break
            }
            i++
        }
        i = skip_ws(rest, i, rest_len)
    }

    val name_len: i64 = ident_len_at(rest, i, rest_len)
    if name_len == 0 {
        return none
    }

    val sym: mut ref Symbol = sym_alloc()
    if sym == none {
        return none
    }
    sym.name = raw_dup(@ptradd(rest, i), name_len)
    sym.kind = kind
    sym.line = line_num
    sym.col = i
    sym.file = raw_dup_cstr(file)
    sym.doc = raw_dup_cstr(doc)
    val sig_len: i64 = trim_right_len(full_line, full_line_len)
    sym.signature = raw_dup(full_line, sig_len)
    return sym
}

fn parse_import_decl(
    line: ref u8, line_len: i64,
    line_num: i64, file: ref u8
) ref Symbol = trust {
    val i: mut i64 = 4
    i = skip_ws(line, i, line_len)
    val name_len: i64 = ident_len_at(line, i, line_len)
    if name_len == 0 {
        return none
    }
    val alias_col: i64 = i
    val alias: ref u8 = raw_dup(@ptradd(line, i), name_len)
    i = i + name_len
    i = skip_ws(line, i, line_len)

    if !starts_with_n(@ptradd(line, i), line_len - i, "= use(\"", 7) {
        @free(alias as ref void)
        return none
    }
    i = i + 7
    val path_start: i64 = i
    for {
        if i >= line_len {
            break
        }
        if @load8(@ptradd(line, i)) == '"' {
            break
        }
        i++
    }
    val path: ref u8 = raw_dup(@ptradd(line, path_start), i - path_start)

    val sym: mut ref Symbol = sym_alloc()
    if sym == none {
        @free(alias as ref void)
        @free(path as ref void)
        return none
    }
    sym.name = alias
    sym.kind = SYM_MODULE
    sym.line = line_num
    sym.col = alias_col
    sym.file = raw_dup_cstr(file)
    sym.ret_type = path
    val sig_len: i64 = trim_right_len(line, line_len)
    sym.signature = raw_dup(line, sig_len)
    return sym
}

fn parse_val_decl(
    line: ref u8, line_len: i64,
    line_num: i64, file: ref u8, doc: ref u8,
    full_line: ref u8, full_line_len: i64
) ref Symbol = trust {
    val i: mut i64 = 3
    i = skip_ws(line, i, line_len)
    val name_len: i64 = ident_len_at(line, i, line_len)
    if name_len == 0 {
        return none
    }

    val sym: mut ref Symbol = sym_alloc()
    if sym == none {
        return none
    }
    sym.name = raw_dup(@ptradd(line, i), name_len)
    sym.kind = SYM_VARIABLE
    sym.line = line_num
    sym.col = i
    sym.file = raw_dup_cstr(file)
    sym.doc = raw_dup_cstr(doc)
    i = i + name_len

    i = skip_ws(line, i, line_len)
    if i < line_len && @load8(@ptradd(line, i)) == ':' {
        i++
        i = skip_ws(line, i, line_len)
        val type_start: i64 = i
        val sq_depth: mut i64 = 0
        val paren_depth: mut i64 = 0
        for {
            if i >= line_len {
                break
            }
            val c: u8 = @load8(@ptradd(line, i))
            if c == '[' {
                sq_depth = sq_depth + 1
            }
            elif c == ']' {
                if sq_depth > 0 {
                    sq_depth = sq_depth - 1
                }
            }
            elif c == '(' {
                paren_depth = paren_depth + 1
            }
            elif c == ')' {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1
                }
            }
            elif c == '=' && sq_depth == 0 && paren_depth == 0 {
                break
            }
            i++
        }
        val type_len: i64 = trim_right_len(@ptradd(line, type_start), i - type_start)
        if type_len > 0 {
            sym.ret_type = raw_dup(@ptradd(line, type_start), type_len)
        }
    }

    val sig_len: i64 = trim_right_len(full_line, full_line_len)
    sym.signature = raw_dup(full_line, sig_len)
    return sym
}

fn process_line(
    line: ref u8, line_len: i64,
    line_num: i64, file: ref u8,
    doc_buf: str.String, has_doc: ref i64,
    nesting_depth: i64,
    syms: mut ref void
) void = trust {
    val alloc: allocators.HeapAllocator = @zeroed
    val i: i64 = skip_ws(line, 0, line_len)
    val trimmed: ref u8 = @ptradd(line, i)
    val tlen: i64 = line_len - i

    if nesting_depth != 0 {
        // Extern declarations are commonly wrapped in platform `when` blocks.
        // Let those through even though the surrounding block is otherwise
        // skipped.
        val decl: mut ref u8 = trimmed
        val dlen: mut i64 = tlen
        if starts_with_n(decl, dlen, "pub ", 4) {
            val poff: i64 = skip_ws(decl, 4, dlen)
            decl = @ptradd(decl, poff)
            dlen = dlen - poff
        }
        if !starts_with_n(decl, dlen, "extern ", 7) {
            str.clear(doc_buf)
            @store(has_doc as ref void, 0 as i64)
            return
        }
    }

    if tlen >= 3 &&
    @load8(@ptradd(trimmed, 0)) == '/' &&
    @load8(@ptradd(trimmed, 1)) == '/' &&
    @load8(@ptradd(trimmed, 2)) == '/' {
        val cs: mut i64 = 3
        if tlen > 3 && @load8(@ptradd(trimmed, 3)) == ' ' {
            cs = 4
        }
        val part: ref u8 = raw_dup(@ptradd(trimmed, cs), tlen - cs)
        if part != none {
            str.push_cstr(doc_buf, part)
            str.push_char(doc_buf, '\n')
            @free(part as ref void)
        }
        @store(has_doc as ref void, 1 as i64)
        return
    }

    if is_blank_line(line, line_len) {
        return
    }

    val doc_cstr: ref u8 = str.cstr(doc_buf)
    val sym: mut ref Symbol = none
    val rest: mut ref u8 = trimmed
    val rlen: mut i64 = tlen
    val col_offset: mut i64 = i

    if starts_with_n(trimmed, tlen, "pub ", 4) {
        val off: i64 = skip_ws(trimmed, 4, tlen)
        rest = @ptradd(trimmed, off)
        rlen = tlen - off
        col_offset = col_offset + off
    }

    // `extern [ABI] fn ...` and `extern type ...`.  The ABI part is optional
    // for types, so skip it before dispatching on the declaration keyword.
    if starts_with_n(rest, rlen, "extern ", 7) {
        val eoff: i64 = skip_ws(rest, 7, rlen)
        rest = @ptradd(rest, eoff)
        rlen = rlen - eoff
        col_offset = col_offset + eoff

        if starts_with_n(rest, rlen, "(", 1) {
            val depth: mut i64 = 0
            val j: mut i64 = 0
            for {
                if j >= rlen {
                    break
                }
                val c: u8 = @load8(@ptradd(rest, j))
                if c == '(' {
                    depth = depth + 1
                } elif c == ')' {
                    depth = depth - 1
                    if depth == 0 {
                        j = j + 1
                        break
                    }
                }
                j = j + 1
            }
            val aoff: i64 = skip_ws(rest, j, rlen)
            rest = @ptradd(rest, aoff)
            rlen = rlen - aoff
            col_offset = col_offset + aoff
        }
    }

    if starts_with_n(rest, rlen, "fn ", 3) {
        sym = parse_fn_decl(rest, rlen, line_num, file, doc_cstr, line, line_len)
    } elif starts_with_n(rest, rlen, "type ", 5) {
        sym = parse_kw_decl(rest, rlen, 5, SYM_TYPE, line_num, file, doc_cstr, line, line_len)
    } elif starts_with_n(rest, rlen, "enum ", 5) {
        sym = parse_kw_decl(rest, rlen, 5, SYM_ENUM, line_num, file, doc_cstr, line, line_len)
    } elif starts_with_n(rest, rlen, "union ", 6) {
        sym = parse_kw_decl(rest, rlen, 6, SYM_UNION, line_num, file, doc_cstr, line, line_len)
    } elif starts_with_n(rest, rlen, "val ", 4) {
        sym = parse_import_decl(rest, rlen, line_num, file)
        if sym == none {
            sym = parse_val_decl(rest, rlen, line_num, file, doc_cstr, line, line_len)
        }
    }

    if sym != none {
        sym.col = sym.col + col_offset
        val sv: usize = @bitcast(sym as ref void, usize)
        val pr = coll.PtrList.push[_](alloc, syms, sv)
        match pr {
            ok _ => {}
            err _ => {
                sym_free(sym, alloc)
            }
        }
        str.clear(doc_buf)
        @store(has_doc as ref void, 0 as i64)
    } else {
        str.clear(doc_buf)
        @store(has_doc as ref void, 0 as i64)
    }
}

pub fn parse_file(file_path: ref u8, content: ref u8) ref void = trust {
    val syms: mut ref void = none
    val alloc: allocators.HeapAllocator = @zeroed

    match coll.PtrList.new[_](alloc, 64 as usize) {
        ok l => {
            syms = l
        }
        err _ => {
            return none
        }
    }

    if content == none {
        return syms
    }

    val content_len: i64 = str.len_raw(content)
    val pos: mut i64 = 0
    val line_num: mut i64 = 0
    val doc_buf: mut str.String = str.new()
    val has_doc: mut i64 = 0
    val nesting_depth: mut i64 = 0

    for {
        if pos >= content_len {
            break
        }

        val line_start: i64 = pos
        val line_end: mut i64 = pos
        for {
            if line_end >= content_len {
                break
            }
            val c: u8 = @load8(@ptradd(content, line_end))
            if c == '\n' || c == '\r' {
                break
            }
            line_end = line_end + 1
        }

        process_line(
            @ptradd(content, line_start), line_end - line_start,
            line_num, file_path,
            doc_buf, @addr(has_doc), nesting_depth,
            syms
        )

        val j: mut i64 = line_start
        for {
            if j >= line_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, j))
            if c == '{' {
                nesting_depth = nesting_depth + 1
            } elif c == '}' {
                if nesting_depth > 0 {
                    nesting_depth = nesting_depth - 1
                }
            }
            j++
        }

        pos = line_end
        if pos < content_len {
            val c: u8 = @load8(@ptradd(content, pos))
            if c == '\r' {
                pos = pos + 1
            }
            if pos < content_len && @load8(@ptradd(content, pos)) == '\n' {
                pos = pos + 1
            }
        }
        line_num++
    }


    str.string_free(doc_buf)
    return syms
}

pub fn find_word_at(content: ref u8, line: i64, col: i64, out_start: ref i64, out_len: ref i64) void = trust {
    @store(out_start as ref void, -1 as i64)
    @store(out_len as ref void, 0 as i64)

    val content_len: i64 = str.len_raw(content)
    if content_len == 0 {
        return
    }

    val cur_line: mut i64 = 0
    val i: mut i64 = 0
    for {
        if cur_line >= line {
            break
        }
        if i >= content_len {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))
        if c == '\n' {
            cur_line = cur_line + 1
        }
        i++
    }

    val line_base: i64 = i
    val line_end: mut i64 = i
    for {
        if line_end >= content_len {
            break
        }
        val c: u8 = @load8(@ptradd(content, line_end))
        if c == '\n' || c == '\r' {
            break
        }
        line_end = line_end + 1
    }

    val probe: mut i64 = i + col
    if probe > line_end {
        probe = line_end
    }
    if probe >= line_end && line_end > line_base {
        probe = line_end - 1
    }
    if probe >= content_len {
        probe = content_len - 1
    }
    if probe < line_base {
        return
    }

    // LSP clients commonly send the position just *after* the identifier
    // (or on the dot/punctuation following it).  Looking only at the
    // character under the cursor makes hover/definition feel random, so fall
    // back to the identifier immediately to the left.
    val at_c: u8 = @load8(@ptradd(content, probe))
    if !is_ident_cont(at_c) {
        if probe > line_base && is_ident_cont(@load8(@ptradd(content, probe - 1))) {
            probe = probe - 1
        } else {
            return
        }
    }

    val char_pos: i64 = probe
    val ws: mut i64 = char_pos
    for {
        if ws <= line_base {
            break
        }
        if !is_ident_cont(@load8(@ptradd(content, ws - 1))) {
            break
        }
        ws = ws - 1
    }

    val we: mut i64 = char_pos + 1
    for {
        if we >= content_len {
            break
        }
        if !is_ident_cont(@load8(@ptradd(content, we))) {
            break
        }
        we = we + 1
    }

    @store(out_start as ref void, ws)
    @store(out_len as ref void, we - ws)
}

pub fn find_dot_prefix(content: ref u8, word_start: i64, out_mod: ref i64, out_mod_len: ref i64) void = trust {
    @store(out_mod as ref void, -1 as i64)
    @store(out_mod_len as ref void, 0 as i64)

    if word_start <= 0 {
        return
    }
    val prev: u8 = @load8(@ptradd(content, word_start - 1))
    if prev != '.' {
        return
    }

    val me: i64 = word_start - 1
    if me <= 0 {
        return
    }

    val ms: mut i64 = me
    for {
        val seg_end: i64 = ms
        for {
            if ms <= 0 {
                break
            }
            if !is_ident_cont(@load8(@ptradd(content, ms - 1))) {
                break
            }
            ms = ms - 1
        }
        if ms == seg_end {
            break
        }
        if ms > 0 && @load8(@ptradd(content, ms - 1)) == '.' {
            ms = ms - 1
        } else {
            break
        }
    }
    if me - ms <= 0 {
        return
    }
    @store(out_mod as ref void, ms)
    @store(out_mod_len as ref void, me - ms)
}

fn line_start_at(s: ref u8, idx: i64) i64 = trust {
    val j: mut i64 = idx
    for {
        if j <= 0 {
            break
        }
        if @load8(@ptradd(s, j - 1)) == '\n' {
            break
        }
        j = j - 1
    }
    return j
}

fn newline_count_between(s: ref u8, start: i64, end: i64) i64 = trust {
    val n: mut i64 = 0
    val i: mut i64 = start
    for {
        if i >= end {
            break
        }
        if @load8(@ptradd(s, i)) == '\n' {
            n = n + 1
        }
        i++
    }
    return n
}

pub fn line_bounds_raw(content: ref u8, target_line: i64, out_start: ref i64, out_end: ref i64) void = trust {
    @store(out_start as ref void, -1 as i64)
    @store(out_end as ref void, -1 as i64)
    if content == none || target_line < 0 {
        return
    }

    val len: i64 = str.len_raw(content)
    if len <= 0 {
        return
    }

    val cur: mut i64 = 0
    val i: mut i64 = 0
    val start: mut i64 = 0
    val found: mut i64 = 0
    for {
        if i > len {
            break
        }
        if cur == target_line {
            start = i
            found = 1
            break
        }
        if i >= len {
            break
        }
        if @load8(@ptradd(content, i)) == '\n' {
            cur = cur + 1
            start = i + 1
        }
        i++
    }
    if found == 0 {
        return
    }

    val end: mut i64 = start
    for {
        if end >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, end))
        if c == '\n' || c == '\r' {
            break
        }
        end = end + 1
    }
    @store(out_start as ref void, start)
    @store(out_end as ref void, end)
}

fn find_matching_close_raw(s: ref u8, len: i64, open_idx: i64, open_ch: u8, close_ch: u8) i64 = trust {
    if s == none || open_idx < 0 || open_idx >= len {
        return -1
    }
    val depth: mut i64 = 0
    val i: mut i64 = open_idx
    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == open_ch {
            depth = depth + 1
        } elif c == close_ch {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

fn make_field_sym(
    name: ref u8, name_len: i64,
    type_expr: ref u8, type_len: i64,
    doc: ref u8, file: ref u8,
    line: i64, col: i64
) ref Symbol = trust {
    val sym: mut ref Symbol = sym_alloc()
    if sym == none {
        return none
    }
    sym.name = raw_dup(name, name_len)
    sym.kind = SYM_FIELD
    sym.ret_type = raw_dup(type_expr, type_len)
    sym.doc = raw_dup_cstr(doc)
    sym.file = raw_dup_cstr(file)
    sym.line = line
    sym.col = col
    return sym
}

/// Parse the fields of a struct-like `type Name = { ... }` declaration.
/// `type_line` is the zero-based line on which the declaration starts (the
/// line stored on the corresponding Symbol).  The returned list owns a
/// `*Symbol` for every field; release it with `free_sym_list`.
pub fn parse_type_fields(content: ref u8, file: ref u8, type_line: i64) ref void = trust {
    val alloc: allocators.HeapAllocator = @zeroed
    val fields: mut ref void = none
    match coll.PtrList.new[allocators.HeapAllocator](alloc, 8 as usize) {
        ok l => {
            fields = l
        }
        err _ => {
            return none
        }
    }
    if content == none || type_line < 0 {
        return fields
    }

    val len: i64 = str.len_raw(content)
    if len <= 0 {
        return fields
    }

    val ls: mut i64 = -1
    val le: mut i64 = -1
    line_bounds_raw(content, type_line, @addr(ls), @addr(le))
    if ls < 0 {
        return fields
    }

    val open_idx: mut i64 = -1
    val oi: mut i64 = ls
    for {
        if oi >= len {
            break
        }
        if @load8(@ptradd(content, oi)) == '{' {
            open_idx = oi
            break
        }
        oi = oi + 1
    }
    if open_idx < 0 {
        return fields
    }

    val close_idx: i64 = find_matching_close_raw(content, len, open_idx, '{', '}')
    if close_idx <= open_idx {
        return fields
    }

    val doc_buf: mut str.String = str.new()
    val abs_line_start: mut i64 = line_start_at(content, open_idx)
    val cur_line: mut i64 = type_line + newline_count_between(content, ls, open_idx)
    val pos: mut i64 = open_idx + 1
    val depth: mut i64 = 1

    for {
        if pos >= close_idx {
            break
        }

        val line_end: mut i64 = pos
        for {
            if line_end >= len {
                break
            }
            val c: u8 = @load8(@ptradd(content, line_end))
            if c == '\n' || c == '\r' {
                break
            }
            line_end = line_end + 1
        }

        val seg: ref u8 = @ptradd(content, pos)
        val seg_len: i64 = line_end - pos
        val lead: i64 = skip_ws(seg, 0, seg_len)
        val trimmed: ref u8 = @ptradd(seg, lead)
        val tlen: i64 = trim_right_len(trimmed, seg_len - lead)

        val is_doc: bool = tlen >= 3 &&
        @load8(@ptradd(trimmed, 0)) == '/' &&
        @load8(@ptradd(trimmed, 1)) == '/' &&
        @load8(@ptradd(trimmed, 2)) == '/'
        val is_comment: bool = tlen >= 2 &&
        @load8(@ptradd(trimmed, 0)) == '/' &&
        @load8(@ptradd(trimmed, 1)) == '/'

        if is_doc && depth == 1 {
            val cs: mut i64 = 3
            if tlen > 3 && @load8(@ptradd(trimmed, 3)) == ' ' {
                cs = 4
            }
            if tlen > cs {
                val part: ref u8 = raw_dup(@ptradd(trimmed, cs), tlen - cs)
                if part != none {
                    str.push_cstr(doc_buf, part)
                    str.push_char(doc_buf, '\n')
                    @free(part as ref void)
                }
            }
        } elif !is_comment && tlen > 0 && depth == 1 {
            val first: u8 = @load8(@ptradd(trimmed, 0))
            if first != '}' && !starts_with_n(trimmed, tlen, "invariant", 9) {
                val name_len: i64 = ident_len_at(trimmed, 0, tlen)
                if name_len > 0 {
                    val after_name: i64 = skip_ws(trimmed, name_len, tlen)
                    if after_name < tlen && @load8(@ptradd(trimmed, after_name)) == ':' {
                        val type_start: i64 = skip_ws(trimmed, after_name + 1, tlen)
                        val type_len: i64 = trim_right_len(@ptradd(trimmed, type_start), tlen - type_start)
                        if type_len > 0 {
                            val field_doc: ref u8 = str.cstr(doc_buf)
                            val field: mut ref Symbol = make_field_sym(
                                trimmed, name_len,
                                @ptradd(trimmed, type_start), type_len,
                                field_doc, file, cur_line, pos + lead - abs_line_start
                            )
                            if field != none {
                                val fv: usize = @bitcast(field as ref void, usize)
                                match coll.PtrList.push[allocators.HeapAllocator](alloc, fields, fv) {
                                    ok _ => {}
                                    err _ => {
                                        sym_free(field, alloc)
                                    }
                                }
                            }
                            str.clear(doc_buf)
                        }
                    }
                }
            }
        } elif tlen > 0 && !is_doc {
            str.clear(doc_buf)
        }

        if depth == 1 && tlen > 0 && starts_with_n(trimmed, tlen, "invariant", 9) {
            str.clear(doc_buf)
        }

        val i: mut i64 = pos
        for {
            if i >= line_end {
                break
            }
            val c: u8 = @load8(@ptradd(content, i))
            if c == '{' {
                depth = depth + 1
            } elif c == '}' {
                depth = depth - 1
            }
            i++
        }
        if depth <= 0 {
            break
        }

        pos = line_end
        if pos < len {
            val c: u8 = @load8(@ptradd(content, pos))
            if c == '\r' {
                pos = pos + 1
            }
            if pos < len && @load8(@ptradd(content, pos)) == '\n' {
                pos = pos + 1
            }
        }
        abs_line_start = pos
        cur_line = cur_line + 1
    }

    str.string_free(doc_buf)
    return fields
}

pub fn find_active_call(content: ref u8, line: i64, col: i64, result: mut ref CallContext) void = trust {
    result.fn_name = none
    result.param_idx = 0
    result.qualifier = none
    result.is_intrinsic = 0

    if content == none || line < 0 || col < 0 {
        return
    }

    val content_len: i64 = str.len_raw(content)
    if content_len == 0 {
        return
    }

    val cur_line: mut i64 = 0
    val i: mut i64 = 0
    for {
        if cur_line >= line {
            break
        }
        if i >= content_len {
            break
        }
        if @load8(@ptradd(content, i)) == '\n' {
            cur_line = cur_line + 1
        }
        i++
    }
    val cursor_pos: mut i64 = i + col
    if cursor_pos > content_len {
        cursor_pos = content_len
    }

    val tokens: ref void = scan_tokens(content)
    if tokens == none {
        return
    }
    val n: usize = coll.PtrList.len(tokens)

    // Track the stack of currently-open parentheses.  The top of the stack at
    // the cursor is the call we are completing.
    val max_nesting: i64 = 4096
    val stack: ref void = @alloc((max_nesting as usize) * 8)
    if stack == none {
        free_scan_tokens(tokens)
        return
    }
    @memset(stack, 0, (max_nesting as usize) * 8)
    val sp: mut i64 = 0
    val ti: mut usize = 0
    for {
        if ti >= n {
            break
        }
        val t: ref ScanToken = scan_token_at(tokens, ti)
        if t == none {
            ti++
            continue
        }
        if t.start >= cursor_pos {
            break
        }
        if t.kind == TOK_PUNCT {
            if t.ch == '(' {
                if sp < max_nesting {
                    @store(@ptradd(stack as ref u8, sp * 8) as ref void, ti as i64)
                    sp = sp + 1
                }
            } elif t.ch == ')' {
                if sp > 0 {
                    sp = sp - 1
                }
            }
        }
        ti++
    }
    if sp <= 0 {
        @free(stack)
        free_scan_tokens(tokens)
        return
    }
    val open_idx: usize = @load(@ptradd(stack as ref u8, (sp - 1) * 8) as ref void) as i64 as usize

    if open_idx == 0 {
        @free(stack)
        free_scan_tokens(tokens)
        return
    }
    val first: ref ScanToken = scan_token_at(tokens, open_idx - 1)
    if first == none || first.kind != TOK_IDENT {
        @free(stack)
        free_scan_tokens(tokens)
        return
    }

    val name_start: i64 = first.start
    val name_len: i64 = first.len
    val chain_start: mut i64 = first.start
    val last_dot: mut i64 = -1
    val j: mut i64 = open_idx as i64 - 2
    for {
        if j < 0 {
            break
        }
        if j < 1 {
            break
        }
        val dt: ref ScanToken = scan_token_at(tokens, j as usize)
        if dt == none || dt.kind != TOK_PUNCT || dt.ch != '.' {
            break
        }
        val pt: ref ScanToken = scan_token_at(tokens, (j - 1) as usize)
        if pt == none || pt.kind != TOK_IDENT {
            break
        }
        if last_dot < 0 {
            last_dot = dt.start
        }
        chain_start = pt.start
        j = j - 2
    }

    if last_dot > chain_start {
        val qs: i64 = skip_ws(content, chain_start, last_dot)
        val qlen: i64 = trim_right_len(@ptradd(content, qs), last_dot - qs)
        if qlen > 0 {
            result.qualifier = raw_dup(@ptradd(content, qs), qlen)
        }
    }

    val before: mut ref ScanToken = none
    if j >= 0 {
        before = scan_token_at(tokens, j as usize)
    }
    if before != none && before.kind == TOK_PUNCT && before.ch == '@' {
        result.is_intrinsic = 1
    }

    result.fn_name = raw_dup(@ptradd(content, name_start), name_len)

    val comma_count: mut i64 = 0
    val paren_depth: mut i64 = 0
    val square_depth: mut i64 = 0
    val brace_depth: mut i64 = 0
    val ci: mut usize = open_idx + 1
    for {
        if ci >= n {
            break
        }
        val t: ref ScanToken = scan_token_at(tokens, ci)
        if t == none {
            ci++
            continue
        }
        if t.start >= cursor_pos {
            break
        }
        if t.kind == TOK_PUNCT {
            if t.ch == '(' {
                paren_depth = paren_depth + 1
            } elif t.ch == ')' {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1
                }
            } elif t.ch == '[' {
                square_depth = square_depth + 1
            } elif t.ch == ']' {
                if square_depth > 0 {
                    square_depth = square_depth - 1
                }
            } elif t.ch == '{' {
                brace_depth = brace_depth + 1
            } elif t.ch == '}' {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1
                }
            } elif t.ch == ',' && paren_depth == 0 && square_depth == 0 && brace_depth == 0 {
                comma_count = comma_count + 1
            }
        }
        ci++
    }
    result.param_idx = comma_count

    @free(stack)
    free_scan_tokens(tokens)
}

pub fn uri_to_path(uri: ref u8) ref u8 = trust {
    if uri == none {
        return none
    }
    val len: i64 = str.len_raw(uri)
    if starts_with_n(uri, len, "file://", 7) {
        return raw_dup_cstr(@ptradd(uri, 7))
    }
    return raw_dup_cstr(uri)
}

pub fn path_to_uri(path: ref u8) ref u8 = trust {
    if path == none {
        return none
    }
    val plen: i64 = str.len_raw(path)
    val prefix: ref u8 = "file://"
    val pfx_len: i64 = 7
    val total: i64 = pfx_len + plen + 1
    val buf: ref u8 = @alloc(total) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf as ref void, prefix as ref void, pfx_len as usize)
    @memcpy(@ptradd(buf, pfx_len), path as ref void, plen as usize)
    @store8(@ptradd(buf, pfx_len + plen), 0)
    return buf
}

fn is_path_sep(c: u8) bool = {
    if c == '/' {
        return true
    }
    when windows {
        if c == '\\' {
            return true
        }
    }
    return false
}

pub fn path_dirname(path: ref u8) ref u8 = trust {
    if path == none {
        return none
    }
    val len: i64 = str.len_raw(path)
    if len == 0 {
        return raw_dup_cstr(".")
    }

    val end: mut i64 = len
    for {
        if end <= 0 {
            break
        }
        if !is_path_sep(@load8(@ptradd(path, end - 1))) {
            break
        }
        end = end - 1
    }
    if end == 0 {
        return raw_dup(path, 1)
    }

    val i: mut i64 = end - 1
    for {
        if i < 0 {
            break
        }
        if is_path_sep(@load8(@ptradd(path, i))) {
            break
        }
        i = i - 1
    }
    if i < 0 {
        return raw_dup_cstr(".")
    }
    if i == 0 {
        return raw_dup(path, 1)
    }
    return raw_dup(path, i)
}

pub fn path_join(dir: ref u8, name: ref u8) ref u8 = trust {
    val dl: i64 = str.len_raw(dir)
    val nl: i64 = str.len_raw(name)
    val buf: ref u8 = @alloc(dl + 1 + nl + 1) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf as ref void, dir as ref void, dl as usize)
    @store8(@ptradd(buf, dl), '/')
    @memcpy(@ptradd(buf, dl + 1), name as ref void, nl as usize)
    @store8(@ptradd(buf, dl + 1 + nl), 0)
    return buf
}

val os         = use("std/os")
val reflection = use("std/reflection")
val pathlib    = use("std/path")

fn has_path_sep(p: ref u8, plen: i64) bool = trust {
    val i: mut i64 = 0
    for {
        if i >= plen {
            break
        }
        if is_path_sep(@load8(@ptradd(p, i))) {
            return true
        }
        i++
    }
    return false
}

fn stdlib_dir_valid(dir: ref u8) bool = trust {
    if dir == none {
        return false
    }
    val marker: ref u8 = path_join(dir, "stdio/core.sx")
    if marker == none {
        return false
    }
    val exists: bool = os.exists(marker)
    @free(marker as ref void)
    return exists
}

fn try_stdlib_dir(candidate: ref u8) ref u8 = trust {
    if candidate == none {
        return none
    }
    if stdlib_dir_valid(candidate) {
        return candidate
    }
    @free(candidate as ref void)
    return none
}

fn find_exe_dir() ref u8 = trust {
    val arena_res = allocators.Arena.new(4096 as usize)
    match arena_res {
        ok arena => {
            val exe_path: ref u8 = reflection.get_exe_path[allocators.Arena](arena)
            val dir: ref u8 = path_dirname(exe_path)
            allocators.Arena.free(arena)
            return dir
        }
        err _ => {
            return none
        }
    }
}

/// Old-style standard library snapshots (`std__<hash>`) that the compiler
/// materialises inside a workspace.
fn find_std_snapshot_dir(from_file: ref u8) ref u8 = trust {
    val dir: mut ref u8 = path_dirname(from_file)
    val iters: mut i64 = 0
    for {
        if dir == none {
            break
        }
        if iters > 32 {
            @free(dir as ref void) break
        }
        iters = iters + 1

        val dh: ref void = os.opendir(dir)
        if dh != none {
            val found: mut ref u8 = none
            for {
                val entry: ref os.Dirent = os.readdir(dh)
                if entry == none {
                    break
                }
                val ename: ref u8 = @addr(entry.d_name) as ref u8
                val elen: i64 = str.len_raw(ename)
                if elen >= 5 && starts_with_n(ename, elen, "std__", 5) {
                    found = path_join(dir, ename)
                    break
                }
            }
            os.closedir(dh)
            if found != none {
                @free(dir as ref void)
                return found
            }
        }

        val parent: ref u8 = path_dirname(dir)
        if parent == none {
            @free(dir as ref void)
            break
        }
        val same: bool = (str.raw_cmp(parent, dir) == 0)
        @free(dir as ref void)
        if same {
            @free(parent as ref void) break
        }
        dir = parent
    }
    return none
}

/// Locate the standard library that ships with the Spectre compiler.
///
/// The compiler keeps `spectrelib/` next to its executable, so the language
/// server does the same.  A few standard installation layouts are tried as
/// well, along with the `SPECTRE_STDLIB` / `SPECTRE_ROOT` overrides that the
/// compiler itself honours.
pub fn find_std_dir(from_file: ref u8) ref u8 = trust {
    if os.env("SPECTRE_STDLIB") is some v {
        val direct: ref u8 = raw_dup_cstr(v)
        val found: ref u8 = try_stdlib_dir(direct)
        if found != none {
            return found
        }
        val nested: ref u8 = path_join(v, "spectrelib")
        val found_nested: ref u8 = try_stdlib_dir(nested)
        if found_nested != none {
            return found_nested
        }
    }

    if os.env("SPECTRE_ROOT") is some v {
        val nested: ref u8 = path_join(v, "spectrelib")
        val found: ref u8 = try_stdlib_dir(nested)
        if found != none {
            return found
        }
    }

    val exe_dir: ref u8 = find_exe_dir()
    if exe_dir != none {
        val c1: ref u8 = try_stdlib_dir(path_join(exe_dir, "spectrelib"))
        if c1 != none {
            @free(exe_dir as ref void)
            return c1
        }
        val c2: ref u8 = try_stdlib_dir(path_join(exe_dir, "../share/spectre/spectrelib"))
        if c2 != none {
            @free(exe_dir as ref void)
            return c2
        }
        val c3: ref u8 = try_stdlib_dir(path_join(exe_dir, "../lib/spectre/spectrelib"))
        if c3 != none {
            @free(exe_dir as ref void)
            return c3
        }
        val c4: ref u8 = try_stdlib_dir(path_join(exe_dir, "../lib/spectrelib"))
        if c4 != none {
            @free(exe_dir as ref void)
            return c4
        }
        @free(exe_dir as ref void)
    }

    val cwd_candidate: ref u8 = try_stdlib_dir(raw_dup_cstr("spectrelib"))
    if cwd_candidate != none {
        return cwd_candidate
    }

    return find_std_snapshot_dir(from_file)
}

fn with_sx_suffix(s: ref u8) ref u8 = trust {
    val len: i64 = str.len_raw(s)
    val buf: ref u8 = @alloc(len + 4) as ref u8
    if buf == none {
        return none
    }
    @memcpy(buf as ref void, s as ref void, len as usize)
    @store8(@ptradd(buf, len), '.')
    @store8(@ptradd(buf, len + 1), 's')
    @store8(@ptradd(buf, len + 2), 'x')
    @store8(@ptradd(buf, len + 3), 0)
    return buf
}

fn join3(dir: ref u8, mid: ref u8, name: ref u8) ref u8 = trust {
    val d1: ref u8 = path_join(dir, mid)
    if d1 == none {
        return none
    }
    val d2: ref u8 = path_join(d1, name)
    @free(d1 as ref void)
    return d2
}

fn clean_path(p: ref u8) ref u8 = trust {
    if p == none {
        return none
    }
    val src: mut ref u8 = p
    when windows {
        val len: i64 = str.len_raw(src)
        val buf: ref u8 = raw_dup(src, len)
        if buf != none {
            val i: mut i64 = 0
            for {
                if i >= len {
                    break
                }
                if @load8(@ptradd(buf, i)) == '\\' {
                    @store8(@ptradd(buf, i), '/')
                }
                i++
            }
            @free(src as ref void)
            src = buf
        }
    }
    val out: ref u8 = pathlib.canonicalize_path(src)
    if out == none || out == src {
        return src
    }
    @free(src as ref void)
    return out
}

fn existing_path(p: ref u8) ref u8 = trust {
    if p == none {
        return none
    }
    if !os.exists(p) {
        @free(p as ref void)
        return none
    }
    return clean_path(p)
}

fn joined_with_sx(dir: ref u8, name: ref u8) ref u8 = trust {
    val joined: ref u8 = path_join(dir, name)
    if joined == none {
        return none
    }
    val suffixed: ref u8 = with_sx_suffix(joined)
    @free(joined as ref void)
    return suffixed
}

fn try_module_in_dir(dir: ref u8, mod_path: ref u8, has_sep: bool) ref u8 = trust {
    val core: ref u8 = existing_path(join3(dir, mod_path, "core.sx"))
    if core != none {
        return core
    }

    if !has_sep {
        val suffix: ref u8 = with_sx_suffix(mod_path)
        if suffix != none {
            val nested: ref u8 = existing_path(join3(dir, mod_path, suffix))
            @free(suffix as ref void)
            if nested != none {
                return nested
            }
        }
    }

    return existing_path(joined_with_sx(dir, mod_path))
}

fn find_workspace_root(start_dir: ref u8) ref u8 = trust {
    if start_dir == none {
        return none
    }
    val cur: mut ref u8 = raw_dup_cstr(start_dir)
    if cur == none {
        return none
    }
    val limit: mut i64 = 0
    for {
        if limit >= 32 {
            break
        }
        limit = limit + 1

        val marker: ref u8 = path_join(cur, "sx.mod")
        if marker != none {
            val has_marker: bool = os.exists(marker)
            @free(marker as ref void)
            if has_marker {
                return cur
            }
        }

        val parent: ref u8 = path_dirname(cur)
        if parent == none {
            break
        }
        val same: bool = str.raw_cmp(parent, cur) == 0
        val is_dot: bool = str.raw_cmp(parent, ".") == 0
        if same || is_dot {
            @free(parent as ref void)
            break
        }
        @free(cur as ref void)
        cur = parent
    }
    @free(cur as ref void)
    return raw_dup_cstr(start_dir)
}

pub fn resolve_module_path(current_file: ref u8, mod_path: ref u8) ref u8 = trust {
    if current_file == none || mod_path == none {
        return none
    }
    val mlen: i64 = str.len_raw(mod_path)
    if mlen <= 0 {
        return none
    }

    if starts_with_n(mod_path, mlen, "std/", 4) {
        val std_dir: ref u8 = find_std_dir(current_file)
        if std_dir == none {
            return none
        }
        val subpath: ref u8 = @ptradd(mod_path, 4)
        val inner: ref u8 = path_join(std_dir, subpath)
        @free(std_dir as ref void)
        if inner == none {
            return none
        }
        val result: ref u8 = path_join(inner, "core.sx")
        @free(inner as ref void)
        return existing_path(result)
    }

    val file_dir: ref u8 = path_dirname(current_file)
    if file_dir == none {
        return none
    }
    val workspace: ref u8 = find_workspace_root(file_dir)

    if mlen > 3 && starts_with_n(@ptradd(mod_path, mlen - 3), 3, ".sx", 3) {
        val direct: ref u8 = existing_path(path_join(file_dir, mod_path))
        if direct != none {
            @free(file_dir as ref void)
            if workspace != none {
                @free(workspace as ref void)
            }
            return direct
        }
        if workspace != none && str.raw_cmp(workspace, file_dir) != 0 {
            val ws_direct: ref u8 = existing_path(path_join(workspace, mod_path))
            if ws_direct != none {
                @free(file_dir as ref void)
                @free(workspace as ref void)
                return ws_direct
            }
        }
        @free(file_dir as ref void)
        if workspace != none {
            @free(workspace as ref void)
        }
        return none
    }

    val has_sep: bool = has_path_sep(mod_path, mlen)
    val exe_dir: ref u8 = find_exe_dir()

    if exe_dir != none {
        val found: ref u8 = try_module_in_dir(exe_dir, mod_path, has_sep)
        if found != none {
            @free(exe_dir as ref void)
            @free(file_dir as ref void)
            if workspace != none {
                @free(workspace as ref void)
            }
            return found
        }
    }

    if workspace != none && str.raw_cmp(workspace, file_dir) != 0 {
        val found: ref u8 = try_module_in_dir(workspace, mod_path, has_sep)
        if found != none {
            if exe_dir != none {
                @free(exe_dir as ref void)
            }
            @free(file_dir as ref void)
            @free(workspace as ref void)
            return found
        }
    }

    val local: ref u8 = try_module_in_dir(file_dir, mod_path, has_sep)
    if local != none {
        if exe_dir != none {
            @free(exe_dir as ref void)
        }
        @free(file_dir as ref void)
        if workspace != none {
            @free(workspace as ref void)
        }
        return local
    }

    if exe_dir != none {
        @free(exe_dir as ref void)
    }
    @free(file_dir as ref void)
    if workspace != none {
        @free(workspace as ref void)
    }
    return none
}

test {
    val d1 = trust path_dirname("/a/b/c.sx")
    val d2 = trust path_dirname("/a/b/")
    val d3 = trust path_dirname("/")
    val d4 = trust path_dirname("c.sx")
    val d5 = trust path_dirname(".")
    val j1 = trust path_join("/a", "b.sx")
    assert str.raw_cmp(d1, "/a/b") == 0
    assert str.raw_cmp(d2, "/a") == 0
    assert str.raw_cmp(d3, "/") == 0
    assert str.raw_cmp(d4, ".") == 0
    assert str.raw_cmp(d5, ".") == 0
    assert str.raw_cmp(j1, "/a/b.sx") == 0
}

fn scan_tok_new(
    start: i64, tlen: i64, line: i64, col: i64,
    depth: i64, owner: i64, kind: i64, ch: u8
) ref ScanToken = trust {
    val mem: ref void = @alloc(@sizeof(ScanToken))
    if mem == none {
        return none
    }
    @memset(mem, 0, @sizeof(ScanToken) as usize)
    val t: mut ref ScanToken = mem as ref ScanToken
    t.start = start
    t.len = tlen
    t.line = line
    t.col = col
    t.depth = depth
    t.owner = owner
    t.kind = kind
    t.ch = ch
    return t
}

fn scan_token_push(tokens: mut ref void, t: ref ScanToken) void = trust {
    if tokens == none || t == none {
        return
    }
    val alloc: allocators.HeapAllocator = @zeroed
    val tv: usize = @bitcast(t as ref void, usize)
    match coll.PtrList.push[_](alloc, tokens, tv) {
        ok _ => {}
        err _ => {
            @free(t as ref void)
        }
    }
}

fn scan_tokens(content: ref u8) ref void = trust {
    val alloc: allocators.HeapAllocator = @zeroed
    val tokens: mut ref void = none
    match coll.PtrList.new[_](alloc, 128 as usize) {
        ok l => {
            tokens = l
        }
        err _ => {
            return none
        }
    }
    if content == none {
        return tokens
    }

    val len: i64 = str.len_raw(content)
    val max_depth: i64 = 4096
    val owner_stack: ref void = @alloc((max_depth as usize) * 8)
    if owner_stack == none {
        coll.PtrList.free[_](alloc, tokens)
        return none
    }
    @memset(owner_stack, 0, (max_depth as usize) * 8)

    val i: mut i64 = 0
    val line: mut i64 = 0
    val col: mut i64 = 0
    val depth: mut i64 = 0
    val current_owner: mut i64 = 0
    val next_owner: mut i64 = 0
    val pending_callable: mut i64 = 0
    val pending_line: mut i64 = -1

    for {
        if i >= len {
            break
        }
        val c: u8 = @load8(@ptradd(content, i))

        if c == ' ' || c == '\t' || c == '\r' {
            i++
            col = col + 1
            continue
        }
        if c == '\n' {
            i++
            line = line + 1
            col = 0
            if pending_callable == 1 && pending_line != line {
                pending_callable = 0
            }
            continue
        }

        // Line comments.
        if c == '/' && i + 1 < len && @load8(@ptradd(content, i + 1)) == '/' {
            for {
                if i >= len {
                    break
                }
                if @load8(@ptradd(content, i)) == '\n' {
                    break
                }
                i++
                col = col + 1
            }
            continue
        }

        // Raw strings start with `\\` and may continue on following lines that
        // also start with `\\`.
        if c == '\\' && i + 1 < len && @load8(@ptradd(content, i + 1)) == '\\' {
            i = i + 2
            col = col + 2
            for {
                if i >= len {
                    break
                }
                if @load8(@ptradd(content, i)) == '\n' {
                    break
                }
                i++
                col = col + 1
            }
            if i < len && @load8(@ptradd(content, i)) == '\n' {
                i++
                line = line + 1
                col = 0
            }
            for {
                val save_i: i64 = i
                val save_col: i64 = col
                for {
                    if i >= len {
                        break
                    }
                    val ic: u8 = @load8(@ptradd(content, i))
                    if ic != ' ' && ic != '\t' {
                        break
                    }
                    i++
                    col = col + 1
                }
                if i + 1 < len &&
                @load8(@ptradd(content, i)) == '\\' &&
                @load8(@ptradd(content, i + 1)) == '\\' {
                    i = i + 2
                    col = col + 2
                    for {
                        if i >= len {
                            break
                        }
                        if @load8(@ptradd(content, i)) == '\n' {
                            break
                        }
                        i++
                        col = col + 1
                    }
                    if i < len && @load8(@ptradd(content, i)) == '\n' {
                        i++
                        line = line + 1
                        col = 0
                    }
                } else {
                    i = save_i
                    col = save_col
                    break
                }
            }
            continue
        }

        // String literals.
        if c == '"' {
            i++
            col = col + 1
            for {
                if i >= len {
                    break
                }
                val sc: u8 = @load8(@ptradd(content, i))
                if sc == '\\' && i + 1 < len {
                    i = i + 2
                    col = col + 2
                    continue
                }
                if sc == '"' {
                    i++
                    col = col + 1
                    break
                }
                if sc == '\n' {
                    i++
                    line = line + 1
                    col = 0
                    continue
                }
                i++
                col = col + 1
            }
            continue
        }

        // Character literals.
        if c == '\'' {
            i++
            col = col + 1
            for {
                if i >= len {
                    break
                }
                val cc: u8 = @load8(@ptradd(content, i))
                if cc == '\\' && i + 1 < len {
                    i = i + 2
                    col = col + 2
                    continue
                }
                if cc == '\'' {
                    i++
                    col = col + 1
                    break
                }
                if cc == '\n' {
                    i++
                    line = line + 1
                    col = 0
                    break
                }
                i++
                col = col + 1
            }
            continue
        }

        if is_ident_start(c) {
            val start: i64 = i
            val start_col: i64 = col
            for {
                if i >= len {
                    break
                }
                if !is_ident_cont(@load8(@ptradd(content, i))) {
                    break
                }
                i++
                col = col + 1
            }
            val tlen: i64 = i - start
            val t: ref ScanToken = scan_tok_new(start, tlen, line, start_col, depth, current_owner, TOK_IDENT, 0 as u8)
            scan_token_push(tokens, t)
            if tlen == 2 && strncmp(@ptradd(content, start), "fn", 2 as usize) == 0 {
                pending_callable = 1
                pending_line = line
            } elif tlen == 4 && strncmp(@ptradd(content, start), "test", 4 as usize) == 0 {
                pending_callable = 1
                pending_line = line
            }
            continue
        }

        if c >= '0' && c <= '9' {
            for {
                if i >= len {
                    break
                }
                val nc: u8 = @load8(@ptradd(content, i))
                if is_ident_cont(nc) || nc == '.' {
                    i++
                    col = col + 1
                } else {
                    break
                }
            }
            continue
        }

        if c == '{' {
            if pending_callable == 1 && pending_line == line {
                next_owner = next_owner + 1
                current_owner = next_owner
                pending_callable = 0
            }
            val t: ref ScanToken = scan_tok_new(i, 1, line, col, depth, current_owner, TOK_PUNCT, c)
            scan_token_push(tokens, t)
            depth = depth + 1
            if depth < max_depth {
                @store(@ptradd(owner_stack as ref u8, depth * 8) as ref void, current_owner)
            }
            i++
            col = col + 1
            continue
        }

        if c == '}' {
            val t: ref ScanToken = scan_tok_new(i, 1, line, col, depth, current_owner, TOK_PUNCT, c)
            scan_token_push(tokens, t)
            if depth > 0 {
                depth = depth - 1
                if depth < max_depth {
                    current_owner = @load(@ptradd(owner_stack as ref u8, depth * 8) as ref void) as i64
                }
            }
            i++
            col = col + 1
            continue
        }

        val t: ref ScanToken = scan_tok_new(i, 1, line, col, depth, current_owner, TOK_PUNCT, c)
        scan_token_push(tokens, t)
        i++
        col = col + 1
    }

    @free(owner_stack)
    return tokens
}

fn scan_token_at(tokens: ref void, index: usize) ref ScanToken = trust {
    if tokens == none {
        return none
    }
    if index >= coll.PtrList.len(tokens) {
        return none
    }
    match coll.PtrList.get(tokens, index) {
        some v => {
            return @bitcast(v, ref void) as ref ScanToken
        }
        none => {
            return none
        }
    }
}

fn free_scan_tokens(tokens: ref void) void = trust {
    if tokens == none {
        return
    }
    val alloc: allocators.HeapAllocator = @zeroed
    val list: mut ref void = tokens
    val n: usize = coll.PtrList.len(list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(list, i) is some v {
            @free(@bitcast(v, ref void))
        }
        i++
    }
    coll.PtrList.free[_](alloc, list)
}

fn scan_tok_is_word(content: ref u8, t: ref ScanToken, word: ref u8, wlen: i64) bool = trust {
    if content == none || t == none || word == none {
        return false
    }
    if t.kind != TOK_IDENT || t.len != wlen {
        return false
    }
    return strncmp(@ptradd(content, t.start), word, wlen as usize) == 0
}

fn var_candidate_alloc() ref VarCandidate = trust {
    val mem: ref void = @alloc(@sizeof(VarCandidate))
    if mem == none {
        return none
    }
    @memset(mem, 0, @sizeof(VarCandidate) as usize)
    return mem as ref VarCandidate
}

fn free_var_candidates(candidates: mut ref void) void = trust {
    if candidates == none {
        return
    }
    val alloc: allocators.HeapAllocator = @zeroed
    val n: usize = coll.PtrList.len(candidates)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(candidates, i) is some v {
            val c: ref VarCandidate = @bitcast(v, ref void) as ref VarCandidate
            if c != none {
                if c.name != none {
                    @free(c.name as ref void)
                }
                @free(c as ref void)
            }
        }
        i++
    }
    coll.PtrList.free[_](alloc, candidates)
}

fn var_candidate_is_import(
    content: ref u8,
    tokens: ref void,
    name_index: usize
) bool = trust {
    if content == none || tokens == none {
        return false
    }
    val n: usize = coll.PtrList.len(tokens)
    val name_tok: ref ScanToken = scan_token_at(tokens, name_index)
    if name_tok == none {
        return false
    }

    val j: mut usize = name_index + 1
    for {
        if j >= n {
            break
        }
        val t: ref ScanToken = scan_token_at(tokens, j)
        if t == none {
            break
        }
        if t.line != name_tok.line {
            break
        }
        if t.kind == TOK_PUNCT && t.ch == '=' && t.depth == name_tok.depth {
            val u: ref ScanToken = scan_token_at(tokens, j + 1)
            if u != none && scan_tok_is_word(content, u, "use", 3) {
                val p: ref ScanToken = scan_token_at(tokens, j + 2)
                if p != none && p.kind == TOK_PUNCT && p.ch == '(' {
                    return true
                }
            }
            return false
        }
        j++
    }
    return false
}

fn unused_variable_alloc() ref UnusedVariable = trust {
    val mem: ref void = @alloc(@sizeof(UnusedVariable))
    if mem == none {
        return none
    }
    @memset(mem, 0, @sizeof(UnusedVariable) as usize)
    return mem as ref UnusedVariable
}

pub fn free_unused_variables(vars: ref void) void = trust {
    if vars == none {
        return
    }
    val alloc: allocators.HeapAllocator = @zeroed
    val list: mut ref void = vars
    val n: usize = coll.PtrList.len(list)
    val i: mut usize = 0
    for {
        if i >= n {
            break
        }
        if coll.PtrList.get(list, i) is some v {
            val u: ref UnusedVariable = @bitcast(v, ref void) as ref UnusedVariable
            if u != none {
                if u.name != none {
                    @free(u.name as ref void)
                }
                @free(u as ref void)
            }
        }
        i++
    }
    coll.PtrList.free[_](alloc, list)
}

/// Find `val` bindings that are never referenced in the supplied source.
///
/// Both module-level values and values inside function/test bodies are
/// reported.  Bindings whose name is `_`, public module-level values, and
/// import aliases (`val x = use("...")`) are ignored.  Usage detection is
/// lexical but scope-aware: a local binding only counts references inside its
/// enclosing function body, and identifiers in comments, strings, member
/// accesses, and named-field labels are not treated as references.
pub fn find_unused_variables(content: ref u8) ref void = trust {
    val alloc: allocators.HeapAllocator = @zeroed
    val result: mut ref void = none
    match coll.PtrList.new[_](alloc, 16 as usize) {
        ok l => {
            result = l
        }
        err _ => {
            return none
        }
    }
    if content == none {
        return result
    }

    val tokens: ref void = scan_tokens(content)
    if tokens == none {
        return result
    }
    val n: usize = coll.PtrList.len(tokens)

    val candidates: mut ref void = none
    match coll.PtrList.new[_](alloc, 16 as usize) {
        ok l => {
            candidates = l
        }
        err _ => {
            free_scan_tokens(tokens)
            return result
        }
    }

    val ti: mut usize = 0
    for {
        if ti >= n {
            break
        }
        val t: ref ScanToken = scan_token_at(tokens, ti)
        if t != none && t.kind == TOK_IDENT && scan_tok_is_word(content, t, "val", 3) {
            if ti + 1 < n {
                val name_tok: mut ref ScanToken = scan_token_at(tokens, ti + 1)
                if name_tok != none && name_tok.kind == TOK_IDENT {
                    if !var_candidate_is_import(content, tokens, ti + 1) {
                        val is_public: mut i64 = 0
                        if ti > 0 {
                            val prev: ref ScanToken = scan_token_at(tokens, ti - 1)
                            if prev != none && prev.line == t.line &&
                            scan_tok_is_word(content, prev, "pub", 3) {
                                is_public = 1
                            }
                        }
                        val c: mut ref VarCandidate = var_candidate_alloc()
                        if c != none {
                            c.name = raw_dup(@ptradd(content, name_tok.start), name_tok.len)
                            c.line = name_tok.line
                            c.col = name_tok.col
                            c.token_index = (ti + 1) as i64
                            c.depth = name_tok.depth
                            c.owner = name_tok.owner
                            c.is_public = is_public
                            name_tok.is_decl = 1
                            val cv: usize = @bitcast(c as ref void, usize)
                            match coll.PtrList.push[_](alloc, candidates, cv) {
                                ok _ => {}
                                err _ => {
                                    if c.name != none {
                                        @free(c.name as ref void)
                                    }
                                    @free(c as ref void)
                                }
                            }
                        }
                    }
                }
            }
        }
        ti++
    }

    val dn: usize = coll.PtrList.len(candidates)
    val flags: ref void = @alloc(dn)
    if flags != none && dn > 0 {
        @memset(flags, 0, dn)
    }
    val di: mut usize = 0
    for {
        if di >= dn {
            break
        }
        if coll.PtrList.get(candidates, di) is some dv {
            val d: ref VarCandidate = @bitcast(dv, ref void) as ref VarCandidate
            if d != none && d.name != none {
                val name_len: i64 = str.len_raw(d.name)
                val ui: mut usize = 0
                for {
                    if ui >= n {
                        break
                    }
                    val u: ref ScanToken = scan_token_at(tokens, ui)
                    if u != none && u.kind == TOK_IDENT && u.is_decl == 0 &&
                    u.len == name_len &&
                    strncmp(@ptradd(content, u.start), d.name, name_len as usize) == 0 {
                        val prev_is_member: mut bool = false
                        if ui > 0 {
                            val prev: ref ScanToken = scan_token_at(tokens, ui - 1)
                            if prev != none && prev.kind == TOK_PUNCT &&
                            (prev.ch == '.' || prev.ch == '@') {
                                prev_is_member = true
                            }
                        }
                        val next_is_label: mut bool = false
                        if ui + 1 < n {
                            val next: ref ScanToken = scan_token_at(tokens, ui + 1)
                            if next != none && next.kind == TOK_PUNCT && next.ch == ':' {
                                next_is_label = true
                            }
                        }
                        if !prev_is_member && !next_is_label {
                            val in_scope: mut bool = true
                            if d.owner != 0 {
                                if u.owner != d.owner {
                                    in_scope = false
                                } elif u.line < d.line {
                                    in_scope = false
                                } elif u.line == d.line && u.col <= d.col {
                                    in_scope = false
                                } elif u.depth < d.depth {
                                    in_scope = false
                                }
                            }
                            if in_scope {
                                if flags != none {
                                    @store8(@ptradd(flags as ref u8, di as i64), 1 as u8)
                                }
                                break
                            }
                        }
                    }
                    ui++
                }
            }
        }
        di++
    }

    val oi: mut usize = 0
    for {
        if oi >= dn {
            break
        }
        if coll.PtrList.get(candidates, oi) is some dv {
            val d: ref VarCandidate = @bitcast(dv, ref void) as ref VarCandidate
            val is_used: bool = flags != none && @load8(@ptradd(flags as ref u8, oi as i64)) != 0
            if d != none && d.name != none && !is_used {
                val is_public_global: bool = d.owner == 0 && d.is_public == 1
                if !is_public_global && str.raw_cmp(d.name, "_") != 0 {
                    val u: mut ref UnusedVariable = unused_variable_alloc()
                    if u != none {
                        u.name = raw_dup(@ptradd(d.name, 0), str.len_raw(d.name))
                        u.line = d.line
                        u.col = d.col
                        val uv: usize = @bitcast(u as ref void, usize)
                        match coll.PtrList.push[_](alloc, result, uv) {
                            ok _ => {}
                            err _ => {
                                if u.name != none {
                                    @free(u.name as ref void)
                                }
                                @free(u as ref void)
                            }
                        }
                    }
                }
            }
        }
        oi++
    }

    if flags != none {
        @free(flags)
    }
    free_var_candidates(candidates)
    free_scan_tokens(tokens)
    return result
}

test {
    val src: ref u8 = "val used_top = 1\nval unused_top = 2\n\nfn f() void = {\n    val used_local = used_top\n    val unused_local = 3\n    trust @print(\"{d}\", {used_local})\n}\n"
    val vars: mut ref void = trust find_unused_variables(src)
    assert vars != none
    assert coll.PtrList.len(vars) == 2

    val saw_top: mut bool = false
    val saw_local: mut bool = false
    val i: mut usize = 0
    for {
        if i >= coll.PtrList.len(vars) {
            break
        }
        if coll.PtrList.get(vars, i) is some v {
            val u: ref UnusedVariable = trust @bitcast(v, ref void) as ref UnusedVariable
            if str.raw_cmp(u.name, "unused_top") == 0 {
                saw_top = u.line == 1
            }
            if str.raw_cmp(u.name, "unused_local") == 0 {
                saw_local = u.line == 5
            }
        }
        i++
    }
    assert saw_top
    assert saw_local
    trust free_unused_variables(vars)
}

test {
    val src: ref u8 = "val used = 1\nval _ = 2\npub val exported = 3\nval io = use(\"std/stdio\")\nfn f() void = {\n    val s = \"unused text\"\n    // used in a comment\n    trust @print(\"{s}\", {s + used})\n}\n"
    val vars: mut ref void = trust find_unused_variables(src)
    assert vars != none
    assert coll.PtrList.len(vars) == 0
    trust free_unused_variables(vars)
}

test {
    val src: ref u8 = "val obj = make()\nfn f() void = {\n    obj.run(1, other(2, 3), [4, 5])\n}\n"
    val ctx_mem: ref void = @alloc(@sizeof(CallContext))
    assert ctx_mem != none
    trust @memset(ctx_mem, 0, @sizeof(CallContext) as usize)
    val ctx: mut ref CallContext = ctx_mem as ref CallContext
    trust find_active_call(src, 2, 26, ctx)
    assert ctx.fn_name != none
    assert str.raw_cmp(ctx.fn_name, "run") == 0
    assert ctx.qualifier != none
    assert str.raw_cmp(ctx.qualifier, "obj") == 0
    assert ctx.param_idx == 1
    if ctx.fn_name != none {
        trust @free(ctx.fn_name as ref void)
    }
    if ctx.qualifier != none {
        trust @free(ctx.qualifier as ref void)
    }
    trust @free(ctx_mem)
}

test {
    val src: ref u8 = "mod.Type.build(1, 2, 3)\n"
    val ctx_mem: ref void = @alloc(@sizeof(CallContext))
    assert ctx_mem != none
    trust @memset(ctx_mem, 0, @sizeof(CallContext) as usize)
    val ctx: mut ref CallContext = ctx_mem as ref CallContext
    trust find_active_call(src, 0, 18, ctx)
    assert ctx.fn_name != none
    assert str.raw_cmp(ctx.fn_name, "build") == 0
    assert ctx.qualifier != none
    assert str.raw_cmp(ctx.qualifier, "mod.Type") == 0
    assert ctx.param_idx == 1
    if ctx.fn_name != none {
        trust @free(ctx.fn_name as ref void)
    }
    if ctx.qualifier != none {
        trust @free(ctx.qualifier as ref void)
    }
    trust @free(ctx_mem)
}

test {
    val src: ref u8 = "val p = trust @alloc(size)\n"
    val ctx_mem: ref void = @alloc(@sizeof(CallContext))
    assert ctx_mem != none
    trust @memset(ctx_mem, 0, @sizeof(CallContext) as usize)
    val ctx: mut ref CallContext = ctx_mem as ref CallContext
    trust find_active_call(src, 0, 23, ctx)
    assert ctx.fn_name != none
    assert str.raw_cmp(ctx.fn_name, "alloc") == 0
    assert ctx.is_intrinsic == 1
    if ctx.fn_name != none {
        trust @free(ctx.fn_name as ref void)
    }
    if ctx.qualifier != none {
        trust @free(ctx.qualifier as ref void)
    }
    trust @free(ctx_mem)
}

test {
    val src: ref u8 = "/// strlen docs\nextern (C) fn strlen(s: ref u8) i64 = \"strlen\"\n\nextern type Rect = {\n    x: i32\n}\n\nwhen linux {\n    extern (C) fn uname(buf: ref Rect) i32 = \"uname\"\n}\n"
    val syms: mut ref void = trust parse_file("extern_test.sx", src)
    assert syms != none
    assert coll.PtrList.len(syms) == 3

    val saw_strlen: mut bool = false
    val saw_rect: mut bool = false
    val saw_uname: mut bool = false
    val i: mut usize = 0
    for {
        if i >= coll.PtrList.len(syms) {
            break
        }
        if coll.PtrList.get(syms, i) is some v {
            val sym: ref Symbol = trust @bitcast(v, ref void) as ref Symbol
            if str.raw_cmp(sym.name, "strlen") == 0 {
                saw_strlen = sym.kind == SYM_FUNCTION && sym.col == 14
            }
            if str.raw_cmp(sym.name, "Rect") == 0 {
                saw_rect = sym.kind == SYM_TYPE && sym.col == 12
            }
            if str.raw_cmp(sym.name, "uname") == 0 {
                saw_uname = sym.kind == SYM_FUNCTION && sym.col == 18
            }
        }
        i++
    }
    assert saw_strlen
    assert saw_rect
    assert saw_uname
    trust free_sym_list(syms)
}
